# ==============================================================================
# Configuración Apache / cPanel para sha256.us (Astro Static Build)
# ==============================================================================

Options -Indexes
DirectoryIndex index.html

# 1. Página 404 personalizada
ErrorDocument 404 /404.html

# 2. Forzar HTTPS y Redirección de sitemap.xml a sitemap-index.xml
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redireccionar peticiones del sitemap viejo al nuevo sitemap oficial de Astro
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
</IfModule>

# 3. Cabeceras de Seguridad (Estándar Federal OMB M-15-13 & Laboratorio Forense)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# 4. Caché de navegador de alto rendimiento (activos con hash en /_astro/)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 5. Compresión GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

