  // Atributos de placeholders a traducir
  const PLACEHOLDER_ES_TO_EN = {
    'Ej: Abg. Carlos Mendoza o Tu Nombre': 'E.g.: Atty. Carlos Mendoza or Your Name',
    'tu-correo@ejemplo.com': 'your-email@example.com',
    'Describe brevemente qué ocurrió, qué archivos necesitas o si tienes una fecha límite de tribunal...': 'Briefly describe what happened, what files or messages need certification, or any upcoming court deadline...'
  };

  // Almacenamiento en memoria de los nodos originales para reversión exacta a Español
  const trackedNodes = [];
  const trackedPlaceholders = [];
  let isInitialized = false;

  function initTracking() {
    if (isInitialized) return;
    isInitialized = true;

    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const parent = node.parentElement;
          if (!parent) return NodeFilter.FILTER_REJECT;
          const tag = parent.tagName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'CODE' || tag === 'NOSCRIPT') {
            return NodeFilter.FILTER_REJECT;
          }
          if (parent.hasAttribute('data-lang-indicator') || parent.hasAttribute('data-set-lang')) {
            return NodeFilter.FILTER_REJECT;
          }
          const raw = node.nodeValue || '';
          const trimmed = raw.trim().replace(/\s+/g, ' ');
          if (!trimmed) return NodeFilter.FILTER_REJECT;
          if (ES_TO_EN[trimmed]) {
            return NodeFilter.FILTER_ACCEPT;
          }
          return NodeFilter.FILTER_SKIP;
        }
      }
    );

    let currentNode = walker.nextNode();
    while (currentNode) {
      const raw = currentNode.nodeValue || '';
      const trimmed = raw.trim().replace(/\s+/g, ' ');
      const leading = raw.match(/^\s*/)?.[0] || '';
      const trailing = raw.match(/\s*$/)?.[0] || '';
      trackedNodes.push({
        node: currentNode,
        es: raw,
        en: leading + ES_TO_EN[trimmed] + trailing
      });
      currentNode = walker.nextNode();
    }

    document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach((el) => {
      const orig = el.getAttribute('placeholder') || '';
      if (PLACEHOLDER_ES_TO_EN[orig]) {
        trackedPlaceholders.push({
          el,
          es: orig,
          en: PLACEHOLDER_ES_TO_EN[orig]
        });
      }
    });
  }

  function updateButtonsUI(lang) {
    document.documentElement.setAttribute('lang', lang);

    // 1. Indicadores dentro de botones toggle (ES / EN)
    document.querySelectorAll('[data-lang-indicator]').forEach((el) => {
      const ind = el.getAttribute('data-lang-indicator');
      if (ind === lang) {
        el.classList.add('is-active');
      } else {
        el.classList.remove('is-active');
      }
    });

    // 2. Botones directos [data-set-lang]
    document.querySelectorAll('[data-set-lang]').forEach((btn) => {
      const btnLang = btn.getAttribute('data-set-lang');
      const active = btnLang === lang;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  function applyLanguage(lang) {
    const normalized = lang === 'en' ? 'en' : 'es';
    localStorage.setItem(STORAGE_KEY, normalized);
    initTracking();

    trackedNodes.forEach((item) => {
      item.node.nodeValue = normalized === 'en' ? item.en : item.es;
    });

    trackedPlaceholders.forEach((item) => {
      item.el.setAttribute('placeholder', normalized === 'en' ? item.en : item.es);
    });

    updateButtonsUI(normalized);
  }

  function getInitialLanguage() {
    const params = new URLSearchParams(window.location.search);
    const urlLang = params.get('lang');
    if (urlLang === 'en' || urlLang === 'es') {
      return urlLang;
    }
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === 'en' || saved === 'es') {
      return saved;
    }
    return 'es';
  }

  function bindEvents() {
    // Botones que alternan entre ES y EN al hacer clic
    document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = localStorage.getItem(STORAGE_KEY) === 'en' ? 'en' : 'es';
        const next = current === 'es' ? 'en' : 'es';
        applyLanguage(next);
      });
    });

    // Botones que fijan directamente ES o EN
    document.querySelectorAll('[data-set-lang]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-set-lang') === 'en' ? 'en' : 'es';
        applyLanguage(target);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      bindEvents();
      applyLanguage(getInitialLanguage());
    });
  } else {
    bindEvents();
    applyLanguage(getInitialLanguage());
  }
})();
</script>
