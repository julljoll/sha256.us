---
// USWDS: Icon | https://designsystem.digital.gov/components/icon/
import Icon, { type IconName } from './Icon.astro';

export interface Props {
  network: 'whatsapp' | 'linkedin' | 'twitter' | 'x' | 'github' | 'web' | 'instagram' | 'facebook';
  size?: number | string;
  class?: string;
}

const { network, size = 16, class: className = '' } = Astro.props;

const iconMap: Record<string, IconName> = {
  whatsapp: 'chat',
  linkedin: 'linkedin',
  twitter: 'x',
  x: 'x',
  github: 'github',
  web: 'public',
  instagram: 'instagram',
  facebook: 'facebook',
};

const iconName = iconMap[network] || 'public';
---

<Icon name={iconName} size={size} class={className} />
