---
// USWDS: Icon | https://designsystem.digital.gov/components/icon/
export type IconName =
  | 'account_balance'
  | 'account_circle'
  | 'arrow_back'
  | 'arrow_forward'
  | 'arrow_upward'
  | 'assessment'
  | 'assignment_turned_in'
  | 'autorenew'
  | 'chat'
  | 'check'
  | 'check_circle'
  | 'close'
  | 'code'
  | 'content_copy'
  | 'cookie'
  | 'description'
  | 'error'
  | 'expand_less'
  | 'expand_more'
  | 'facebook'
  | 'file_present'
  | 'fingerprint'
  | 'folder_open'
  | 'gavel'
  | 'github'
  | 'help'
  | 'identification'
  | 'info'
  | 'instagram'
  | 'language'
  | 'launch'
  | 'link'
  | 'linkedin'
  | 'local_library'
  | 'location_on'
  | 'lock'
  | 'login'
  | 'mail'
  | 'menu'
  | 'navigate_before'
  | 'navigate_next'
  | 'phone'
  | 'public'
  | 'science'
  | 'search'
  | 'security'
  | 'send'
  | 'share'
  | 'shield'
  | 'translate'
  | 'twitter'
  | 'verified'
  | 'verified_user'
  | 'warning'
  | 'whatsapp'
  | 'x';

export interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  ariaHidden?: boolean;
}

const {
  name,
  size,
  class: className = '',
  ariaHidden = true,
} = Astro.props;

const ALIAS_TO_OFFICIAL_SPRITE: Record<string, string> = {
  assignment_turned_in: 'verified_user',
  cookie: 'info',
  description: 'file_present',
  gavel: 'account_balance',
  whatsapp: 'chat',
};

const spriteId = ALIAS_TO_OFFICIAL_SPRITE[name] || name;

let sizeClass = '';
const numSize = typeof size === 'number' ? size : Number(size);
if (numSize >= 40) {
  sizeClass = 'usa-icon--size-5';
} else if (numSize >= 32) {
  sizeClass = 'usa-icon--size-4';
} else if (numSize >= 24) {
  sizeClass = 'usa-icon--size-3';
}

const classes = ['usa-icon', sizeClass, className].filter(Boolean).join(' ');
---

<!-- USWDS: Icon | https://designsystem.digital.gov/components/icon/ -->
<svg
  class={classes}
  aria-hidden={ariaHidden ? 'true' : undefined}
  focusable="false"
  role="img"
>
  <use href={`/assets/uswds/img/sprite.svg#${spriteId}`}></use>
</svg>
