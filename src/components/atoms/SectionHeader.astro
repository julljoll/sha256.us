---
// USWDS: Prose & Section Heading | https://designsystem.digital.gov/components/prose/
import Badge from './Badge.astro';

export interface Props {
  tag?: string;
  tagVariant?: 'primary' | 'secondary' | 'light' | 'accent' | 'dark';
  title: string;
  sub?: string;
  align?: 'center' | 'left';
  class?: string;
}

const {
  tag,
  tagVariant = 'primary',
  title,
  sub,
  align = 'center',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`margin-bottom-4 ${alignClass} ${className}`.trim()}>
  {tag && (
    <div class="margin-bottom-1">
      <Badge variant={tagVariant}>{tag}</Badge>
    </div>
  )}
  <h2 class="font-sans-xl tablet:font-sans-2xl text-bold text-primary-darker margin-top-05 margin-bottom-1">
    {title}
  </h2>
  {sub && (
    <p class="font-sans-sm text-base-dark line-height-sans-4 maxw-tablet margin-x-auto margin-top-05 margin-bottom-0">
      {sub}
    </p>
  )}
</div>
