---
// USWDS: Tag | https://designsystem.digital.gov/components/tag/
export interface Props {
  variant?: 'primary' | 'secondary' | 'light' | 'accent' | 'dark' | 'outline';
  class?: string;
}

const { variant = 'primary', class: className = '' } = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'bg-primary text-white',
  secondary: 'bg-secondary text-white text-bold',
  light: 'bg-primary-lighter text-primary-darker text-bold',
  accent: 'bg-secondary-dark text-white',
  dark: 'bg-primary-darker text-white',
  outline: 'bg-white text-primary border-1px border-primary text-bold',
};

const badgeClass = variantClasses[variant] || variantClasses.primary;
---

<!-- USWDS: Tag | https://designsystem.digital.gov/components/tag/ -->
<span class={`usa-tag ${badgeClass} ${className}`.trim()}>
  <slot />
</span>
