---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { COMPANY, CONTACT, FOUNDER, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	section?: string;
	tags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);
const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	pubDate,
	updatedDate,
	author = `${FOUNDER.name} (${FOUNDER.handle})`,
	section = 'Informática Forense',
	tags = [],
} = Astro.props;

// Resolución robusta de la URL absoluta de la imagen para Open Graph y Twitter Cards
let ogImageUrlString = `${SITE_URL}/og-default.jpg`;
let ogImageWidth = 1200;
let ogImageHeight = 630;
let ogImageType = 'image/jpeg';

if (image) {
	if (typeof image === 'string') {
		ogImageUrlString = image.startsWith('http') ? image : new URL(image, Astro.site || SITE_URL).toString();
	} else if (typeof image === 'object' && image.src) {
		ogImageUrlString = new URL(image.src, Astro.site || SITE_URL).toString();
		if (image.width) ogImageWidth = image.width;
		if (image.height) ogImageHeight = image.height;
		if (image.format) {
			ogImageType = image.format === 'jpg' || image.format === 'jpeg' ? 'image/jpeg' : `image/${image.format}`;
		}
	}
}

const schemaOrg = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['Organization', 'ProfessionalService'],
			'@id': `${SITE_URL}/#organization`,
			name: COMPANY.name,
			legalName: COMPANY.legalBrand,
			url: SITE_URL,
			logo: {
				'@type': 'ImageObject',
				url: `${SITE_URL}/logo-head.png`,
				width: 100,
				height: 100,
			},
			image: `${SITE_URL}/og-default.jpg`,
			description: SITE_DESCRIPTION,
			email: CONTACT.email,
			telephone: CONTACT.phone.display,
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Avenida 6 con Calle 7, Edificio Mercantil La Ceiba, Primer Piso, Oficina N° 8',
				addressLocality: 'Quíbor',
				addressRegion: 'Lara',
				addressCountry: 'VE',
			},
			founder: {
				'@id': `${FOUNDER.url}/#person`,
			},
			sameAs: [
				FOUNDER.url,
				CONTACT.social.linkedin,
				CONTACT.social.twitter,
				CONTACT.social.instagram,
			],
		},
		{
			'@type': 'Person',
			'@id': `${FOUNDER.url}/#person`,
			name: FOUNDER.name,
			alternateName: FOUNDER.handle,
			jobTitle: FOUNDER.role,
			url: FOUNDER.url,
			description: FOUNDER.summary,
			worksFor: {
				'@id': `${SITE_URL}/#organization`,
			},
			sameAs: [FOUNDER.url, FOUNDER.linkedin, FOUNDER.github],
		},
		...(type === 'article' && pubDate
			? [
					{
						'@type': 'BlogPosting',
						'@id': `${canonicalURL.toString()}#article`,
						isPartOf: {
							'@id': `${SITE_URL}/#organization`,
						},
						headline: title,
						description: description,
						image: {
							'@type': 'ImageObject',
							url: ogImageUrlString,
							width: ogImageWidth,
							height: ogImageHeight,
						},
						datePublished: pubDate.toISOString(),
						dateModified: (updatedDate || pubDate).toISOString(),
						author: {
							'@type': 'Person',
							name: author,
							url: FOUNDER.url,
						},
						publisher: {
							'@id': `${SITE_URL}/#organization`,
						},
						mainEntityOfPage: canonicalURL.toString(),
						articleSection: section,
						keywords: tags.length ? tags.join(', ') : 'informática forense, evidencia digital',
					},
				]
			: []),
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site || SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags (Google Search Console & SEO) -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta
	name="keywords"
	content="informática forense, peritaje informático, evidencia digital, cadena de custodia, sha256.us, jull.sha256.us, análisis forense digital, perito informático venezuela, ISO 27037, ISO 27042, NIST, MUCC-2017"
/>
<meta name="author" content={`${FOUNDER.name} (${FOUNDER.handle}) - ${COMPANY.name}`} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="geo.region" content="VE-K" />
<meta name="geo.placename" content="Quíbor, Estado Lara, Venezuela" />

<!-- Open Graph / Facebook / WhatsApp / LinkedIn / Telegram -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={COMPANY.name} />
<meta property="og:locale" content="es_VE" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrlString} />
<meta property="og:image:secure_url" content={ogImageUrlString} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={title} />

{type === 'article' && pubDate && (
	<>
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<meta property="article:author" content={FOUNDER.url} />
		<meta property="article:section" content={section} />
		{tags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}
	</>
)}

<!-- Twitter / X Cards (Large Image) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@sha256us" />
<meta name="twitter:creator" content="@sha256us" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrlString} />
<meta name="twitter:image:alt" content={title} />

<!-- Schema.org JSON-LD Estructurado -->
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
