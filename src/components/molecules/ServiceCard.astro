---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import Icon, { type IconName } from '../atoms/Icon.astro';

export interface Props {
  service: {
    id: string;
    tag: string;
    title: string;
    sub: string;
    desc: string;
    simpleDesc: string;
    cases: string[];
    href: string;
  };
  index?: number;
}

const { service } = Astro.props;

const serviceIconMap: Record<string, IconName> = {
  'informatica-forense': 'account_balance',
  forense: 'account_balance',
  moviles: 'phone',
  almacenamiento: 'folder_open',
  'contratos-digitales': 'file_present',
  documentos: 'file_present',
};
const cardIconName: IconName = serviceIconMap[service.id] || 'security';
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="margin-bottom-1">
      <span class="usa-tag bg-primary text-white">{service.tag}</span>
    </div>
    <h3 class="usa-card__heading">
      <Icon name={cardIconName} class="margin-right-05 text-primary" />
      {service.title}
    </h3>
    <p class="font-sans-2xs text-base-dark margin-top-05 margin-bottom-0">{service.sub}</p>
  </div>
  <div class="usa-card__body">
    <!-- USWDS: Summary Box | https://designsystem.digital.gov/components/summary-box/ -->
    <div class="usa-summary-box margin-y-2" role="region" aria-label={service.title}>
      <div class="usa-summary-box__body">
        <p class="usa-summary-box__heading font-sans-xs">¿Cómo te ayudamos?</p>
        <div class="usa-summary-box__text">
          <p class="font-sans-2xs margin-0">{service.simpleDesc}</p>
        </div>
      </div>
    </div>

    <p class="font-sans-3xs text-bold text-base-dark text-uppercase margin-top-2 margin-bottom-1">
      Ejemplos de situaciones que resolvemos:
    </p>
    <!-- USWDS: Icon List | https://designsystem.digital.gov/components/icon-list/ -->
    <ul class="usa-icon-list">
      {service.cases.map((c) => (
        <li class="usa-icon-list__item">
          <div class="usa-icon-list__icon text-primary">
            <Icon name="check" />
          </div>
          <div class="usa-icon-list__content font-sans-2xs">
            {c}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="usa-card__footer">
    <a href={service.href} class="usa-button usa-button--outline width-full">
      Ver cómo funciona y solicitar &rarr;
    </a>
  </div>
</div>
