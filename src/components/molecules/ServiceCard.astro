---
import Icon, { type IconName } from '../atoms/Icon.astro';

export interface Props {
  service: {
    id: string;
    tag: string;
    title: string;
    sub: string;
    desc: string;
    simpleDesc: string;
    cases: string[];
    href: string;
  };
  index?: number;
}

const { service, index = 0 } = Astro.props;

const iconClasses = [
  'sha-card__icon--blue',
  'sha-card__icon--teal',
  'sha-card__icon--red',
  'sha-card__icon--blue',
];
const iconClass = iconClasses[index % iconClasses.length];

const serviceIconMap: Record<string, IconName> = {
  forense: 'account_balance',
  moviles: 'phone',
  almacenamiento: 'folder_open',
  documentos: 'file_present',
};
const cardIconName: IconName = serviceIconMap[service.id] || 'security';
---

<div class="sha-card">
  <div class="display-flex flex-align-center gap-1">
    <div class={`sha-card__icon ${iconClass}`}>
      <Icon name={cardIconName} size={24} />
    </div>
    <div>
      <span class="font-sans-3xs text-bold text-primary display-block text-uppercase letter-spacing-1">{service.tag}</span>
      <h3 class="sha-card__title">{service.title}</h3>
    </div>
  </div>

  <div class="sha-card__body">
    <!-- USWDS Summary Box style for non-technical users -->
    <div class="sha-plain-summary margin-y-1">
      <span class="sha-plain-summary__label">
        <Icon name="verified_user" size={14} class="margin-right-05" />
        Alcance pericial directo:
      </span>
      <p class="sha-plain-summary__text">{service.simpleDesc}</p>
    </div>

    <!-- Casos frecuentes escaneables -->
    <span class="font-sans-3xs text-bold text-base-dark text-uppercase letter-spacing-1 margin-top-1 display-block">
      Casos frecuentes que resolvemos:
    </span>
    <ul class="sha-check-list margin-top-05 margin-bottom-2">
      {service.cases.map((c) => (
        <li class="sha-check-item">
          <Icon name="check" size={14} fill="#008779" class="sha-check-icon" />
          <span>{c}</span>
        </li>
      ))}
    </ul>

    <a href={service.href} class="usa-button usa-button--outline width-full text-center margin-top-auto font-sans-xs">
      Ver detalles técnicos y solicitar &rarr;
    </a>
  </div>
</div>

<style>
  .sha-card {
    background: #ffffff;
    border: 1px solid #c9cdd1;
    border-top: 4px solid #005ea2;
    border-radius: 6px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .sha-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
  }
  .sha-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sha-card__icon--blue {
    background: #e7f6f8;
    color: #005ea2;
    border: 1px solid #b8daed;
  }
  .sha-card__icon--teal {
    background: #e6f7f6;
    color: #008779;
    border: 1px solid #99deea;
  }
  .sha-card__icon--red {
    background: #fbf0f0;
    color: #d83933;
    border: 1px solid #f4b4b4;
  }
  .sha-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #162e51;
    margin: 0.15rem 0 0 0;
    line-height: 1.3;
  }
  .sha-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-top: 1rem;
  }
  .sha-plain-summary {
    background-color: #f0f7fc;
    border: 1px solid #b8daed;
    border-left: 4px solid #005ea2;
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
  }
  .sha-plain-summary__label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #005ea2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .sha-plain-summary__text {
    font-size: 0.84rem;
    color: #162e51;
    line-height: 1.45;
    margin: 0;
  }
  .sha-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sha-check-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: #3d4551;
    margin-bottom: 0.45rem;
    line-height: 1.4;
  }
  .sha-check-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
