---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../atoms/Icon.astro';
import imgJuicios from '../../assets/services/servicio-juicios.jpg';
import imgMoviles from '../../assets/services/servicio-moviles.jpg';
import imgAlmacenamiento from '../../assets/services/servicio-almacenamiento.jpg';
import imgDocumentos from '../../assets/services/servicio-documentos.jpg';

export interface Props {
  service: {
    id: string;
    tag: string;
    title: string;
    sub: string;
    desc: string;
    simpleDesc: string;
    cases: string[];
    href: string;
  };
  index?: number;
}

const { service } = Astro.props;

const serviceIconMap: Record<string, IconName> = {
  'informatica-forense': 'account_balance',
  forense: 'account_balance',
  moviles: 'phone',
  almacenamiento: 'folder_open',
  'contratos-digitales': 'file_present',
  documentos: 'file_present',
};
const cardIconName: IconName = serviceIconMap[service.id] || 'security';

const serviceImgMap: Record<string, ImageMetadata> = {
  'informatica-forense': imgJuicios,
  forense: imgJuicios,
  moviles: imgMoviles,
  almacenamiento: imgAlmacenamiento,
  'contratos-digitales': imgDocumentos,
  documentos: imgDocumentos,
};
const cardImage = serviceImgMap[service.id];
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="margin-bottom-1">
      <span class="usa-tag bg-primary text-white">{service.tag}</span>
    </div>
    <h3 class="usa-card__heading">
      <Icon name={cardIconName} class="margin-right-05 text-primary" />
      {service.title}
    </h3>
    <p class="font-sans-2xs text-base-dark margin-top-05 margin-bottom-0">{service.sub}</p>
  </div>
  {cardImage && (
    <div class="usa-card__media">
      <div class="usa-card__img">
        <Image
          src={cardImage}
          alt={`Ilustración visual de ${service.title}`}
          width={640}
          height={360}
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  )}
  <div class="usa-card__body">
    <p class="font-sans-xs text-ink line-height-sans-4 margin-top-0 margin-bottom-2">
      {service.simpleDesc}
    </p>
    <!-- USWDS: Icon List | https://designsystem.digital.gov/components/icon-list/ -->
    <ul class="usa-icon-list">
      {service.cases.map((c) => (
        <li class="usa-icon-list__item">
          <div class="usa-icon-list__icon text-primary">
            <Icon name="check" />
          </div>
          <div class="usa-icon-list__content font-sans-2xs">
            {c}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="usa-card__footer">
    <a href={service.href} class="usa-button usa-button--outline width-full">
      Ver cómo funciona y solicitar &rarr;
    </a>
  </div>
</div>
