---
// USWDS: Card | https://designsystem.digital.gov/components/card/
export interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <span class="usa-tag bg-primary text-white margin-bottom-1">PILAR {number}</span>
    <h3 class="usa-card__heading">{title}</h3>
  </div>
  <div class="usa-card__body">
    <p class="font-sans-xs text-base-dark line-height-sans-4 margin-0">{description}</p>
  </div>
</div>
