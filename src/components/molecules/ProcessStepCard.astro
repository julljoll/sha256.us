---
// USWDS: Process List & Card | https://designsystem.digital.gov/components/process-list/
import Badge from '../atoms/Badge.astro';
import Icon from '../atoms/Icon.astro';

export interface Props {
  stepNumber: string;
  badgeTag: string;
  badgeVariant?: 'primary' | 'secondary' | 'accent' | 'dark';
  title: string;
  description: string;
  norms?: string;
  responsible?: string;
  controls?: string[];
  planillas?: string[];
}

const {
  badgeTag,
  badgeVariant = 'primary',
  title,
  description,
  norms,
  responsible,
  controls = [],
  planillas = [],
} = Astro.props;
---

<!-- USWDS: Process List Item | https://designsystem.digital.gov/components/process-list/ -->
<li class="usa-process-list__item">
  <div class="margin-bottom-1">
    <Badge variant={badgeVariant}>{badgeTag}</Badge>
    {norms && (
      <span class="usa-tag bg-base-lightest text-primary-darker margin-left-05">{norms}</span>
    )}
  </div>
  <h3 class="usa-process-list__heading">{title}</h3>
  <p class="margin-top-05">{description}</p>

  {controls.length > 0 && (
    <ul class="usa-icon-list margin-top-1">
      {controls.map((c) => (
        <li class="usa-icon-list__item">
          <div class="usa-icon-list__icon text-primary">
            <Icon name="check_circle" />
          </div>
          <div class="usa-icon-list__content font-sans-2xs">
            {c}
          </div>
        </li>
      ))}
    </ul>
  )}

  {planillas.length > 0 && (
    <div class="margin-top-1">
      <p class="font-sans-3xs text-bold text-base-dark margin-bottom-05">
        Instrumentos en Folio (216×330 mm):
      </p>
      <div class="display-flex flex-wrap">
        {planillas.map((p) => (
          <span class="usa-tag bg-primary-lighter text-primary-darker margin-right-05 margin-bottom-05">{p}</span>
        ))}
      </div>
    </div>
  )}

  {responsible && (
    <p class="font-sans-2xs text-base-dark margin-top-1 margin-bottom-0">
      <strong>Responsable:</strong> {responsible}
    </p>
  )}
</li>
