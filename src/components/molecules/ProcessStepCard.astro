---
// USWDS: Process List & Card | https://designsystem.digital.gov/components/process-list/
import Badge from '../atoms/Badge.astro';
import Icon from '../atoms/Icon.astro';

export interface Props {
  stepNumber: string;
  badgeTag: string;
  badgeVariant?: 'primary' | 'secondary' | 'accent' | 'dark';
  title: string;
  description: string;
  norms?: string;
  responsible?: string;
  controls?: string[];
}

const {
  badgeTag,
  badgeVariant = 'primary',
  title,
  description,
  norms,
  responsible,
  controls = [],
} = Astro.props;
---

<!-- USWDS: Process List Item | https://designsystem.digital.gov/components/process-list/ -->
<li class="usa-process-list__item">
  <div class="bg-white padding-3 border-1px border-base-lighter radius-md shadow-1">
    <div class="margin-bottom-1">
      <Badge variant={badgeVariant}>{badgeTag}</Badge>
      {norms && (
        <span class="usa-tag bg-base-lightest text-primary-darker margin-left-05">{norms}</span>
      )}
    </div>
    <h3 class="usa-process-list__heading margin-top-05">{title}</h3>
    <p class="font-sans-xs text-base-dark line-height-sans-4 margin-top-05 margin-bottom-1">{description}</p>

    {controls.length > 0 && (
      <ul class="usa-icon-list margin-top-1">
        {controls.map((c) => (
          <li class="usa-icon-list__item">
            <div class="usa-icon-list__icon text-primary">
              <Icon name="check_circle" />
            </div>
            <div class="usa-icon-list__content font-sans-2xs">
              {c}
            </div>
          </li>
        ))}
      </ul>
    )}

    {responsible && (
      <p class="font-sans-2xs text-base-dark margin-top-105 margin-bottom-0">
        <strong>Responsable:</strong> {responsible}
      </p>
    )}
  </div>
</li>
