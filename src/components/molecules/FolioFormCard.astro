---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import type { CustodyItem } from '../../consts';

export interface Props {
  item: CustodyItem;
}

const { item } = Astro.props;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="display-flex flex-wrap flex-justify margin-bottom-1">
      <span class="usa-tag bg-primary-darker text-white margin-bottom-05">{item.category}</span>
      <span class="usa-tag bg-primary text-white margin-bottom-05">#{item.number}</span>
    </div>
    <h3 class="usa-card__heading">{item.title}</h3>
  </div>
  <div class="usa-card__body">
    <p class="font-sans-2xs text-primary text-bold margin-top-0 margin-bottom-1">
      {item.standards}
    </p>
    <p class="font-sans-xs text-base-dark margin-0">{item.description}</p>
  </div>
  <div class="usa-card__footer">
    <a href="/contacto" class="usa-button usa-button--outline width-full">
      Consultar Consignación de Evidencia &rarr;
    </a>
  </div>
</div>
