---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import type { TeamMember } from '../../consts';
import Badge from '../atoms/Badge.astro';
import SocialIcon from '../atoms/SocialIcon.astro';
import Icon from '../atoms/Icon.astro';

export interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="display-flex flex-wrap flex-justify margin-bottom-1">
      <Badge variant="light" class="margin-bottom-05">{member.titleTag}</Badge>
      <span class="usa-tag bg-base-lightest text-base-darkest margin-bottom-05">{member.phases}</span>
    </div>
    <h3 class="usa-card__heading">{member.name}</h3>
    <p class="font-sans-xs text-secondary-dark text-bold margin-top-05 margin-bottom-0">
      {member.role}
    </p>
  </div>
  <div class="usa-card__body">
    <p class="font-sans-xs text-base-dark">{member.summary}</p>
    <p class="font-sans-3xs text-uppercase text-bold text-primary margin-top-2 margin-bottom-1">
      Áreas de Especialidad y Protocolos:
    </p>
    <ul class="usa-icon-list">
      {member.responsibilities.map((resp) => (
        <li class="usa-icon-list__item">
          <div class="usa-icon-list__icon text-primary">
            <Icon name="check" />
          </div>
          <div class="usa-icon-list__content font-sans-2xs">
            {resp}
          </div>
        </li>
      ))}
    </ul>
    <div class="margin-top-2 display-flex flex-wrap">
      {member.standards.map((std) => (
        <Badge variant="outline" class="margin-right-05 margin-bottom-05">{std}</Badge>
      ))}
    </div>
  </div>
  <div class="usa-card__footer">
    <ul class="usa-button-group flex-wrap">
      {member.social.linkedin && (
        <li class="usa-button-group__item">
          <a
            href={member.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button usa-button--outline"
          >
            <SocialIcon network="linkedin" class="margin-right-05" />
            LinkedIn
          </a>
        </li>
      )}
      {member.social.web && (
        <li class="usa-button-group__item">
          <a
            href={member.social.web}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button usa-button--outline"
          >
            <SocialIcon network="web" class="margin-right-05" />
            Perfil Web
          </a>
        </li>
      )}
      {member.social.github && (
        <li class="usa-button-group__item">
          <a
            href={member.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button usa-button--outline"
          >
            <SocialIcon network="github" class="margin-right-05" />
            GitHub
          </a>
        </li>
      )}
      <li class="usa-button-group__item">
        <a href="/contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink">
          <span class="text-ink text-bold">Consignar Caso &rarr;</span>
        </a>
      </li>
    </ul>
  </div>
</div>
