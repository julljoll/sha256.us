---
// USWDS: Icon List Item | https://designsystem.digital.gov/components/icon-list/
import Icon, { type IconName } from '../atoms/Icon.astro';

export interface Props {
  icon?: 'court' | 'hash' | 'chain' | 'shield';
  text: string;
}

const { icon = 'shield', text } = Astro.props;

const iconMap: Record<string, IconName> = {
  court: 'account_balance',
  hash: 'fingerprint',
  chain: 'link',
  shield: 'shield',
};

const iconName = iconMap[icon] || 'shield';
---

<!-- USWDS: Icon List | https://designsystem.digital.gov/components/icon-list/ -->
<div class="display-flex flex-align-center">
  <div class="usa-icon-list__icon text-primary margin-right-1">
    <Icon name={iconName} />
  </div>
  <div class="usa-icon-list__content font-sans-2xs text-bold text-primary-darker">
    {text}
  </div>
</div>
