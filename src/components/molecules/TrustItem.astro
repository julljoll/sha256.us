---
import Icon from '../atoms/Icon.astro';

export interface Props {
  icon?: 'court' | 'hash' | 'chain' | 'shield';
  text: string;
}

const { icon = 'shield', text } = Astro.props;

type IconName = 'account_balance' | 'fingerprint' | 'link' | 'shield';

const iconMap: Record<string, IconName> = {
  court: 'account_balance',
  hash: 'fingerprint',
  chain: 'link',
  shield: 'shield',
};

const iconName = iconMap[icon] || 'shield';
---

<div class="sha-trust-item">
  <Icon name={iconName} size={18} class="flex-shrink-0" />
  <span>{text}</span>
</div>

<style>
  .sha-trust-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #1a2b4b;
    white-space: nowrap;
  }
  .sha-trust-item :global(svg) {
    color: #005ea2;
  }
  @media (max-width: 639px) {
    .sha-trust-item {
      font-size: 0.72rem;
    }
  }
</style>
