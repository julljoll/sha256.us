---
// USWDS: Button Group | https://designsystem.digital.gov/components/button-group/
import Icon, { type IconName } from '../atoms/Icon.astro';

export interface PillItem {
  href: string;
  label: string;
  iconName?: IconName;
}

export interface Props {
  title?: string;
  label?: string;
  items: PillItem[];
  class?: string;
}

const { title, label, items, class: className = '' } = Astro.props;
const displayTitle = title || label || 'Salta directamente a la sección requerida:';
---

<!-- USWDS: Button Group | https://designsystem.digital.gov/components/button-group/ -->
<div class={className}>
  {displayTitle && (
    <p class="font-sans-2xs text-bold text-base-dark text-uppercase margin-bottom-1">
      {displayTitle}
    </p>
  )}
  <ul class="usa-button-group flex-wrap">
    {items.map((item) => (
      <li class="usa-button-group__item">
        <a href={item.href} class="usa-button usa-button--outline">
          {item.iconName && (
            <Icon name={item.iconName} class="margin-right-05" />
          )}
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
