---
// USWDS: Card | https://designsystem.digital.gov/components/card/
export interface Props {
  tag: string;
  code: string;
  title: string;
  desc: string;
  hash?: string;
}

const { tag, code, title, desc, hash } = Astro.props;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="display-flex flex-wrap flex-justify margin-bottom-1">
      <span class="usa-tag bg-primary text-white">{tag}</span>
      {hash && (
        <span class="usa-tag bg-base-lightest text-primary-darker font-mono-3xs">
          SHA-256: {hash}
        </span>
      )}
    </div>
    <h3 class="usa-card__heading">{code} — {title}</h3>
  </div>
  <div class="usa-card__body">
    <p>{desc}</p>
  </div>
</div>
