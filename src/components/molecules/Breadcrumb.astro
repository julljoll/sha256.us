---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<!-- USWDS: Breadcrumb | https://designsystem.digital.gov/components/breadcrumb/ -->
<nav class={`usa-breadcrumb padding-top-0 padding-bottom-2 bg-transparent ${className}`.trim()} aria-label="Ruta de navegación">
  <ol class="usa-breadcrumb__list">
    <li class="usa-breadcrumb__list-item">
      <a href="/" class="usa-breadcrumb__link">
        <span>Inicio</span>
      </a>
    </li>
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return isLast || !item.href ? (
        <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
          <span>{item.label}</span>
        </li>
      ) : (
        <li class="usa-breadcrumb__list-item">
          <a href={item.href} class="usa-breadcrumb__link">
            <span>{item.label}</span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>
