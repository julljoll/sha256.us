---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import type { LegalInstrument } from '../../consts';

export interface Props {
  instrument: LegalInstrument;
}

const { instrument } = Astro.props;
const shortHash = `${instrument.sha256Hash.slice(0, 12)}...${instrument.sha256Hash.slice(-8)}`;
const fileBaseName = instrument.fileRef.split('/').pop() || instrument.fileRef;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="display-flex flex-wrap flex-justify margin-bottom-1">
      <span class="usa-tag bg-primary-lighter text-primary-darker margin-bottom-05">{instrument.category}</span>
      <span class="usa-tag bg-base-lightest text-base-darkest margin-bottom-05">{instrument.year}</span>
      <span class="usa-tag bg-primary-darker text-white margin-bottom-05">{instrument.code}</span>
    </div>
    <h3 class="usa-card__heading">{instrument.title}</h3>
  </div>
  <div class="usa-card__body">
    <p class="font-sans-2xs text-base-dark margin-top-0 margin-bottom-05">
      <strong>Fuente / Referencia:</strong> {instrument.gacetaOrRef}
    </p>
    <p class="font-sans-2xs text-base-dark margin-top-0 margin-bottom-1">
      <strong>Ámbito / Articulado:</strong> {instrument.articlesOrScope}
    </p>
    <p class="font-sans-xs margin-top-0 margin-bottom-2">{instrument.description}</p>
    <div class="usa-alert usa-alert--info usa-alert--slim">
      <div class="usa-alert__body">
        <p class="usa-alert__text font-sans-2xs">
          <strong>Aplicación en sha256.us y forense.sha256.us:</strong> {instrument.keyApplication}
        </p>
      </div>
    </div>
  </div>
  <div class="usa-card__footer">
    <p class="font-mono-3xs text-base-dark margin-0">
      <span class="text-bold">{fileBaseName}</span> — SHA-256: {shortHash}
    </p>
  </div>
</div>
