---
// USWDS: Language Selector | https://designsystem.digital.gov/components/language-selector/
import Icon from '../atoms/Icon.astro';

export interface Props {
  variant?: 'banner' | 'header' | 'mobile';
}

const { variant = 'header' } = Astro.props;

const btnClass =
  variant === 'banner'
    ? 'usa-button usa-button--unstyled text-white font-sans-2xs text-no-underline'
    : variant === 'mobile'
      ? 'usa-button usa-button--outline width-full'
      : 'usa-button usa-button--outline padding-y-1 padding-x-105 font-sans-2xs';
---

<!-- USWDS: Language Selector | https://designsystem.digital.gov/components/language-selector/ -->
<button
  type="button"
  class={btnClass}
  data-lang-toggle
  data-lang-ui="true"
  aria-label="Cambiar idioma del sitio: Español - Inglés"
>
  <Icon name="language" class="margin-right-05" />
  <span data-lang-indicator="es" class="text-bold">Español</span>
  <span class="margin-x-05">-</span>
  <span data-lang-indicator="en">Inglés</span>
</button>
