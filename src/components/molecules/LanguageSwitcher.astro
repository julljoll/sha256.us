---
import Icon from '../atoms/Icon.astro';

export interface Props {
  variant?: 'banner' | 'header' | 'mobile';
}

const { variant = 'header' } = Astro.props;
---

{variant === 'banner' && (
  <div class="sha-lang-banner" role="group" aria-label="Selector de idioma / Language selector">
    <Icon name="language" size={13} class="sha-lang-banner__icon" />
    <button
      type="button"
      class="sha-lang-banner__btn is-active"
      data-set-lang="es"
      aria-pressed="true"
      title="Cambiar a Español"
    >
      ES
    </button>
    <span class="sha-lang-banner__sep" aria-hidden="true">|</span>
    <button
      type="button"
      class="sha-lang-banner__btn"
      data-set-lang="en"
      aria-pressed="false"
      title="Switch to English"
    >
      EN
    </button>
  </div>
)}

{variant === 'header' && (
  <button
    type="button"
    class="sha-lang-toggle"
    data-lang-toggle
    aria-label="Cambiar idioma entre Español e Inglés / Switch language between Spanish and English"
    title="Cambiar idioma (Español / English)"
  >
    <Icon name="language" size={16} class="sha-lang-toggle__icon" />
    <span class="sha-lang-toggle__pill is-active" data-lang-indicator="es">ES</span>
    <span class="sha-lang-toggle__divider" aria-hidden="true">/</span>
    <span class="sha-lang-toggle__pill" data-lang-indicator="en">EN</span>
  </button>
)}

{variant === 'mobile' && (
  <div class="sha-lang-mobile" role="group" aria-label="Selector de idioma / Language selector">
    <div class="sha-lang-mobile__label">
      <Icon name="language" size={16} fill="#005ea2" />
      <span>Idioma / Language:</span>
    </div>
    <div class="sha-lang-mobile__btns">
      <button
        type="button"
        class="sha-lang-mobile__btn is-active"
        data-set-lang="es"
        aria-pressed="true"
      >
        Español (ES)
      </button>
      <button
        type="button"
        class="sha-lang-mobile__btn"
        data-set-lang="en"
        aria-pressed="false"
      >
        English (EN)
      </button>
    </div>
  </div>
)}

<style>
  /* 1. Banner Variant */
  .sha-lang-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    color: #ffffff;
  }
  .sha-lang-banner__icon {
    color: #73b3e7;
    flex-shrink: 0;
  }
  .sha-lang-banner__btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.05rem 0.2rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.15s ease;
    line-height: 1.2;
  }
  .sha-lang-banner__btn:hover {
    color: #ffffff;
  }
  .sha-lang-banner__btn.is-active {
    background: #005ea2;
    color: #ffffff;
    font-weight: 800;
  }
  .sha-lang-banner__sep {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.35);
  }

  /* 2. Header Variant (Desktop & Tablet/Mobile Top Row) */
  .sha-lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #f0f4f8;
    border: 1.5px solid #005ea2;
    color: #162e51;
    border-radius: 4px;
    padding: 0.38rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    min-height: 40px;
    transition: all 0.18s ease;
    touch-action: manipulation;
    white-space: nowrap;
  }
  .sha-lang-toggle:hover {
    background: #e1effa;
    border-color: #162e51;
  }
  .sha-lang-toggle__icon {
    color: #005ea2;
    flex-shrink: 0;
  }
  .sha-lang-toggle__pill {
    padding: 0.12rem 0.35rem;
    border-radius: 3px;
    color: #565c65;
    font-weight: 700;
    transition: all 0.15s ease;
  }
  .sha-lang-toggle__pill.is-active {
    background: #005ea2;
    color: #ffffff;
    font-weight: 800;
  }
  .sha-lang-toggle__divider {
    color: #a9aeb1;
    font-weight: 400;
  }

  @media (max-width: 480px) {
    .sha-lang-toggle {
      padding: 0.32rem 0.45rem;
      min-height: 38px;
      font-size: 0.7rem;
    }
  }

  /* 3. Mobile Drawer Variant */
  .sha-lang-mobile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #c9cdd1;
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
  }
  .sha-lang-mobile__label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #162e51;
  }
  .sha-lang-mobile__btns {
    display: flex;
    gap: 0.35rem;
  }
  .sha-lang-mobile__btn {
    background: #f0f4f8;
    border: 1px solid #c9cdd1;
    color: #162e51;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .sha-lang-mobile__btn.is-active {
    background: #005ea2;
    border-color: #005ea2;
    color: #ffffff;
  }
</style>
