---
// USWDS: Banner & Header | https://designsystem.digital.gov/components/banner/ & https://designsystem.digital.gov/components/header/
import { COMPANY, FORENSE_PORTAL_URL, NAV_ITEMS } from '../consts';
import Icon from './atoms/Icon.astro';
import LanguageSwitcher from './molecules/LanguageSwitcher.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/#inicio') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath.startsWith(href);
}
---

<!-- USWDS: Banner | https://designsystem.digital.gov/components/banner/ -->
<section
  class="usa-banner"
  aria-label="Portal oficial del Laboratorio de Informática Forense"
>
  <div class="usa-accordion">
    <header class="usa-banner__header">
      <div class="usa-banner__inner">
        <div class="grid-col-auto">
          <svg
            class="usa-icon usa-banner__header-flag text-primary"
            aria-hidden="true"
            role="img"
          >
            <use href="/assets/uswds/img/sprite.svg#verified_user"></use>
          </svg>
        </div>
        <div class="grid-col-fill tablet:grid-col-auto" aria-hidden="true">
          <p class="usa-banner__header-text">
            Portal oficial del Laboratorio de Informática Forense <strong>{COMPANY.name}</strong>
          </p>
          <p class="usa-banner__header-action">Así es como usted puede verificarlo</p>
        </div>
        <button
          type="button"
          class="usa-accordion__button usa-banner__button"
          aria-expanded="false"
          aria-controls="gov-banner-default"
        >
          <span class="usa-banner__button-text">Así es como usted puede verificarlo</span>
        </button>
      </div>
    </header>
    <div
      class="usa-banner__content usa-accordion__content"
      id="gov-banner-default"
      hidden
    >
      <div class="grid-row grid-gap-lg">
        <div class="usa-banner__guidance tablet:grid-col-6">
          <img
            class="usa-banner__icon usa-media-block__img"
            src="/assets/uswds/img/icon-dot-gov.svg"
            role="img"
            alt=""
            aria-hidden="true"
          />
          <div class="usa-media-block__body">
            <p>
              <strong>Laboratorio Especializado en Móviles y Computadoras</strong><br />
              Examinamos teléfonos, computadoras, chats y archivos digitales sin alterar los datos originales, entregando informes claros y válidos para juicios.
            </p>
          </div>
        </div>
        <div class="usa-banner__guidance tablet:grid-col-6">
          <img
            class="usa-banner__icon usa-media-block__img"
            src="/assets/uswds/img/icon-https.svg"
            role="img"
            alt=""
            aria-hidden="true"
          />
          <div class="usa-media-block__body">
            <p>
              <strong>Los portales forenses seguros utilizan HTTPS y Hash SHA-256</strong><br />
              Un candado (
              <span class="icon-lock">
                <Icon name="lock" />
              </span>
              ) o <strong>https://</strong> garantiza que usted se ha conectado de forma cifrada al portal oficial y al sistema de gestión pericial <strong>forense.sha256.us</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- USWDS: Header Extended (Sticky Always-Visible Menu) | https://designsystem.digital.gov/components/header/ -->
<header class="usa-header usa-header--extended position-sticky top-0 z-top bg-white shadow-2 border-bottom-1px border-base-lighter">
  <div class="usa-navbar">
    <div class="usa-logo">
      <em class="usa-logo__text">
        <a href="/#inicio" title={COMPANY.name} class="display-flex flex-align-center text-no-underline">
          <img
            src="/logo.png"
            alt=""
            aria-hidden="true"
            class="width-5 height-5 margin-right-1 desktop:display-none"
            width="40"
            height="40"
          />
          <img
            src="/logo.png"
            alt=""
            aria-hidden="true"
            class="display-none desktop:display-block width-7 height-7 margin-right-105"
            width="56"
            height="56"
          />
          <span class="display-flex flex-column flex-justify-center">
            <span class="font-sans-lg text-bold text-primary-darker line-height-sans-1">
              {COMPANY.name}
            </span>
            <span class="display-none desktop:display-block font-sans-3xs text-normal text-base-dark line-height-sans-2 margin-top-05">
              Informática Forense
            </span>
          </span>
        </a>
      </em>
    </div>
    <button type="button" class="usa-menu-btn">Menú</button>
  </div>
  <!-- Barra de Acceso Rápido Móvil (Selector de Idioma y Acceso a Iniciar Sesión) -->
  <div class="desktop:display-none bg-base-lightest border-bottom-1px border-base-lighter padding-y-1">
    <div class="grid-container display-flex flex-justify flex-align-center">
      <LanguageSwitcher variant="header" />
      <a
        href={FORENSE_PORTAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="usa-button usa-button--outline display-inline-flex flex-align-center padding-y-05 padding-x-1 font-sans-3xs line-height-sans-1 radius-pill bg-white shadow-1 text-primary text-bold text-no-underline"
        title="Iniciar Sesión en forense.sha256.us"
      >
        <Icon name="lock" class="margin-right-05 text-primary" />
        <span>Iniciar Sesión</span>
      </a>
    </div>
  </div>
  <nav aria-label="Navegación principal" class="usa-nav">
    <div class="usa-nav__inner">
      <button type="button" class="usa-nav__close">
        <img src="/assets/uswds/img/usa-icons/close.svg" role="img" alt="Cerrar" />
      </button>
      <ul class="usa-nav__primary usa-accordion">
        {NAV_ITEMS.map((link) => (
          <li class="usa-nav__primary-item">
            <a
              href={link.href}
              class={`usa-nav__link${isActive(link.href) ? ' usa-current' : ''}`}
            >
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="usa-nav__secondary">
        <div class="display-flex flex-align-center flex-justify-end">
          <a
            href={FORENSE_PORTAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button usa-button--outline display-inline-flex flex-align-center padding-y-05 padding-x-105 font-sans-2xs line-height-sans-1 radius-pill bg-white shadow-1 text-primary text-bold margin-right-1 text-no-underline"
            title="Iniciar Sesión en forense.sha256.us"
          >
            <Icon name="lock" class="margin-right-05 text-primary" />
            <span>Iniciar Sesión</span>
          </a>
          <LanguageSwitcher variant="header" />
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    const navLinks = document.querySelectorAll('.usa-nav__link');
    const closeBtn = document.querySelector('.usa-nav__close');

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (closeBtn && document.querySelector('.usa-nav.is-visible')) {
          closeBtn.click();
        }
        const href = link.getAttribute('href') || '';
        if (href.startsWith('/#')) {
          navLinks.forEach((item) => item.classList.remove('usa-current'));
          link.classList.add('usa-current');
        }
      });
    });

    const sectionIds = ['inicio', 'servicios', 'como-trabajamos', 'nosotros', 'blog', 'contacto'];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    if (sections.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetHref = `/#${entry.target.id}`;
              navLinks.forEach((link) => {
                if (link.getAttribute('href') === targetHref) {
                  link.classList.add('usa-current');
                } else if ((link.getAttribute('href') || '').startsWith('/#')) {
                  link.classList.remove('usa-current');
                }
              });
            }
          });
        },
        { rootMargin: '-30% 0px -55% 0px', threshold: 0 }
      );
      sections.forEach((sec) => observer.observe(sec));
    }
  })();
</script>
