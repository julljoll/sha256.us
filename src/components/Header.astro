---
// USWDS: Banner & Header | https://designsystem.digital.gov/components/banner/ & https://designsystem.digital.gov/components/header/
import { COMPANY, CONTACT, NAV_ITEMS } from '../consts';
import Icon from './atoms/Icon.astro';
import LanguageSwitcher from './molecules/LanguageSwitcher.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- USWDS: Banner | https://designsystem.digital.gov/components/banner/ -->
<section
  class="usa-banner"
  aria-label="Portal oficial del Laboratorio de Informática Forense"
>
  <div class="usa-accordion">
    <header class="usa-banner__header">
      <div class="usa-banner__inner">
        <div class="grid-col-auto">
          <img
            aria-hidden="true"
            class="usa-banner__header-flag"
            src="/favicon-32x32.png"
            alt=""
          />
        </div>
        <div class="grid-col-fill tablet:grid-col-auto" aria-hidden="true">
          <p class="usa-banner__header-text">
            Portal oficial del Laboratorio de Informática Forense <strong>{COMPANY.name}</strong>
          </p>
          <p class="usa-banner__header-action">Así es como usted puede verificarlo</p>
        </div>
        <button
          type="button"
          class="usa-accordion__button usa-banner__button"
          aria-expanded="false"
          aria-controls="gov-banner-default"
        >
          <span class="usa-banner__button-text">Así es como usted puede verificarlo</span>
        </button>
      </div>
    </header>
    <div
      class="usa-banner__content usa-accordion__content"
      id="gov-banner-default"
      hidden
    >
      <div class="grid-row grid-gap-lg">
        <div class="usa-banner__guidance tablet:grid-col-6">
          <img
            class="usa-banner__icon usa-media-block__img"
            src="/assets/uswds/img/icon-dot-gov.svg"
            role="img"
            alt=""
            aria-hidden="true"
          />
          <div class="usa-media-block__body">
            <p>
              <strong>Validez Pericial y Rigor Científico Auditado</strong><br />
              Toda actuación técnica del laboratorio <strong>{COMPANY.name}</strong> y de nuestra plataforma operativa <strong>forense.sha256.us</strong> se ejecuta bajo estándares internacionales <strong>ISO/IEC 27037</strong>, <strong>ISO/IEC 27042</strong>, <strong>NIST SP 800</strong> y la planilla oficial de <strong>Cadena de Custodia (MUCC-2017)</strong> para plena admisibilidad ante juzgados y tribunales.
            </p>
          </div>
        </div>
        <div class="usa-banner__guidance tablet:grid-col-6">
          <img
            class="usa-banner__icon usa-media-block__img"
            src="/assets/uswds/img/icon-https.svg"
            role="img"
            alt=""
            aria-hidden="true"
          />
          <div class="usa-media-block__body">
            <p>
              <strong>Los portales forenses seguros utilizan HTTPS y Hash SHA-256</strong><br />
              Un candado (
              <span class="icon-lock">
                <Icon name="lock" />
              </span>
              ) o <strong>https://</strong> garantiza que usted se ha conectado de forma cifrada al portal oficial y al sistema de gestión pericial <strong>forense.sha256.us</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- USWDS: Header Extended | https://designsystem.digital.gov/components/header/ -->
<header class="usa-header usa-header--extended">
  <div class="usa-navbar">
    <div class="usa-logo">
      <em class="usa-logo__text">
        <a href="/" title={COMPANY.name}>
          {COMPANY.name} — Laboratorio de Informática Forense &amp; Peritaje Judicial
        </a>
      </em>
    </div>
    <button type="button" class="usa-menu-btn">Menú</button>
  </div>
  <nav aria-label="Navegación principal" class="usa-nav">
    <div class="usa-nav__inner">
      <button type="button" class="usa-nav__close">
        <img src="/assets/uswds/img/usa-icons/close.svg" role="img" alt="Cerrar" />
      </button>
      <ul class="usa-nav__primary usa-accordion">
        {NAV_ITEMS.map((link) => (
          <li class="usa-nav__primary-item">
            <a
              href={link.href}
              class={`usa-nav__link${isActive(link.href) ? ' usa-current' : ''}`}
            >
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="usa-nav__secondary">
        <ul class="usa-nav__secondary-links">
          <li class="usa-nav__secondary-item">
            <a
              href="https://forense.sha256.us/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Iniciar Sesión (forense.sha256.us)
            </a>
          </li>
          <li class="usa-nav__secondary-item">
            <a
              href={CONTACT.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
            >
              Hablar por WhatsApp
            </a>
          </li>
          <li class="usa-nav__secondary-item">
            <a href="/contacto">Solicitar Peritaje</a>
          </li>
        </ul>
        <div class="margin-top-1">
          <LanguageSwitcher variant="header" />
        </div>
      </div>
    </div>
  </nav>
</header>
