---
import HeaderLink from './HeaderLink.astro';
import { CONTACT } from '../consts';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios Forenses' },
  { href: '/blog', label: 'Blog & Casos' },
  { href: '/about', label: 'Sobre Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
---

<!-- USWDS Official Banner -->
<section class="usa-banner" aria-label="Portal oficial sha256.us">
  <div class="usa-banner__header sha-banner__header">
    <div class="usa-banner__inner sha-banner__inner">
      <div class="grid-col-auto margin-right-1 display-flex flex-align-center">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-primary" style="vertical-align:middle">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
      </div>
      <div class="grid-col-fill">
        <p class="usa-banner__header-text">
          <strong>sha256.us</strong> — Laboratorio de Informática Forense
          <span class="display-none tablet:display-inline">&bull; Peritajes Judiciales, Evidencia Digital & Cadena de Custodia</span>
        </p>
      </div>
      <div class="grid-col-auto display-flex flex-align-center">
        <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="sha-banner__contact" title={`WhatsApp: ${CONTACT.phone.display}`}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true" style="vertical-align:middle;margin-right:3px">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
          </svg>
          <span>{CONTACT.phone.display}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Main Header -->
<header class="usa-header sha-header" id="site-header">
  <div class="sha-header__inner">
    <!-- Logo Row -->
    <div class="sha-header__logo-row">
      <div class="sha-header__logo-wrap">
        <a href="/" title="sha256.us - Inicio" class="sha-header__logo-link">
          <img
            src="/logo-head.svg"
            alt="sha256.us"
            class="sha-header__logo-img"
            onerror="this.onerror=null; this.src='/logo-head.png';"
          />
          <span class="sha-header__logo-text">
            <span class="sha-header__logo-name">sha256.us</span>
            <span class="sha-header__logo-tagline">Laboratorio Forense Digital</span>
          </span>
        </a>
      </div>

      <!-- Top-right actions -->
      <div class="sha-header__actions">
        <!-- Direct Desktop CTA -->
        <a href="/contacto" class="usa-button usa-button--primary sha-header__cta display-none tablet:display-inline-flex">
          Solicitar Peritaje
        </a>

        <!-- Quick 1-Touch Mobile WhatsApp Pill -->
        <a
          href={CONTACT.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="sha-header__mobile-wa display-inline-flex tablet:display-none"
          title="Atención directa por WhatsApp"
          aria-label="Atención directa por WhatsApp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <!-- Mobile menu toggle button with 44px minimum touch target -->
        <button
          class="sha-header__menu-toggle"
          id="mobileMenuToggle"
          aria-controls="mobileNav"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <span class="sha-hamburger" id="hamburgerIcon" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="sha-menu-text">Menú</span>
        </button>
      </div>
    </div>

    <!-- Navigation Row -->
    <nav class="sha-header__nav" aria-label="Navegación principal" id="mobileNav">
      <ul class="sha-nav__list">
        {navItems.map((item) => (
          <li class="sha-nav__item">
            <HeaderLink href={item.href} class="sha-nav__link">{item.label}</HeaderLink>
          </li>
        ))}
      </ul>

      <!-- Nav secondary: standards badge (desktop) -->
      <div class="sha-nav__badges display-none tablet:display-flex">
        <span class="sha-badge">ISO/IEC 27037</span>
        <span class="sha-badge">NIST SP 800</span>
        <span class="sha-badge sha-badge--accent">MUCC-2017</span>
      </div>

      <!-- Mobile drawer quick actions -->
      <div class="sha-nav__mobile-actions display-flex tablet:display-none flex-column gap-1 padding-2 bg-base-lightest border-top-1px border-base-lighter">
        <a href="/contacto" class="usa-button usa-button--primary width-full text-center">
          Solicitar Peritaje Forense
        </a>
        <a
          href={CONTACT.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="usa-button usa-button--outline width-full text-center text-primary-darker display-flex flex-align-center flex-justify-center"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true" style="margin-right:6px">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
          </svg>
          Hablar por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* ====== BANNER ====== */
  .sha-banner__header {
    background-color: #1a2b4b;
    color: rgba(255,255,255,0.85);
    padding: 0.35rem 0;
    font-size: 0.72rem;
  }
  .sha-banner__inner {
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    gap: 0.5rem;
  }
  .usa-banner__header-text {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }
  .sha-banner__contact {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }
  .sha-banner__contact:hover { color: #fff; }

  /* ====== MAIN HEADER ====== */
  .sha-header {
    background: #fff;
    border-bottom: 3px solid #005ea2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }
  .sha-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Logo Row */
  .sha-header__logo-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e1e7ee;
  }
  .sha-header__logo-wrap { display: flex; align-items: center; }
  .sha-header__logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .sha-header__logo-img {
    height: 46px;
    width: auto;
    object-fit: contain;
  }
  .sha-header__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .sha-header__logo-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1a2b4b;
    letter-spacing: -0.01em;
  }
  .sha-header__logo-tagline {
    font-size: 0.65rem;
    color: #71767a;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
  }

  /* Top-right actions */
  .sha-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sha-header__cta {
    font-size: 0.8rem;
    padding: 0.55rem 1.15rem;
    white-space: nowrap;
  }

  /* Mobile WhatsApp Direct Pill */
  .sha-header__mobile-wa {
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.65rem;
    background-color: #f0fdf4;
    border: 1px solid #22c55e;
    color: #15803d;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none !important;
    white-space: nowrap;
    min-height: 40px;
  }

  /* ====== NAV ROW ====== */
  .sha-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sha-nav__list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }
  .sha-nav__item { position: relative; }

  /* Nav Links */
  :global(.sha-nav__link) {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a2b4b;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  :global(.sha-nav__link:hover) {
    color: #005ea2;
    border-bottom-color: #005ea2;
    background: rgba(0,94,162,0.04);
  }
  :global(.sha-nav__link.active) {
    color: #005ea2;
    border-bottom-color: #005ea2;
    font-weight: 700;
    text-decoration: none !important;
  }

  /* Badges */
  .sha-nav__badges {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.5rem 0;
  }
  .sha-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: #dfe1e2;
    color: #1b1b1b;
    border-radius: 2px;
    white-space: nowrap;
  }
  .sha-badge--accent {
    background: #e41d3d;
    color: #fff;
  }

  /* ====== MOBILE MENU TOGGLE ====== */
  .sha-header__menu-toggle {
    display: none;
    background: #f8fafc;
    border: 1.5px solid #005ea2;
    cursor: pointer;
    padding: 0.45rem 0.65rem;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 42px;
    min-width: 44px;
    touch-action: manipulation;
  }
  .sha-menu-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: #005ea2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sha-hamburger {
    display: flex;
    flex-direction: column;
    gap: 3.5px;
    width: 18px;
  }
  .sha-hamburger span {
    display: block;
    height: 2px;
    background: #005ea2;
    border-radius: 1px;
    transition: transform 0.25s, opacity 0.2s;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    .sha-header__menu-toggle { display: flex; }
    .sha-header__logo-img { height: 38px; }
    .sha-header__logo-name { font-size: 1.05rem; }
    .sha-header__logo-tagline { font-size: 0.6rem; }

    .sha-header__nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      background: #fff;
      border-top: 1px solid #e1e7ee;
      padding: 0.25rem 0 0 0;
    }
    .sha-header__nav.is-open { display: flex; }
    .sha-nav__list { flex-direction: column; }
    :global(.sha-nav__link) {
      padding: 0.95rem 1.25rem;
      font-size: 0.95rem;
      border-bottom: 1px solid #f0f2f5;
      border-left: 4px solid transparent;
    }
    :global(.sha-nav__link.active) {
      border-left-color: #005ea2;
      border-bottom-color: #f0f2f5;
      background: rgba(0,94,162,0.04);
    }
    .sha-nav__badges { display: none !important; }
  }
</style>

<script>
  (function() {
    const toggle = document.getElementById('mobileMenuToggle');
    const nav = document.getElementById('mobileNav');
    const icon = document.getElementById('hamburgerIcon');

    if (!toggle || !nav) return;

    function closeNav() {
      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir menú de navegación');
      if (icon) {
        const spans = icon.querySelectorAll('span');
        spans.forEach((s: Element) => {
          (s as HTMLElement).style.transform = '';
          (s as HTMLElement).style.opacity = '';
        });
      }
    }

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú de navegación');
      if (icon) {
        const spans = icon.querySelectorAll('span');
        if (isOpen) {
          (spans[0] as HTMLElement).style.transform = 'translateY(5.5px) rotate(45deg)';
          (spans[1] as HTMLElement).style.opacity = '0';
          (spans[2] as HTMLElement).style.transform = 'translateY(-5.5px) rotate(-45deg)';
        } else {
          spans.forEach((s: Element) => {
            (s as HTMLElement).style.transform = '';
            (s as HTMLElement).style.opacity = '';
          });
        }
      }
    });

    // Close on link click in mobile menu
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeNav);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        closeNav();
        toggle.focus();
      }
    });
  })();
</script>
