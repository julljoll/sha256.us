---
// USWDS: Card | https://designsystem.digital.gov/components/card/
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  HeadingTag?: 'h2' | 'h3';
}

const { post, HeadingTag = 'h3' } = Astro.props;
---

<!-- USWDS: Card | https://designsystem.digital.gov/components/card/ -->
<div class="usa-card__container">
  <div class="usa-card__header">
    <div class="display-flex flex-wrap flex-justify margin-bottom-1">
      <span class="usa-tag bg-primary text-white">
        {post.data.category || 'Informática Forense'}
      </span>
      <span class="font-sans-2xs text-base-dark">
        <FormattedDate date={post.data.pubDate} />
      </span>
    </div>
    <HeadingTag class="usa-card__heading">
      <a href={`/blog/${post.id}/`} class="usa-link text-no-underline">{post.data.title}</a>
    </HeadingTag>
  </div>
  {post.data.heroImage && (
    <div class="usa-card__media">
      <div class="usa-card__img">
        <Image
          width={640}
          height={360}
          src={post.data.heroImage}
          alt={post.data.title}
        />
      </div>
    </div>
  )}
  <div class="usa-card__body">
    <p>{post.data.description}</p>
  </div>
  <div class="usa-card__footer">
    <a href={`/blog/${post.id}/`} class="usa-button">
      Leer artículo completo &rarr;
    </a>
  </div>
</div>
