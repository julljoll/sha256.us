---
import { CONTACT } from '../../consts';
import Badge from '../atoms/Badge.astro';
import SocialIcon from '../atoms/SocialIcon.astro';
---

<!-- USWDS: Summary box & Button | https://designsystem.digital.gov/components/summary-box/ -->
<div class="bg-primary-lighter border-1px border-primary-light radius-lg padding-3 tablet:padding-4 margin-bottom-5 shadow-1">
  <div class="grid-row grid-gap flex-align-center">
    <div class="tablet:grid-col-8 margin-bottom-2 tablet:margin-bottom-0">
      <Badge variant="primary" class="margin-bottom-05">ATENCIÓN DIRECTA</Badge>
      <h2 class="font-sans-md text-bold text-primary-darker margin-y-05">
        ¿Prefieres atención inmediata sin llenar formularios?
      </h2>
      <p class="font-sans-xs text-base-dark margin-0">
        Escribe directamente por WhatsApp a nuestro equipo de guardia pericial para coordinar la recepción de tu evidencia o evaluar la urgencia de tu caso.
      </p>
    </div>
    <div class="tablet:grid-col-4 text-right">
      <a
        href={CONTACT.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="usa-button bg-gold hover:bg-warning-dark text-ink width-full display-inline-flex flex-align-center flex-justify-center font-sans-xs"
      >
        <SocialIcon network="whatsapp" class="margin-right-1 text-ink" />
        <span class="text-ink text-bold">Escribir a WhatsApp ({CONTACT.phone.display}) &rarr;</span>
      </a>
    </div>
  </div>
</div>
