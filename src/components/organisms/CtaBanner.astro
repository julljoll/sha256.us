---
export interface Props {
  title?: string;
  sub?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = '¿Tienes un caso y necesitas asesoría profesional?',
  sub = 'Escríbenos para una evaluación preliminar confidencial sobre la viabilidad técnica de tu evidencia digital.',
  buttonText = 'Contactar sha256.us',
  buttonHref = '/contacto',
} = Astro.props;
---

<section class="sha-cta-banner">
  <div class="sha-container sha-cta-banner__inner">
    <div class="sha-cta-banner__text">
      <h2 class="sha-cta-banner__title">{title}</h2>
      <p class="sha-cta-banner__sub">{sub}</p>
    </div>
    <div class="sha-cta-banner__actions">
      <a href={buttonHref} class="usa-button usa-button--big sha-cta-banner__btn-primary">
        {buttonText}
      </a>
    </div>
  </div>
</section>

<style>
  .sha-cta-banner {
    background: linear-gradient(135deg, #1a2b4b 0%, #005ea2 100%);
    color: #ffffff;
    padding: 3.5rem 0;
  }
  .sha-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .sha-cta-banner__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .sha-cta-banner__text {
    max-width: 680px;
  }
  .sha-cta-banner__title {
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.25;
  }
  .sha-cta-banner__sub {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    line-height: 1.5;
  }
  .sha-cta-banner__btn-primary {
    background-color: #d83933 !important;
    color: #ffffff !important;
    white-space: nowrap;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    text-decoration: none;
    display: inline-block;
  }
  .sha-cta-banner__btn-primary:hover {
    background-color: #b50909 !important;
  }
</style>
