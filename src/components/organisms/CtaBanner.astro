---
// USWDS: Section Dark | https://designsystem.digital.gov/page-templates/landing-page/
export interface Props {
  title?: string;
  sub?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = '¿Tienes dudas sobre tu caso o necesitas certificar una prueba?',
  sub = 'Escríbenos con confianza. Te explicamos en palabras claras cómo podemos ayudarte a proteger o demostrar tu evidencia digital.',
  buttonText = 'Consultar mi Caso Ahora',
  buttonHref = '/contacto',
} = Astro.props;
---

<!-- USWDS: Section Dark | https://designsystem.digital.gov/page-templates/landing-page/ -->
<section class="usa-section usa-section--dark">
  <div class="grid-container">
    <div class="grid-row grid-gap flex-align-center">
      <div class="tablet:grid-col-8">
        <h2 class="font-sans-xl text-bold text-white margin-top-0 margin-bottom-1">{title}</h2>
        <p class="font-sans-sm text-base-lightest margin-0">{sub}</p>
      </div>
      <div class="tablet:grid-col-4 margin-top-2 tablet:margin-top-0">
        <a href={buttonHref} class="usa-button usa-button--big bg-gold hover:bg-warning-dark text-ink">
          <span class="text-ink text-bold">{buttonText}</span>
        </a>
      </div>
    </div>
  </div>
</section>
