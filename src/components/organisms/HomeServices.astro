---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import ServiceCard from '../molecules/ServiceCard.astro';
import { CORE_SERVICES } from '../../consts';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id="servicios" class="usa-section">
  <div class="grid-container">
    <SectionHeader
      tag="SERVICIOS FORENSES"
      tagVariant="primary"
      title="¿Qué necesitas certificar o recuperar?"
      sub="Análisis forense especializado en teléfonos móviles, computadoras y evidencias digitales para particulares, abogados y empresas."
    />

    <ul class="usa-card-group">
      {CORE_SERVICES.map((serv, index) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-4">
          <ServiceCard service={serv} index={index} />
        </li>
      ))}
    </ul>
  </div>
</section>
