---
// USWDS: Process List | https://designsystem.digital.gov/components/process-list/
import SectionHeader from '../atoms/SectionHeader.astro';
import LegalPyramidCard from '../molecules/LegalPyramidCard.astro';
import { LEGAL_PYRAMID } from '../../consts';
---

<!-- USWDS: Process List | https://designsystem.digital.gov/components/process-list/ -->
<section id="piramide-legal" class="usa-section border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="JERARQUÍA NORMATIVA VERIFICADA"
      tagVariant="primary"
      title="Pirámide de Aplicación Legal y Técnica en Venezuela"
      sub="Estructura jerárquica que articula la Constitución (CRBV), los códigos procesales (COPP, CPC y Código Civil), las leyes informáticas (LMDFE y LEDI), los protocolos nacionales (MUCC-2017) y los estándares ISO/NIST."
    />

    <ol class="usa-process-list">
      {LEGAL_PYRAMID.map((tierItem, index) => (
        <LegalPyramidCard tierItem={tierItem} index={index} />
      ))}
    </ol>
  </div>
</section>
