---
// USWDS: Accordion & Card Group | https://designsystem.digital.gov/components/accordion/
import SectionHeader from '../atoms/SectionHeader.astro';
import LegalInstrumentCard from '../molecules/LegalInstrumentCard.astro';
import { LEGAL_INSTRUMENTS, type LegalCategory } from '../../consts';

const categories: LegalCategory[] = [
  'Leyes Nacionales',
  'Códigos y Leyes Orgánicas',
  'Estándares ISO/IEC',
  'Guías NIST / IETF / ACPO',
  'Manuales y Doctrina Forense',
];
---

<!-- USWDS: Accordion & Alert | https://designsystem.digital.gov/components/accordion/ -->
<section id="compendio" class="usa-section usa-section--light border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="FUENTE ÚNICA DE VERDAD /RAG/ · HASH SHA-256 VERIFICADO"
      tagVariant="secondary"
      title="Compendio Verificado de Leyes y Estándares Forenses"
      sub="Cada norma listada corresponde exactamente a un documento del repositorio RAG institucional con su huella criptográfica SHA-256 verificada."
    />

    <!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
    <div class="usa-alert usa-alert--info margin-bottom-4">
      <div class="usa-alert__body">
        <p class="usa-alert__text">
          Cada instrumento conserva su resumen criptográfico <strong>SHA-256</strong> exacto calculado sobre el documento original indexado en la carpeta <code>RAG/</code> del proyecto.
        </p>
      </div>
    </div>

    <!-- USWDS: Accordion Bordered | https://designsystem.digital.gov/components/accordion/ -->
    <div class="usa-accordion usa-accordion--bordered">
      {categories.map((cat, idx) => {
        const items = LEGAL_INSTRUMENTS.filter((inst) => inst.category === cat);
        const panelId = `compendio-cat-${idx + 1}`;
        return (
          <>
            <h3 class="usa-accordion__heading">
              <button
                type="button"
                class="usa-accordion__button"
                aria-expanded={idx === 0 ? 'true' : 'false'}
                aria-controls={panelId}
              >
                {cat} ({items.length})
              </button>
            </h3>
            <div id={panelId} class="usa-accordion__content usa-prose" hidden={idx !== 0}>
              <ul class="usa-card-group">
                {items.map((instrument) => (
                  <li class="usa-card tablet:grid-col-6">
                    <LegalInstrumentCard instrument={instrument} />
                  </li>
                ))}
              </ul>
            </div>
          </>
        );
      })}
    </div>
  </div>
</section>
