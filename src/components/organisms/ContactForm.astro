---
// USWDS: Form | https://designsystem.digital.gov/components/form/
---

<!-- USWDS: Form | https://designsystem.digital.gov/components/form/ -->
<div class="bg-white padding-4 border-1px border-base-lighter">
	<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-1">
		Cuéntanos tu caso en palabras sencillas
	</h2>
	<p class="font-sans-xs text-base-dark margin-bottom-3">
		No necesitas usar términos técnicos. Completa estos datos básicos y elige si prefieres enviarnos tu consulta por WhatsApp o por Correo Electrónico:
	</p>

	<!-- USWDS: Alert | https://designsystem.digital.gov/components/alert/ -->
	<div id="contactFormAlert" class="usa-alert usa-alert--warning margin-bottom-3" hidden role="alert">
		<div class="usa-alert__body">
			<p class="usa-alert__text" id="contactFormAlertText">
				Por favor completa Nombre, Correo Electrónico y el Mensaje para continuar.
			</p>
		</div>
	</div>

	<form class="usa-form maxw-full" id="contactForm">
		<fieldset class="usa-fieldset">
			<legend class="usa-legend">Solicitud de Orientación o Peritaje</legend>

			<label class="usa-label" for="nombre">Tu Nombre o Empresa</label>
			<span class="usa-hint" id="nombre-hint">Ej: Abg. Carlos Mendoza o Tu Nombre</span>
			<input class="usa-input" id="nombre" name="nombre" type="text" aria-describedby="nombre-hint" required />

			<label class="usa-label" for="email">Correo Electrónico</label>
			<span class="usa-hint" id="email-hint">tu-correo@ejemplo.com</span>
			<input class="usa-input" id="email" name="email" type="email" aria-describedby="email-hint" required />

			<label class="usa-label" for="telefono">Teléfono / WhatsApp</label>
			<span class="usa-hint" id="telefono-hint">+57 316 3931945</span>
			<input class="usa-input" id="telefono" name="telefono" type="tel" aria-describedby="telefono-hint" />

			<label class="usa-label" for="servicio">¿Qué necesitas certificar o resolver?</label>
			<select class="usa-select" id="servicio" name="servicio">
				<option value="Mensajes o audios de WhatsApp / Teléfono celular">Mensajes o audios de WhatsApp / Teléfono celular</option>
				<option value="Informe pericial para un juicio o tribunal">Informe pericial para un juicio o tribunal</option>
				<option value="Contrato PDF, firma electrónica o correo falso">Contrato PDF, firma electrónica o correo falso</option>
				<option value="Computadora, disco duro o memoria con archivos dañados o borrados">Computadora, disco duro o memoria con archivos dañados o borrados</option>
				<option value="Tengo dudas y necesito orientación sobre mi caso">Tengo dudas y necesito orientación sobre mi caso</option>
			</select>

			<label class="usa-label" for="mensaje">¿Qué ocurrió y cómo podemos ayudarte?</label>
			<span class="usa-hint" id="mensaje-hint">Describe brevemente qué ocurrió, qué archivos necesitas o si tienes una fecha límite de tribunal...</span>
			<textarea class="usa-textarea" id="mensaje" name="mensaje" rows="4" aria-describedby="mensaje-hint" required></textarea>

			<ul class="usa-button-group margin-top-3">
				<li class="usa-button-group__item">
					<button class="usa-button" type="button" id="btnWhatsapp">
						Enviar por WhatsApp &rarr;
					</button>
				</li>
				<li class="usa-button-group__item">
					<button class="usa-button usa-button--outline" type="button" id="btnEmail">
						Enviar por Correo &rarr;
					</button>
				</li>
			</ul>
		</fieldset>
	</form>
</div>

<script>
	(function () {
		const btnWhatsapp = document.getElementById('btnWhatsapp');
		const btnEmail = document.getElementById('btnEmail');
		const alertBox = document.getElementById('contactFormAlert');
		const alertText = document.getElementById('contactFormAlertText');

		function showAlert(msg: string) {
			if (alertBox && alertText) {
				alertText.textContent = msg;
				alertBox.removeAttribute('hidden');
				alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}
		}

		function hideAlert() {
			if (alertBox) alertBox.setAttribute('hidden', '');
		}

		function getFormData() {
			hideAlert();
			const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value.trim();
			const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
			const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value.trim();
			const servicio = (document.getElementById('servicio') as HTMLSelectElement)?.value;
			const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value.trim();

			if (!nombre || !email || !mensaje) {
				showAlert('Por favor completa Nombre, Correo Electrónico y el Mensaje para continuar.');
				return null;
			}

			return { nombre, email, telefono, servicio, mensaje };
		}

		btnWhatsapp?.addEventListener('click', () => {
			const data = getFormData();
			if (!data) return;

			const text =
				`*Consulta en sha256.us*\n\n` +
				`*Nombre:* ${data.nombre}\n` +
				`*Correo:* ${data.email}\n` +
				`*Teléfono:* ${data.telefono || 'No indicado'}\n` +
				`*Necesidad:* ${data.servicio}\n\n` +
				`*Detalles del caso:*\n${data.mensaje}`;

			const waUrl = `https://wa.me/573163931945?text=${encodeURIComponent(text)}`;
			window.open(waUrl, '_blank');
		});

		btnEmail?.addEventListener('click', () => {
			const data = getFormData();
			if (!data) return;

			const subject = encodeURIComponent(`[Consulta sha256.us] ${data.servicio} - ${data.nombre}`);
			const body = encodeURIComponent(
				`Nombre: ${data.nombre}\n` +
				`Correo: ${data.email}\n` +
				`Teléfono: ${data.telefono || 'No indicado'}\n` +
				`Necesidad: ${data.servicio}\n\n` +
				`Detalles del caso:\n${data.mensaje}`
			);

			window.location.href = `mailto:soporte@sha256.us?subject=${subject}&body=${body}`;
		});
	})();
</script>
