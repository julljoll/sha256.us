---
import { CONTACT } from '../../consts';
import Icon from '../atoms/Icon.astro';
---

<div class="bg-white padding-3 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter height-full display-flex flex-column">
	<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-3">
		Información Oficial
	</h2>

	<!-- Respaldo del Gabinete Forense -->
	<div class="bg-primary-lighter padding-3 radius-md border-left-05 border-primary margin-bottom-3">
		<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Gabinete Pericial Especializado</span>
		<p class="font-sans-xs text-primary-darker text-bold margin-0">
			Equipo Forense sha256.us
		</p>
		<p class="font-sans-3xs text-base-dark margin-top-05 margin-bottom-1">
			Recepción técnica, entrevistas preliminares, análisis forense de datos y dictámenes judiciales.
		</p>
		<a href="/about#equipo" class="font-sans-3xs text-primary text-bold hover:underline">
			Conocer integrantes del equipo pericial &rarr;
		</a>
	</div>

	<div class="margin-bottom-3">
		<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Sede Principal</span>
		<p class="font-sans-xs text-base-dark line-height-sans-3 margin-0">
			{CONTACT.address}
		</p>
	</div>

	<div class="margin-bottom-3">
		<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">WhatsApp / Teléfono</span>
		<p class="font-sans-md text-base-dark margin-y-05">
			<a
				href={CONTACT.whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="display-inline-flex flex-align-center text-bold text-no-underline hover:underline text-primary-darker"
				title="Contactar vía WhatsApp"
			>
				<Icon name="whatsapp" size={20} fill="#25D366" class="margin-right-05" />
				<span>{CONTACT.phone.display}</span>
			</a>
		</p>
	</div>

	<div class="margin-bottom-3">
		<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Correo Electrónico</span>
		<p class="font-sans-sm text-base-dark margin-0">
			<a href={`mailto:${CONTACT.email}`} class="usa-link text-bold">{CONTACT.email}</a>
		</p>
	</div>

	<div class="margin-top-auto border-top-1px border-base-lighter padding-top-3">
		<span class="font-sans-3xs text-uppercase text-bold text-base display-block margin-bottom-1">Canales Profesionales</span>
		<div class="display-flex flex-wrap gap-1">
			<a
				href="/about#equipo"
				class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
			>
				Equipo Pericial
			</a>
			<a
				href={CONTACT.social.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
			>
				LinkedIn
			</a>
			<a
				href={CONTACT.social.twitter}
				target="_blank"
				rel="noopener noreferrer"
				class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
			>
				X / Twitter
			</a>
		</div>
	</div>
</div>
