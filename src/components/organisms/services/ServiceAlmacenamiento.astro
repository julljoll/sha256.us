---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import Icon from '../../atoms/Icon.astro';
import SectionHeader from '../../atoms/SectionHeader.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id="almacenamiento" class="usa-section usa-section--light border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="2. COMPUTADORAS Y DATOS"
      tagVariant="primary"
      title="Análisis Forense de Computadoras y Recuperación de Datos"
      sub="Examinamos laptops, PCs y discos duros trabajando siempre sobre copias seguras sin arriesgar tu equipo."
      align="left"
    />

    <ul class="usa-card-group">
      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">COMPUTADORAS</span>
            <h3 class="usa-card__heading">Análisis Forense de Computadoras</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Revisión técnica de laptops, PCs de escritorio, discos duros y memorias USB.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Historial de archivos y accesos</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Conexión de USB y descargas</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Actividad cronológica del equipo</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/contacto" class="usa-button usa-button--outline width-full">Solicitar peritaje &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">RECUPERACIÓN</span>
            <h3 class="usa-card__heading">Recuperación de Datos Borrados</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Rescatamos documentos, fotos y bases de datos eliminadas o en discos formateados.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Discos duros, SSD y memorias USB</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Archivos borrados de forma intencional</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Entrega segura con respaldo</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/contacto" class="usa-button usa-button--outline width-full">Recuperar datos &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">EMPRESAS</span>
            <h3 class="usa-card__heading">Robo o Sabotaje de Información</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Comprobamos si alguien copió, borró o filtró datos confidenciales de tu negocio.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Fuga de bases de clientes</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Accesos no autorizados en PC</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Informe listo para acción legal</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/contacto" class="usa-button usa-button--outline width-full">Consultar caso &rarr;</a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
