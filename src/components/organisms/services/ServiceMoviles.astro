---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import Icon from '../../atoms/Icon.astro';
import SectionHeader from '../../atoms/SectionHeader.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id="moviles" class="usa-section">
  <div class="grid-container">
    <SectionHeader
      tag="1. MÓVILES, WHATSAPP Y REDES"
      tagVariant="accent"
      title="Peritaje de Teléfonos Móviles, WhatsApp y Redes Sociales"
      sub="Extraemos y certificamos la información real de teléfonos Android y iPhone sin borrar tus datos."
      align="left"
    />

    <ul class="usa-card-group">
      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">WHATSAPP</span>
            <h3 class="usa-card__heading">Informe Pericial de WhatsApp</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Certificamos conversaciones, audios y archivos directamente desde tu teléfono para juicio.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Chats individuales y grupos</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Notas de voz y comprobantes</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Mensajes eliminados recuperables</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Solicitar peritaje &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">SMARTPHONES</span>
            <h3 class="usa-card__heading">Peritaje de Dispositivos Móviles</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Análisis forense completo de teléfonos Android y iPhone sin alterar el dispositivo original.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Historial de llamadas y SMS</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Ubicaciones GPS y fotografías</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Devolución rápida de tu equipo</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Solicitar peritaje &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">REDES SOCIALES</span>
            <h3 class="usa-card__heading">Peritaje de Redes Sociales</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Fijamos pruebas legales de mensajes, perfiles y publicaciones en redes antes de que las borren.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Instagram, Facebook, TikTok y X</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Acoso, amenazas y difamación</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Perfiles falsos y estafas</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Solicitar peritaje &rarr;</a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
