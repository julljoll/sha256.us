---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import Icon from '../../atoms/Icon.astro';
import SectionHeader from '../../atoms/SectionHeader.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id="documentos" class="usa-section border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="3. IMÁGENES, WEB Y DOCUMENTOS"
      tagVariant="accent"
      title="Manipulación de Imágenes, Contenido Web y Correos"
      sub="Comprobamos la autenticidad de archivos digitales para detectar montajes, fraudes o alteraciones."
      align="left"
    />

    <ul class="usa-card-group">
      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">IMÁGENES Y AUDIOS</span>
            <h3 class="usa-card__heading">Manipulación de Imágenes y Audios</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Analizamos fotografías, capturas, grabaciones y videos para detectar si fueron editados.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Detección de fotomontajes</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Verificación de fecha y cámara</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Autenticidad de notas de voz</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Analizar archivo &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">CONTENIDO WEB</span>
            <h3 class="usa-card__heading">Certificación de Contenido Web</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Dejamos constancia certificada de páginas web, anuncios o reseñas antes de que desaparezcan.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Páginas web y tiendas online</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Anuncios y ofertas engañosas</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Sello de fecha e integridad</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Certificar web &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">CORREOS Y PDF</span>
            <h3 class="usa-card__heading">Correos Electrónicos y Contratos PDF</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Verificamos la autoría real de correos electrónicos y detectamos recibos o PDFs alterados.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Correos falsos o suplantación</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Facturas y comprobantes editados</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Contratos y firmas digitales</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Verificar documento &rarr;</a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
