---
// USWDS: Card, Summary Box & Accordion | https://designsystem.digital.gov/components/card/
import { Image } from 'astro:assets';
import Badge from '../../atoms/Badge.astro';
import Icon from '../../atoms/Icon.astro';
import imgForense from '../../../assets/services/servicio-juicios.jpg';
---

<!-- USWDS: Summary box, Card & Accordion | https://designsystem.digital.gov/components/accordion/ -->
<section id="forense" class="margin-bottom-6 bg-white padding-3 tablet:padding-5 radius-lg shadow-1 border-1px border-base-lighter">
  <div class="grid-row grid-gap flex-align-center">
    <div class="tablet:grid-col-8">
      <Badge variant="dark" class="margin-bottom-1">2. JUICIOS Y TRIBUNALES</Badge>
      <h2 class="font-sans-xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
        Dictámenes Periciales Informáticos para Procesos Judiciales
      </h2>

      <div class="usa-summary-box margin-bottom-3" role="region" aria-label="¿Cuándo necesitas este servicio?">
        <div class="usa-summary-box__body">
          <h3 class="usa-summary-box__heading font-sans-xs text-uppercase display-flex flex-align-center">
            <Icon name="check_circle" class="margin-right-05 text-primary" />
            ¿Cuándo necesitas este servicio?
          </h3>
          <div class="usa-summary-box__text font-sans-xs">
            Si estás en un juicio civil, mercantil, laboral o penal y necesitas probar una deuda, acuerdo o delito digital sin que la contraparte invalide tus pruebas alegando manipulación.
          </div>
        </div>
      </div>

      <ul class="usa-card-group margin-bottom-2">
        <li class="usa-card mobile-lg:grid-col-6">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <h3 class="usa-card__heading font-sans-sm">Recepción Legal y Privacidad</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs text-base-dark margin-0">Actuamos únicamente con consentimiento expreso del titular (CRBV Art. 28) o mandato judicial.</p>
            </div>
          </div>
        </li>
        <li class="usa-card mobile-lg:grid-col-6">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <h3 class="usa-card__heading font-sans-sm">Copia Segura y Hash SHA-256</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs text-base-dark margin-0">Adquirimos la evidencia sin modificar tu equipo y sellamos cada archivo con SHA-256.</p>
            </div>
          </div>
        </li>
        <li class="usa-card mobile-lg:grid-col-6">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <h3 class="usa-card__heading font-sans-sm">Dictamen Motivado</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs text-base-dark margin-0">Describimos el objeto, los exámenes científicos practicados y las conclusiones claras para el juez.</p>
            </div>
          </div>
        </li>
        <li class="usa-card mobile-lg:grid-col-6">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <h3 class="usa-card__heading font-sans-sm">Cadena de Custodia (PRCC)</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs text-base-dark margin-0">Trazabilidad completa conforme al Manual Único de Cadena de Custodia (MUCC-2017).</p>
            </div>
          </div>
        </li>
      </ul>

      <!-- Revelación Progresiva para Abogados y Jueces -->
      <div class="usa-accordion usa-accordion--bordered">
        <h3 class="usa-accordion__heading">
          <button
            type="button"
            class="usa-accordion__button font-sans-xs"
            aria-expanded="false"
            aria-controls="acc-tech-forense"
          >
            Ver respaldo legal y normas técnicas (para abogados y tribunales)
          </button>
        </h3>
        <div id="acc-tech-forense" class="usa-accordion__content usa-prose" hidden>
          <p class="font-sans-xs text-base-dark">
            Ejecutamos las 4 fases de identificación, preservación, análisis y dictamen bajo <strong>ISO/IEC 27037:2012</strong> e <strong>ISO/IEC 27042:2015</strong>, registro en Planilla <strong>PRCC (MUCC-2017)</strong> y dictamen motivado conforme a los <strong>Arts. 197 y 237–239 del COPP</strong>, <strong>Arts. 395 y 451–471 del CPC</strong>, <strong>Arts. 1.354 y 1.422–1.427 del Código Civil</strong> y <strong>LMDFE (G.O. N° 37.148)</strong>.
          </p>
          <div class="display-flex flex-wrap margin-top-1">
            <span class="usa-tag bg-white text-primary border-1px border-primary-light margin-right-05 margin-bottom-05">CRBV Arts. 28, 48 y 49</span>
            <span class="usa-tag bg-white text-primary border-1px border-primary-light margin-right-05 margin-bottom-05">COPP Arts. 197, 237–239</span>
            <span class="usa-tag bg-white text-primary border-1px border-primary-light margin-right-05 margin-bottom-05">CPC Arts. 395, 451–471</span>
            <span class="usa-tag bg-white text-primary border-1px border-primary-light margin-right-05 margin-bottom-05">CC Arts. 1.354 y 1.422</span>
            <span class="usa-tag bg-white text-primary border-1px border-primary-light margin-right-05 margin-bottom-05">LMDFE Arts. 4 y 7</span>
          </div>
        </div>
      </div>
    </div>
    <div class="tablet:grid-col-4 margin-top-3 tablet:margin-top-0 display-flex flex-column flex-justify-center text-center">
      <div class="margin-bottom-2 radius-lg overflow-hidden border-1px border-primary-light">
        <Image
          src={imgForense}
          alt="Peritaje digital judicial para tribunales"
          width={640}
          height={360}
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="bg-primary-lighter padding-4 radius-lg width-full border-1px border-primary-light">
        <h3 class="font-sans-md text-bold text-primary-darker margin-top-0 margin-bottom-1">¿Necesitas presentar una prueba en juicio?</h3>
        <p class="font-sans-xs text-base-dark margin-bottom-2">Cuéntanos tu caso y evaluamos cómo certificar tu evidencia de forma rápida y confidencial.</p>
        <a href="/contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink width-full margin-bottom-1">
          <span class="text-ink text-bold">Consultar mi Caso</span>
        </a>
        <a href="/normativa" class="usa-button usa-button--outline width-full font-sans-2xs">Ver Respaldo Legal</a>
      </div>
    </div>
  </div>
</section>
