---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import Icon from '../../atoms/Icon.astro';
import SectionHeader from '../../atoms/SectionHeader.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id="forense" class="usa-section usa-section--light border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="4. PERITAJE LABORAL Y JUDICIAL"
      tagVariant="dark"
      title="Informes Periciales para Juicios Laborales, Civiles y Penales"
      sub="Convertimos tus pruebas de móviles o computadoras en un dictamen claro aceptado en tribunales."
      align="left"
    />

    <ul class="usa-card-group">
      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">LABORAL</span>
            <h3 class="usa-card__heading">Peritaje Informático Laboral</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Acreditamos pruebas digitales en conflictos entre empresas y trabajadores.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Despidos, órdenes y horarios</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Acoso laboral por mensajería</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Competencia desleal o fugas</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Consultar caso laboral &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">CIVIL Y PENAL</span>
            <h3 class="usa-card__heading">Peritaje Civil, Mercantil y Penal</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Evidencia digital certificada para respaldar demandas, denuncias o defensas.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Cobro de préstamos y deudas</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Estafas, amenazas y extorsión</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Incumplimientos de contrato</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button usa-button--outline width-full">Solicitar peritaje &rarr;</a>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-4">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary-darker text-white margin-bottom-1">TRIBUNALES</span>
            <h3 class="usa-card__heading">Informe y Defensa en Juicio</h3>
          </div>
          <div class="usa-card__body">
            <p class="font-sans-xs text-ink margin-top-0 margin-bottom-2">
              Entregamos un dictamen pericial comprensible para el juez y ratificamos en audiencia.
            </p>
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Lenguaje claro y preciso</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Anexos con huellas digitales</div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary"><Icon name="check" /></div>
                <div class="usa-icon-list__content font-sans-2xs">Ratificación oral del perito</div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <a href="/#contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink width-full">
              <span class="text-ink text-bold">Pedir presupuesto &rarr;</span>
            </a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
