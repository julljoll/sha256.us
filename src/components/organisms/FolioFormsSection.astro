---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import FolioFormCard from '../molecules/FolioFormCard.astro';
import { FOLIO_FORMS_CATALOG, ADMISSIBILITY_GUARANTEES, FORENSE_PORTAL_URL } from '../../consts';

export interface Props {
  id?: string;
}

const { id = 'planillas-folio' } = Astro.props;
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id={id} class="usa-section border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="INSTRUMENTOS PERICIALES EN FORMATO FOLIO (216mm × 330mm)"
      tagVariant="primary"
      title="Catálogo Oficial de 13 Planillas Forenses y Cadena de Custodia"
      sub="Cada fase del ciclo pericial (F0 a F5) se documenta en papel tamaño Folio/Oficio con doble firma pericial, control dactiloscópico bilateral y código de verificación criptográfica SHA-256."
    />

    <!-- 4 Garantías de Admisibilidad Probatoria (COPP Art. 187 & MUCC-2017) -->
    <ul class="usa-card-group margin-bottom-4">
      {ADMISSIBILITY_GUARANTEES.map((g) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <span class="usa-tag bg-primary-lighter text-primary-darker margin-bottom-1">{g.code}</span>
              <h3 class="usa-card__heading">{g.title}</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs">{g.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- Grid de las 13 Planillas Oficiales en Folio -->
    <ul class="usa-card-group">
      {FOLIO_FORMS_CATALOG.map((form) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-4">
          <FolioFormCard form={form} />
        </li>
      ))}
    </ul>

    <div class="margin-top-4">
      <ul class="usa-button-group">
        <li class="usa-button-group__item">
          <a
            href={`${FORENSE_PORTAL_URL}/planillas`}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button"
          >
            Acceder al Generador de Planillas en forense.sha256.us/planillas
          </a>
        </li>
        <li class="usa-button-group__item">
          <a
            href={`${FORENSE_PORTAL_URL}/custodia`}
            target="_blank"
            rel="noopener noreferrer"
            class="usa-button usa-button--outline"
          >
            Protocolo de Cadena de Custodia (PRCC)
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
