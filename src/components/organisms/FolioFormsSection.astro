---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import FolioFormCard from '../molecules/FolioFormCard.astro';
import { CHAIN_OF_CUSTODY_ITEMS, ADMISSIBILITY_GUARANTEES } from '../../consts';

export interface Props {
  id?: string;
}

const { id = 'cadena-custodia' } = Astro.props;
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id={id} class="usa-section border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="GARANTÍAS DE INALTERABILIDAD · MUCC-2017 & ISO/IEC 27037"
      tagVariant="primary"
      title="Sistema de Cadena de Custodia (PRCC) y Garantías Técnicas"
      sub="Aplicamos el Manual Único de Cadena de Custodia (MUCC-2017) y las normas ISO/IEC 27037 y NIST SP 800-101 para demostrar que la evidencia no fue alterada desde su recepción hasta la sentencia."
    />

    <!-- 4 Garantías Técnicas Verificadas -->
    <ul class="usa-card-group margin-bottom-4">
      {ADMISSIBILITY_GUARANTEES.map((g) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-3">
          <div class="usa-card__container">
            <div class="usa-card__header">
              <span class="usa-tag bg-primary-lighter text-primary-darker margin-bottom-1">{g.code}</span>
              <h3 class="usa-card__heading">{g.title}</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-2xs text-base-dark margin-0">{g.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- 6 Fases, Modalidades y Figuras Oficiales del MUCC-2017 -->
    <ul class="usa-card-group">
      {CHAIN_OF_CUSTODY_ITEMS.map((item) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-4">
          <FolioFormCard item={item} />
        </li>
      ))}
    </ul>
  </div>
</section>
