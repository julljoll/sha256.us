---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import PillarCard from '../molecules/PillarCard.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<ul class="usa-card-group margin-top-2">
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="1"
      title="Evidencia Inalterable"
      description="Cálculo matemático SHA-256 antes y después de la copia para demostrar que ningún dato fue alterado."
    />
  </li>
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="2"
      title="Validez ante Tribunales"
      description="Planilla de Registro de Cadena de Custodia (PRCC — MUCC-2017) y dictamen motivado para que el juez admita la prueba."
    />
  </li>
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="3"
      title="Explicación Clara"
      description="Traducimos los hallazgos técnicos (SQLite, metadatos, hashes) a conclusiones comprensibles para clientes y jueces."
    />
  </li>
</ul>
