---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import PillarCard from '../molecules/PillarCard.astro';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<ul class="usa-card-group margin-top-2">
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="1"
      title="Sin Alterar tu Equipo"
      description="Examinamos teléfonos y computadoras sobre copias seguras sin borrar tus archivos personales."
    />
  </li>
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="2"
      title="Válido en Juicio"
      description="Emitimos informes periciales claros y firmados para presentar y defender ante el tribunal."
    />
  </li>
  <li class="usa-card tablet:grid-col-4">
    <PillarCard
      number="3"
      title="Atención Directa"
      description="Orientación confidencial y rápida para particulares, despachos de abogados y empresas."
    />
  </li>
</ul>
