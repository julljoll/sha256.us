---
// USWDS: Summary Box, Alert, Icon List & Process List | https://designsystem.digital.gov/components/process-list/
import SectionHeader from '../atoms/SectionHeader.astro';
import ProcessStepCard from '../molecules/ProcessStepCard.astro';
import Icon from '../atoms/Icon.astro';
import { ISO_FORENSIC_PHASES, CLIENT_SIMPLE_STEPS, FORENSE_PORTAL_URL, CONTACT } from '../../consts';

export interface Props {
  detailed?: boolean;
  id?: string;
}

const { detailed = false, id = 'ciclo-f0-f5' } = Astro.props;
---

<!-- USWDS: Process List | https://designsystem.digital.gov/components/process-list/ -->
<section id={id} class="usa-section usa-section--light">
  <div class="grid-container">
    {detailed ? (
      <>
        <SectionHeader
          tag="CICLO PERICIAL ISO DE 6 FASES (F0 A F5)"
          tagVariant="secondary"
          title="Flujo de Trabajo Forense y Cadena de Custodia Auditada"
          sub="Procedimiento científico sincronizado con el sistema oficial forense.sha256.us bajo ISO/IEC 27037, ISO/IEC 27042, NIST SP 800-86, MUCC-2017 y el Artículo 187 del COPP."
        />

        <!-- USWDS: Summary Box | https://designsystem.digital.gov/components/summary-box/ -->
        <div class="usa-summary-box margin-bottom-4" role="region" aria-labelledby="summary-box-forense-flujo">
          <div class="usa-summary-box__body">
            <h3 class="usa-summary-box__heading" id="summary-box-forense-flujo">
              Garantía de Trazabilidad e Inalterabilidad Criptográfica (F0 &rarr; F5)
            </h3>
            <div class="usa-summary-box__text">
              <p>
                Ninguna fase del ciclo pericial puede iniciarse sin haber cerrado y firmado los controles obligatorios de la fase precedente en papel <strong>Folio (216 mm &times; 330 mm)</strong>. El dispositivo original jamás es analizado directamente: en la <strong>Fase F2</strong> se bloquea la escritura por hardware (<em>Write-Blocker</em>), se genera el <strong>Hash Génesis SHA-256</strong> y el equipo físico se resguarda o devuelve al titular mientras el laboratorio opera sobre la copia forense verificada.
              </p>
              <ul class="usa-button-group margin-top-2">
                <li class="usa-button-group__item">
                  <a
                    href={`${FORENSE_PORTAL_URL}/flujo`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="usa-button"
                  >
                    Ver Flujo Interactivo en forense.sha256.us/flujo
                  </a>
                </li>
                <li class="usa-button-group__item">
                  <a href="/normativa#planillas-folio" class="usa-button usa-button--outline">
                    Explorar las 13 Planillas Oficiales en Folio &rarr;
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <ol class="usa-process-list">
          {ISO_FORENSIC_PHASES.map((phase) => (
            <ProcessStepCard
              stepNumber={phase.stepNumber}
              badgeTag={phase.badgeTag}
              badgeVariant={phase.badgeVariant}
              title={phase.title}
              description={phase.description}
              norms={phase.norms}
              responsible={phase.responsible}
              controls={phase.controls}
              planillas={phase.planillas}
            />
          ))}
        </ol>
      </>
    ) : (
      <>
        <SectionHeader
          tag="PROCESO FÁCIL Y TRANSPARENTE"
          tagVariant="secondary"
          title="¿Cómo trabajamos tu caso en 3 simples pasos?"
          sub="Nos encargamos de toda la complejidad técnica y legal en nuestro laboratorio para que tú solo tengas que seguir tres pasos sencillos."
        />

        <ol class="usa-process-list">
          {CLIENT_SIMPLE_STEPS.map((step) => (
            <ProcessStepCard
              stepNumber={step.stepNumber}
              badgeTag={step.badgeTag}
              badgeVariant="primary"
              title={step.title}
              description={step.description}
              controls={step.bullets}
            />
          ))}
        </ol>

        <!-- USWDS: Card, Icon List & Alert | https://designsystem.digital.gov/components/icon-list/ & https://designsystem.digital.gov/components/alert/ -->
        <div class="bg-white border-1px border-base-lighter shadow-2 radius-md overflow-hidden margin-top-4" role="region" aria-labelledby="heading-caso-estafa">
          <!-- Cabecera Institucional Oscura -->
          <div class="bg-primary-darker text-white padding-3 tablet:padding-4">
            <div class="display-flex flex-align-center flex-wrap margin-bottom-1">
              <span class="usa-tag bg-secondary text-white font-sans-3xs text-bold margin-right-1">CASO DE USO REAL</span>
              <span class="usa-tag bg-gold text-ink font-sans-3xs text-bold">RECUPERACIÓN Y PERITAJE DE EVIDENCIA</span>
            </div>
            <h3 class="font-sans-lg tablet:font-sans-xl text-bold text-white margin-top-1 margin-bottom-1" id="heading-caso-estafa">
              Caso de Uso: Estafa mediante WhatsApp y TikTok
            </h3>
            <p class="font-sans-xs text-base-lightest line-height-sans-4 margin-0">
              Si fuiste víctima de un fraude digital y el estafador borró la conversación o te bloqueó, aún es posible recuperar y certificar legalmente las pruebas. Este es un caso típico que resolvemos en nuestro laboratorio:
            </p>
          </div>

          <!-- Cuerpo Principal del Caso de Uso -->
          <div class="padding-3 tablet:padding-4">
            <div class="grid-row grid-gap margin-bottom-3">
              <!-- Columna 1: El Escenario (Los Hechos) -->
              <div class="tablet:grid-col-6 margin-bottom-2 tablet:margin-bottom-0">
                <div class="bg-base-lightest padding-3 border-top-05 border-secondary radius-md height-full">
                  <div class="display-flex flex-align-center margin-bottom-2">
                    <span class="usa-tag bg-secondary text-white font-sans-3xs text-bold margin-right-1">FASE 1</span>
                    <h4 class="font-sans-sm text-bold text-primary-darker margin-0">
                      El Escenario (Los Hechos)
                    </h4>
                  </div>
                  <ul class="usa-icon-list">
                    <li class="usa-icon-list__item margin-bottom-2">
                      <div class="usa-icon-list__icon text-secondary">
                        <Icon name="warning" />
                      </div>
                      <div class="usa-icon-list__content font-sans-2xs text-base-dark line-height-sans-3">
                        <strong class="text-ink display-block margin-bottom-05">Contacto inicial (TikTok):</strong>
                        Identificas un perfil con ofertas atractivas de inversión en criptoactivos (USDT), venta de vehículos o equipos a bajo costo. Por mensajes directos (DM), te envían videos o audios explicativos y te solicitan continuar la negociación por WhatsApp para coordinar el pago.
                      </div>
                    </li>
                    <li class="usa-icon-list__item">
                      <div class="usa-icon-list__icon text-secondary">
                        <Icon name="error" />
                      </div>
                      <div class="usa-icon-list__content font-sans-2xs text-base-dark line-height-sans-3">
                        <strong class="text-ink display-block margin-bottom-05">Cierre y estafa (WhatsApp):</strong>
                        Mediante notas de voz y documentos persuasivos, te inducen a realizar un Pago Móvil, transferencia bancaria o envío de USDT bajo concepto de "reserva" o "adelanto". Al confirmar la recepción del dinero, el estafador presiona <em>"Eliminar para todos"</em>, te bloquea en ambas aplicaciones y desaparece.
                      </div>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Columna 2: Cómo Protegemos y Certificamos tu Prueba -->
              <div class="tablet:grid-col-6">
                <div class="bg-base-lightest padding-3 border-top-05 border-primary radius-md height-full">
                  <div class="display-flex flex-align-center margin-bottom-2">
                    <span class="usa-tag bg-primary text-white font-sans-3xs text-bold margin-right-1">FASE 2</span>
                    <h4 class="font-sans-sm text-bold text-primary-darker margin-0">
                      Cómo Protegemos y Certificamos tu Prueba
                    </h4>
                  </div>
                  <ul class="usa-icon-list">
                    <li class="usa-icon-list__item margin-bottom-2">
                      <div class="usa-icon-list__icon text-primary">
                        <Icon name="check_circle" />
                      </div>
                      <div class="usa-icon-list__content font-sans-2xs text-base-dark line-height-sans-3">
                        <strong class="text-ink display-block margin-bottom-05">La evidencia no desaparece:</strong>
                        Aunque en tu pantalla aparezca <em>"Este mensaje fue eliminado"</em>, los registros reales siguen grabados en la base de datos interna de tu teléfono (<code>msgstore.db</code>), los archivos de audio en caché (<code>.opus</code>) y los registros de red.
                      </div>
                    </li>
                    <li class="usa-icon-list__item">
                      <div class="usa-icon-list__icon text-primary">
                        <Icon name="verified_user" />
                      </div>
                      <div class="usa-icon-list__content font-sans-2xs text-base-dark line-height-sans-3">
                        <strong class="text-ink display-block margin-bottom-05">Validez para tu denuncia:</strong>
                        Extraemos los mensajes originales con Hash Génesis SHA-256 (inmutable), certificamos la voz del estafador y emitimos un dictamen pericial con plena validez para consignar tu denuncia formal ante el Ministerio Público o el CICPC.
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Alerta Oficial USWDS de Recomendación Urgente -->
            <div class="usa-alert usa-alert--warning margin-top-0 margin-bottom-3">
              <div class="usa-alert__body">
                <h4 class="usa-alert__heading font-sans-xs text-bold">
                  ¿Te ocurrió una situación similar? Recomendación urgente del perito:
                </h4>
                <p class="usa-alert__text font-sans-2xs">
                  <strong>No borres el chat</strong>, no desinstales WhatsApp ni restablezcas tu teléfono. Activa el <strong>Modo Avión</strong> para evitar comandos remotos de borrado y contáctanos de inmediato para preservar la evidencia antes de que se sobreescriba.
                </p>
              </div>
            </div>

            <!-- Barra Inferior de Acción Directa (CTA) -->
            <div class="border-top-1px border-base-lighter padding-top-3 display-flex flex-align-center flex-wrap">
              <ul class="usa-button-group">
                <li class="usa-button-group__item">
                  <a href="/contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink">
                    <span class="text-ink text-bold">Consultar mi Caso Ahora</span>
                  </a>
                </li>
                <li class="usa-button-group__item">
                  <a
                    href={CONTACT.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="usa-button"
                  >
                    Atención Inmediata por WhatsApp
                  </a>
                </li>
                <li class="usa-button-group__item">
                  <a href="/servicios#moviles" class="usa-button usa-button--outline">
                    Ver Peritaje de WhatsApp y Móviles &rarr;
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</section>
