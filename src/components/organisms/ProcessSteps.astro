---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import Icon from '../atoms/Icon.astro';
import { CLIENT_SIMPLE_STEPS } from '../../consts';

export interface Props {
  detailed?: boolean;
  id?: string;
}

const { id = 'como-trabajamos' } = Astro.props;
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section id={id} class="usa-section usa-section--light border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="CÓMO CONTRATAR"
      tagVariant="secondary"
      title="Tu informe pericial en 3 pasos"
      sub="Proceso directo, confidencial y sin alterar la información de tu equipo."
    />

    <ul class="usa-card-group">
      {CLIENT_SIMPLE_STEPS.map((step) => (
        <li class="usa-card tablet:grid-col-4">
          <div class="usa-card__container">
            {step.image && (
              <div class="usa-card__media">
                <div class="usa-card__img">
                  <img
                    src={step.image}
                    alt={step.imageAlt}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            )}
            <div class="usa-card__header">
              <span class="usa-tag bg-primary text-white margin-bottom-1">{step.badgeTag}</span>
              <h3 class="usa-card__heading">{step.title}</h3>
            </div>
            <div class="usa-card__body">
              <p class="font-sans-xs text-ink line-height-sans-3 margin-top-0 margin-bottom-2">
                {step.description}
              </p>
              <ul class="usa-icon-list">
                {step.bullets.map((b) => (
                  <li class="usa-icon-list__item">
                    <div class="usa-icon-list__icon text-primary">
                      <Icon name="check_circle" />
                    </div>
                    <div class="usa-icon-list__content font-sans-2xs">
                      {b}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
