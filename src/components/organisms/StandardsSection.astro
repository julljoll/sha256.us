---
// USWDS: Card Group | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import Icon from '../atoms/Icon.astro';
import { CONTACT } from '../../consts';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section class="usa-section usa-section--light border-top-1px border-base-lighter">
  <div class="grid-container">
    <SectionHeader
      tag="GARANTÍA EN JUICIO"
      tagVariant="primary"
      title="¿Por qué contratar un peritaje en lugar de llevar capturas?"
      sub="En un juicio, la diferencia entre que rechacen o acepten tu prueba está en el informe pericial."
    />

    <ul class="usa-card-group">
      <li class="usa-card tablet:grid-col-6">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-secondary text-white margin-bottom-1">SIN PERITAJE</span>
            <h3 class="usa-card__heading">Captura de Pantalla Simple</h3>
          </div>
          <div class="usa-card__body">
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-secondary">
                  <Icon name="warning" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  La otra parte puede impugnarla diciendo que fue editada.
                </div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-secondary">
                  <Icon name="warning" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  No prueba quién envió realmente el mensaje ni la fecha exacta.
                </div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-secondary">
                  <Icon name="warning" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  No sirve para recuperar mensajes borrados del teléfono.
                </div>
              </li>
            </ul>
          </div>
        </div>
      </li>

      <li class="usa-card tablet:grid-col-6">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <span class="usa-tag bg-primary text-white margin-bottom-1">CON sha256.us</span>
            <h3 class="usa-card__heading">Informe Pericial Forense</h3>
          </div>
          <div class="usa-card__body">
            <ul class="usa-icon-list">
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary">
                  <Icon name="check_circle" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  Prueba auténtica extraída directamente del dispositivo original.
                </div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary">
                  <Icon name="check_circle" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  Sello digital único que garantiza que el archivo no fue manipulado.
                </div>
              </li>
              <li class="usa-icon-list__item">
                <div class="usa-icon-list__icon text-primary">
                  <Icon name="check_circle" />
                </div>
                <div class="usa-icon-list__content font-sans-2xs">
                  Dictamen firmado por perito para presentar y defender en juicio.
                </div>
              </li>
            </ul>
          </div>
          <div class="usa-card__footer">
            <ul class="usa-button-group flex-wrap">
              <li class="usa-button-group__item">
                <a href="/#contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink">
                  <span class="text-ink text-bold">Solicitar Presupuesto &rarr;</span>
                </a>
              </li>
              <li class="usa-button-group__item">
                <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline">
                  WhatsApp Directo
                </a>
              </li>
            </ul>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
