---
// USWDS: Card Group & Summary Box | https://designsystem.digital.gov/components/card/
import SectionHeader from '../atoms/SectionHeader.astro';
import StandardCard from '../molecules/StandardCard.astro';
import { STANDARDS, FORENSE_PORTAL_URL } from '../../consts';
---

<!-- USWDS: Card Group | https://designsystem.digital.gov/components/card/ -->
<section class="usa-section">
  <div class="grid-container">
    <SectionHeader
      tag="SUSTENTO LEGAL Y CIENTÍFICO (/Informatica/)"
      tagVariant="primary"
      title="Leyes Informáticas y Normas Técnicas Oficiales"
      sub="La admisibilidad jurídica de la evidencia digital depende del rigor normativo. Todas nuestras actuaciones están sustentadas en 28 instrumentos legales y técnicos verificados con Hash SHA-256."
    />

    <ul class="usa-card-group">
      {STANDARDS.map((std) => (
        <li class="usa-card tablet:grid-col-6 desktop:grid-col-4">
          <StandardCard
            tag={std.tag}
            code={std.code}
            title={std.title}
            desc={std.desc}
            hash={std.hash}
          />
        </li>
      ))}
    </ul>

    <!-- USWDS: Summary Box | https://designsystem.digital.gov/components/summary-box/ -->
    <div class="usa-summary-box margin-top-4" role="region" aria-labelledby="summary-box-piramide">
      <div class="usa-summary-box__body">
        <h3 class="usa-summary-box__heading" id="summary-box-piramide">
          PIRÁMIDE NORMATIVA COPP ART. 225 &bull; REPOSITORIO /Informatica/
        </h3>
        <div class="usa-summary-box__text">
          <p>
            Consulta la <strong>Pirámide de Aplicación y Supletoriedad</strong> (CRBV, COPP, CPC, LMDFE, LEDI, MUCC-2017, CENIF, SUSCERTE, LOTEL, ISO/IEC y NIST), el catálogo de las <strong>13 Planillas Oficiales en Folio</strong> y los hashes SHA-256 de cada ley informática que sustenta nuestro laboratorio.
          </p>
          <ul class="usa-button-group margin-top-2">
            <li class="usa-button-group__item">
              <a href="/normativa" class="usa-button">
                Ver Marco Legal y 13 Planillas Folio &rarr;
              </a>
            </li>
            <li class="usa-button-group__item">
              <a
                href={`${FORENSE_PORTAL_URL}/normativa`}
                target="_blank"
                rel="noopener noreferrer"
                class="usa-button usa-button--outline"
              >
                Portal Forense
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
