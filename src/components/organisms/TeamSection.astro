---
import { TEAM_MEMBERS } from '../../consts';
import Badge from '../atoms/Badge.astro';
import TeamMemberCard from '../molecules/TeamMemberCard.astro';
---

<!-- USWDS: Card group | https://designsystem.digital.gov/components/card/ -->
<section id="equipo" class="margin-top-6 border-top-2px border-base-lighter padding-top-5">
  <div class="margin-bottom-4 text-center maxw-tablet margin-x-auto">
    <Badge variant="primary" class="margin-bottom-1">RESPALDO PROFESIONAL</Badge>
    <h2 class="font-sans-2xl text-bold text-primary-darker margin-top-1 margin-bottom-1">
      Equipo Forense y Pericial Multidisciplinario
    </h2>
    <p class="font-sans-sm text-base-dark line-height-sans-4">
      Articulamos las fases de recepción, entrevista y adquisición segura con el análisis científico de datos y la defensa de dictámenes en tribunales.
    </p>
  </div>

  <ul class="usa-card-group">
    {TEAM_MEMBERS.map((member) => (
      <li class="usa-card tablet:grid-col-6">
        <TeamMemberCard member={member} />
      </li>
    ))}
  </ul>
</section>
