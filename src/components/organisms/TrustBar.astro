---
import TrustItem from '../molecules/TrustItem.astro';
---

<section class="sha-trustbar" aria-label="Garantías institucionales y estándares técnicos">
  <div class="sha-trustbar__inner">
    <TrustItem icon="court" text="Validez en Juicios y Tribunales" />
    <TrustItem icon="hash" text="Prueba Intacta (Hash SHA-256)" />
    <TrustItem icon="chain" text="Cadena de Custodia MUCC-2017" />
    <TrustItem icon="shield" text="Estándares ISO/IEC & NIST" />
  </div>
</section>

<style>
  .sha-trustbar {
    background: #1a2b4b;
    border-bottom: 2px solid #0050a4;
  }
  .sha-trustbar__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
  }
  @media (max-width: 640px) {
    .sha-trustbar__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
      padding: 0.75rem 1rem;
    }
  }
</style>
