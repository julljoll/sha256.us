---
// USWDS: Section & Icon List | https://designsystem.digital.gov/components/icon-list/
import TrustItem from '../molecules/TrustItem.astro';
import { TRUST_ITEMS } from '../../consts';
---

<!-- USWDS: Icon List | https://designsystem.digital.gov/components/icon-list/ -->
<section class="bg-base-lightest border-bottom-1px border-base-lighter padding-y-2" aria-label="Garantías institucionales y estándares técnicos">
  <div class="grid-container">
    <div class="grid-row grid-gap">
      {TRUST_ITEMS.map((item) => (
        <div class="tablet:grid-col-6 desktop:grid-col-3 margin-y-05">
          <TrustItem icon={item.icon} text={item.text} />
        </div>
      ))}
    </div>
  </div>
</section>
