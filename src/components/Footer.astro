---
// USWDS: Footer | https://designsystem.digital.gov/components/footer/
import { COMPANY, CONTACT } from '../consts';
---

<!-- USWDS: Footer | https://designsystem.digital.gov/components/footer/ -->
<footer class="usa-footer">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#">Volver al inicio de la página</a>
  </div>
  <div class="usa-footer__primary-section">
    <nav class="usa-footer__nav" aria-label="Navegación del pie de página">
      <ul class="grid-row grid-gap">
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/">Inicio</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/servicios">Servicios Forenses</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/normativa">Marco Legal &amp; Proceso</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/normativa#planillas-folio">13 Planillas en Folio</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/blog">Blog &amp; Casos</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/about">Sobre Nosotros</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/contacto">Contacto y Recepción</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="https://forense.sha256.us/" target="_blank" rel="noopener noreferrer">Sistema de Gestión Forense</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/sitemap-index.xml">Mapa del Sitio (XML)</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2">
          <div class="mobile-lg:grid-col-auto">
            <img class="usa-footer__logo-img" src="/logo.png" alt="Logo oficial de sha256.us" />
          </div>
          <div class="mobile-lg:grid-col-auto">
            <p class="usa-footer__logo-heading">{COMPANY.name} — Laboratorio Forense Digital</p>
            <p class="font-sans-xs text-base-light margin-top-1 margin-bottom-0">
              Un portal institucional oficial del <a class="usa-link" href="/about">Laboratorio de Informática Forense y Peritaje Digital Judicial {COMPANY.name}</a>
            </p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.linkedin} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/linkedin.svg" alt="LinkedIn" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.twitter} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/x.svg" alt="X" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.instagram} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/instagram.svg" alt="Instagram" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href="/rss.xml">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/rss_feed.svg" alt="RSS" />
              </a>
            </div>
          </div>
          <p class="usa-footer__contact-heading">Sede y Guardia Pericial</p>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer">
                  {CONTACT.phone.display}
                </a>
              </div>
              <div class="grid-col-auto">
                <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
