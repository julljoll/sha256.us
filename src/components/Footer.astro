---
import { CONTACT } from '../consts';
import Icon from './atoms/Icon.astro';
const today = new Date();
---

<footer class="usa-footer usa-footer--big bg-base-darkest text-white margin-top-auto border-top-2px border-primary">
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2 padding-y-5">
		<div class="grid-row grid-gap">
			<!-- Columna 1: Identidad con Logo Footer -->
			<div class="tablet:grid-col-4 margin-bottom-3 tablet:margin-bottom-0">
				<div class="margin-bottom-2">
					<img
						src="/logo-footer.png"
						alt="sha256.us"
						class="height-8 width-auto maxw-full object-contain"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<p class="font-sans-xs text-base-light line-height-sans-3 margin-y-1">
					Auditoría de dispositivos digitales y análisis de evidencias informáticas. Garantizamos integridad inalterable y estricta validez jurídica en cada peritaje.
				</p>
				<p class="font-sans-3xs text-base-light line-height-sans-3 margin-y-1">
					Equipo Forense Multidisciplinario &bull; <a href="/about#equipo" class="text-white text-bold hover:underline">Conoce a nuestro equipo pericial &rarr;</a>
				</p>
				<span class="usa-tag bg-primary font-sans-3xs text-white">Cumplimiento ISO/IEC & NIST</span>
			</div>

			<!-- Columna 2: Navegación Rápida -->
			<div class="mobile:grid-col-6 tablet:grid-col-2 margin-bottom-3 tablet:margin-bottom-0">
				<h4 class="font-sans-sm text-bold text-white text-uppercase margin-top-0 margin-bottom-1">Enlaces Rápidos</h4>
				<ul class="list-style-none padding-0 margin-0 font-sans-xs">
					<li class="margin-y-05"><a href="/" class="text-base-lighter hover:text-white text-no-underline">Inicio</a></li>
					<li class="margin-y-05"><a href="/servicios" class="text-base-lighter hover:text-white text-no-underline">Servicios Forenses</a></li>
					<li class="margin-y-05"><a href="/blog" class="text-base-lighter hover:text-white text-no-underline">Blog & Artículos</a></li>
					<li class="margin-y-05"><a href="/about" class="text-base-lighter hover:text-white text-no-underline">Sobre Nosotros</a></li>
					<li class="margin-y-05"><a href="/contacto" class="text-base-lighter hover:text-white text-no-underline">Contacto</a></li>
				</ul>
			</div>

			<!-- Columna 3: Estándares -->
			<div class="mobile:grid-col-6 tablet:grid-col-3 margin-bottom-3 tablet:margin-bottom-0">
				<h4 class="font-sans-sm text-bold text-white text-uppercase margin-top-0 margin-bottom-1">Normativa Técnica</h4>
				<ul class="list-style-none padding-0 margin-0 font-sans-3xs text-base-light">
					<li class="margin-y-1"><strong class="text-white">ISO/IEC 27037:</strong> Adquisición y preservación</li>
					<li class="margin-y-1"><strong class="text-white">ISO/IEC 27042:</strong> Interpretación de evidencia</li>
					<li class="margin-y-1"><strong class="text-white">NIST SP 800:</strong> Dispositivos móviles y redes</li>
					<li class="margin-y-1"><strong class="text-white">MUCC-2017:</strong> Manual de Cadena de Custodia</li>
				</ul>
			</div>

			<!-- Columna 4: Ubicación y Contacto -->
			<div class="tablet:grid-col-3">
				<h4 class="font-sans-sm text-bold text-white text-uppercase margin-top-0 margin-bottom-1">Ubicación y Contacto</h4>
				<p class="font-sans-3xs text-base-light line-height-sans-2 margin-y-05">
					<strong>Sede:</strong> {CONTACT.address}
				</p>
				<p class="font-sans-3xs text-base-light line-height-sans-2 margin-y-05">
					<strong>WhatsApp / Teléfono:</strong>
					<a
						href={CONTACT.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white text-no-underline display-inline-flex flex-align-center margin-left-05 hover:underline"
						title="Enviar mensaje por WhatsApp"
					>
						<Icon name="whatsapp" size={14} fill="#25D366" class="margin-right-05" />
						<span class="text-bold">{CONTACT.phone.display}</span>
					</a>
				</p>
				<p class="font-sans-3xs text-base-light line-height-sans-2 margin-y-05">
					<strong>Email:</strong> <a href={`mailto:${CONTACT.email}`} class="text-white">{CONTACT.email}</a>
				</p>
				<div class="display-flex flex-wrap flex-align-center gap-1 margin-top-2">
					<a
						href={CONTACT.social.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="sha-social-btn sha-social-btn--wa"
						aria-label="WhatsApp"
						title={`WhatsApp: ${CONTACT.phone.display}`}
					>
						<Icon name="whatsapp" size={18} fill="#25D366" />
					</a>
					<a
						href={CONTACT.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="sha-social-btn sha-social-btn--in"
						aria-label="LinkedIn"
						title="LinkedIn: sha256.us"
					>
						<Icon name="linkedin" size={17} />
					</a>
					<a
						href={CONTACT.social.twitter}
						target="_blank"
						rel="noopener noreferrer"
						class="sha-social-btn sha-social-btn--x"
						aria-label="X (Twitter)"
						title="X (Twitter): @sha256us"
					>
						<Icon name="x" size={16} />
					</a>
					<a
						href={CONTACT.social.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="sha-social-btn sha-social-btn--ig"
						aria-label="Instagram"
						title="Instagram: @sha256.us"
					>
						<Icon name="instagram" size={18} />
					</a>
				</div>
			</div>
		</div>

		<!-- Línea Inferior -->
		<div class="border-top-1px border-base-dark padding-top-3 margin-top-4 display-flex flex-wrap flex-justify-between flex-align-center">
			<p class="font-sans-3xs text-base-light margin-0">
				&copy; {today.getFullYear()} <strong>sha256.us</strong>. Todos los derechos reservados.
			</p>
			<p class="font-sans-3xs text-base-light margin-0">
				Diseño construido bajo el estándar oficial <strong>USWDS (U.S. Web Design System)</strong>.
			</p>
		</div>
	</div>
</footer>

<style>
	.sha-social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background-color: rgba(255, 255, 255, 0.12);
		color: #ffffff !important;
		transition: all 0.2s ease;
		text-decoration: none;
	}
	.sha-social-btn:hover {
		transform: translateY(-2px);
		color: #ffffff !important;
	}
	.sha-social-btn--wa:hover {
		background-color: #25D366;
	}
	.sha-social-btn--in:hover {
		background-color: #0077b5;
	}
	.sha-social-btn--x:hover {
		background-color: #000000;
	}
	.sha-social-btn--ig:hover {
		background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
	}
</style>
