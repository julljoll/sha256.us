---
// USWDS: Footer & Identifier | https://designsystem.digital.gov/components/footer/ & https://designsystem.digital.gov/components/identifier/
import { COMPANY, CONTACT } from '../consts';
---

<!-- USWDS: Footer | https://designsystem.digital.gov/components/footer/ -->
<footer class="usa-footer">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#">Volver al inicio de la página</a>
  </div>
  <div class="usa-footer__primary-section">
    <nav class="usa-footer__nav" aria-label="Navegación del pie de página">
      <ul class="grid-row grid-gap">
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/">Inicio</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/servicios">Servicios Forenses</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/normativa">Marco Legal &amp; Proceso</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/normativa#planillas-folio">13 Planillas en Folio</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/blog">Blog &amp; Casos</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/about">Sobre Nosotros</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="/contacto">Contacto y Recepción</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2">
          <div class="mobile-lg:grid-col-auto">
            <img class="usa-footer__logo-img" src="/logo.png" alt="Logo oficial de sha256.us" />
          </div>
          <div class="mobile-lg:grid-col-auto">
            <p class="usa-footer__logo-heading">{COMPANY.name} — Laboratorio Forense Digital</p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.linkedin} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/linkedin.svg" alt="LinkedIn" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.twitter} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/x.svg" alt="X" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href={CONTACT.social.instagram} target="_blank" rel="noopener noreferrer">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/instagram.svg" alt="Instagram" />
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href="/rss.xml">
                <img class="usa-social-link__icon" src="/assets/uswds/img/usa-icons/rss_feed.svg" alt="RSS" />
              </a>
            </div>
          </div>
          <p class="usa-footer__contact-heading">Sede y Guardia Pericial</p>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer">
                  {CONTACT.phone.display}
                </a>
              </div>
              <div class="grid-col-auto">
                <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- USWDS: Identifier | https://designsystem.digital.gov/components/identifier/ -->
<div class="usa-identifier">
  <section
    class="usa-identifier__section usa-identifier__section--masthead"
    aria-label="Identificación institucional del laboratorio"
  >
    <div class="usa-identifier__container">
      <div class="usa-identifier__logos">
        <a href="/" class="usa-identifier__logo">
          <img
            class="usa-identifier__logo-img"
            src="/logo.png"
            alt="Logo de sha256.us"
            role="img"
          />
        </a>
      </div>
      <section
        class="usa-identifier__identity"
        aria-label="Entidad responsable"
      >
        <p class="usa-identifier__identity-domain">{COMPANY.name}</p>
        <p class="usa-identifier__identity-disclaimer">
          Un portal institucional oficial del <a href="/about">Laboratorio de Informática Forense y Peritaje Digital Judicial {COMPANY.name}</a>
        </p>
      </section>
    </div>
  </section>
  <nav
    class="usa-identifier__section usa-identifier__section--required-links"
    aria-label="Enlaces institucionales requeridos"
  >
    <div class="usa-identifier__container">
      <ul class="usa-identifier__required-links-list">
        <li class="usa-identifier__required-links-item">
          <a href="/about" class="usa-identifier__required-link usa-link">Sobre sha256.us</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/about#equipo" class="usa-identifier__required-link usa-link">Gabinete Pericial Acreditado</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/normativa" class="usa-identifier__required-link usa-link">Marco Legal &amp; Proceso (F0–F5)</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/normativa#planillas-folio" class="usa-identifier__required-link usa-link">13 Planillas en Folio</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/servicios#forense" class="usa-identifier__required-link usa-link">Dictámenes Judiciales</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/servicios#moviles" class="usa-identifier__required-link usa-link">Extracción Forense Móvil</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="https://forense.sha256.us/" target="_blank" rel="noopener noreferrer" class="usa-identifier__required-link usa-link">Sistema de Gestión Forense</a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/sitemap-index.xml" class="usa-identifier__required-link usa-link">Mapa del Sitio (XML)</a>
        </li>
      </ul>
    </div>
  </nav>
  <section
    class="usa-identifier__section usa-identifier__section--usagov"
    aria-label="Información de contacto y sede"
  >
    <div class="usa-identifier__container">
      <div class="usa-identifier__usagov-description">
        ¿Requieres asistencia pericial o evaluación preliminar de evidencia?
      </div>
      <a href="/contacto" class="usa-link">Solicitar Peritaje Forense</a>
    </div>
  </section>
</div>
