---
// USWDS: Footer Slim | https://designsystem.digital.gov/components/footer/
import { COMPANY, CONTACT } from '../consts';

const contactAndSocialLinks = [
  {
    href: CONTACT.whatsapp,
    icon: 'phone',
    label: `Teléfono / WhatsApp: ${CONTACT.phone.display}`,
    external: true,
  },
  {
    href: `mailto:${CONTACT.email}`,
    icon: 'mail',
    label: `Correo electrónico: ${CONTACT.email}`,
    external: false,
  },
  {
    href: CONTACT.social.linkedin,
    icon: 'linkedin',
    label: 'LinkedIn',
    external: true,
  },
  {
    href: CONTACT.social.twitter,
    icon: 'x',
    label: 'X (Twitter)',
    external: true,
  },
  {
    href: CONTACT.social.instagram,
    icon: 'instagram',
    label: 'Instagram',
    external: true,
  },
  {
    href: '/rss.xml',
    icon: 'rss_feed',
    label: 'RSS Feed',
    external: false,
  },
];
---

<!-- USWDS: Footer Slim | https://designsystem.digital.gov/components/footer/ -->
<footer class="usa-footer usa-footer--slim">
  <div class="grid-container usa-footer__return-to-top">
    <a href="/#inicio">Volver arriba</a>
  </div>
  <div class="usa-footer__secondary-section padding-y-4 border-top-1px border-base-lighter">
    <div class="grid-container">
      <div class="grid-row grid-gap flex-align-center">
        <div class="tablet:grid-col-7 desktop:grid-col-8">
          <div class="display-flex flex-align-center">
            <div class="flex-auto margin-right-2">
              <img
                class="width-6 height-6 display-block"
                src="/logo.png"
                alt="Logo oficial de sha256.us"
                width="48"
                height="48"
              />
            </div>
            <div class="display-flex flex-column flex-justify-center">
              <p class="font-sans-md tablet:font-sans-lg text-bold text-primary-darker line-height-sans-2 margin-0">
                {COMPANY.name} — Peritaje Informático de Móviles y Computadoras
              </p>
              <p class="font-sans-2xs text-base-darker line-height-sans-3 margin-top-05 margin-bottom-0">
                {CONTACT.address}
              </p>
            </div>
          </div>
        </div>
        <div class="tablet:grid-col-5 desktop:grid-col-4 margin-top-2 tablet:margin-top-0">
          <div class="usa-footer__social-links grid-row grid-gap-1 tablet:flex-justify-end flex-align-center">
            {contactAndSocialLinks.map((item) => (
              <div class="grid-col-auto">
                <a
                  class="usa-social-link radius-md"
                  href={item.href}
                  title={item.label}
                  aria-label={item.label}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <svg
                    class="usa-icon usa-social-link__icon width-full height-full display-block text-ink"
                    aria-hidden="true"
                    focusable="false"
                    role="img"
                  >
                    <use href={`/assets/uswds/img/sprite.svg#${item.icon}`}></use>
                  </svg>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
