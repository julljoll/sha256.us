---
import { SITE_URL } from '../consts';

interface Props {
	title: string;
	description?: string;
}

const { title, description = '' } = Astro.props;

// URL canónica del artículo actual
const currentUrl = new URL(Astro.url.pathname, Astro.site || SITE_URL).toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(title);

const shareLinks = {
	whatsapp: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title}\n${currentUrl}`)}`,
	twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}&via=sha256us`,
	linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
	facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
	email: `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(`Te comparto este artículo de sha256.us:\n\n${title}\n${currentUrl}`)}`,
};
---

<div class="sha-share-box bg-white padding-3 radius-lg shadow-1 border-1px border-base-lighter margin-top-4">
	<div class="display-flex flex-wrap flex-align-center flex-justify-between gap-2 margin-bottom-2">
		<div class="display-flex flex-align-center gap-1">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
				<circle cx="18" cy="5" r="3"></circle>
				<circle cx="6" cy="12" r="3"></circle>
				<circle cx="18" cy="19" r="3"></circle>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
				<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
			</svg>
			<span class="font-sans-xs text-bold text-primary-darker">Compartir este artículo:</span>
		</div>
		<span class="font-sans-3xs text-base">Difunde información técnica verificada</span>
	</div>

	<div class="sha-share-btn-group display-flex flex-wrap flex-align-center gap-1">
		<!-- WhatsApp -->
		<a
			href={shareLinks.whatsapp}
			target="_blank"
			rel="noopener noreferrer"
			class="sha-share-btn sha-share-btn--wa"
			aria-label="Compartir en WhatsApp"
			title="Compartir por WhatsApp"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
			</svg>
			<span>WhatsApp</span>
		</a>

		<!-- X (Twitter) -->
		<a
			href={shareLinks.twitter}
			target="_blank"
			rel="noopener noreferrer"
			class="sha-share-btn sha-share-btn--x"
			aria-label="Compartir en X (Twitter)"
			title="Compartir en X"
		>
			<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
			<span>X (Twitter)</span>
		</a>

		<!-- LinkedIn -->
		<a
			href={shareLinks.linkedin}
			target="_blank"
			rel="noopener noreferrer"
			class="sha-share-btn sha-share-btn--in"
			aria-label="Compartir en LinkedIn"
			title="Compartir en LinkedIn"
		>
			<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.69 1.69 0 1 0 0-3.38 1.69 1.69 0 0 0 0 3.38m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
			</svg>
			<span>LinkedIn</span>
		</a>

		<!-- Facebook -->
		<a
			href={shareLinks.facebook}
			target="_blank"
			rel="noopener noreferrer"
			class="sha-share-btn sha-share-btn--fb"
			aria-label="Compartir en Facebook"
			title="Compartir en Facebook"
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
			</svg>
			<span>Facebook</span>
		</a>

		<!-- Telegram -->
		<a
			href={shareLinks.telegram}
			target="_blank"
			rel="noopener noreferrer"
			class="sha-share-btn sha-share-btn--tg"
			aria-label="Compartir en Telegram"
			title="Compartir en Telegram"
		>
			<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
			</svg>
			<span>Telegram</span>
		</a>

		<!-- Botón de copiar enlace directo -->
		<button
			type="button"
			class="sha-share-btn sha-share-btn--copy"
			id="btnCopyShareUrl"
			data-url={currentUrl}
			aria-label="Copiar enlace"
			title="Copiar enlace al portapapeles"
		>
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
			<span id="copyShareText">Copiar Enlace</span>
		</button>
	</div>
</div>

<style>
	.sha-share-box {
		border-left: 4px solid #005ea2;
	}
	.sha-share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.85rem;
		border-radius: 4px;
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none !important;
		color: #ffffff !important;
		border: none;
		cursor: pointer;
		transition: transform 0.15s ease, opacity 0.2s ease;
		line-height: 1;
		touch-action: manipulation;
		min-height: 38px;
	}
	.sha-share-btn:hover {
		transform: translateY(-2px);
		opacity: 0.95;
	}
	.sha-share-btn--wa {
		background-color: #25d366;
	}
	.sha-share-btn--x {
		background-color: #000000;
	}
	.sha-share-btn--in {
		background-color: #0077b5;
	}
	.sha-share-btn--fb {
		background-color: #1877f2;
	}
	.sha-share-btn--tg {
		background-color: #229ed9;
	}
	.sha-share-btn--copy {
		background-color: #565c65;
		color: #ffffff;
	}
	.sha-share-btn--copy:hover {
		background-color: #1b1b1b;
	}

	@media (max-width: 640px) {
		.sha-share-btn-group {
			display: grid !important;
			grid-template-columns: repeat(2, 1fr) !important;
			gap: 0.65rem !important;
		}
		.sha-share-btn {
			justify-content: center !important;
			min-height: 44px !important; /* 44px touch target */
			font-size: 0.82rem !important;
			width: 100% !important;
			padding: 0.75rem 0.5rem !important;
		}
	}
</style>

<script>
	(function () {
		const btn = document.getElementById('btnCopyShareUrl');
		const label = document.getElementById('copyShareText');
		if (!btn || !label) return;

		btn.addEventListener('click', async () => {
			const url = btn.getAttribute('data-url') || window.location.href;
			try {
				if (navigator.clipboard) {
					await navigator.clipboard.writeText(url);
				} else {
					const input = document.createElement('input');
					input.value = url;
					document.body.appendChild(input);
					input.select();
					document.execCommand('copy');
					document.body.removeChild(input);
				}
				label.textContent = '¡Copiado!';
				setTimeout(() => {
					label.textContent = 'Copiar Enlace';
				}, 2500);
			} catch (e) {
				prompt('Copia este enlace:', url);
			}
		});
	})();
</script>
