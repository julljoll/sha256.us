---
// USWDS: Summary Box & Button Group | https://designsystem.digital.gov/components/button-group/
import { SITE_URL } from '../consts';

interface Props {
  title: string;
  description?: string;
}

const { title } = Astro.props;

const rawPath = Astro.url.pathname
  .replace(/\/index\.html$/i, '/')
  .replace(/\.html$/i, '');
const normalizedPath =
  rawPath === '/'
    ? '/'
    : rawPath.endsWith('/') || /\.[a-z0-9]+$/i.test(rawPath)
      ? rawPath
      : `${rawPath}/`;
const currentUrl = new URL(normalizedPath, Astro.site || SITE_URL).toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(title);

const shareLinks = {
  whatsapp: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title}\n${currentUrl}`)}`,
  twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}&via=sha256us`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
};
---

<!-- USWDS: Summary Box & Button Group | https://designsystem.digital.gov/components/summary-box/ -->
<div class="usa-summary-box margin-top-4" role="region" aria-label="Compartir este artículo">
  <div class="usa-summary-box__body">
    <h3 class="usa-summary-box__heading">Compartir este artículo:</h3>
    <div class="usa-summary-box__text">
      <p class="margin-top-0 margin-bottom-2">Difunde información técnica verificada</p>
      <ul class="usa-button-group flex-wrap">
        <li class="usa-button-group__item">
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="usa-button">
            WhatsApp
          </a>
        </li>
        <li class="usa-button-group__item">
          <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline">
            X (Twitter)
          </a>
        </li>
        <li class="usa-button-group__item">
          <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline">
            LinkedIn
          </a>
        </li>
        <li class="usa-button-group__item">
          <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline">
            Facebook
          </a>
        </li>
        <li class="usa-button-group__item">
          <a href={shareLinks.telegram} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline">
            Telegram
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
