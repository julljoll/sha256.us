---
// CookieBanner.astro - Banner de cookies conforme a RGPD / ePrivacy y normativa de protección de datos
import Icon from './atoms/Icon.astro';
---

<div id="cookieBanner" class="sha-cookie-banner" role="dialog" aria-live="polite" aria-label="Consentimiento de cookies" style="display: none;">
	<div class="sha-cookie-banner__inner">
		<div class="sha-cookie-banner__content">
			<div class="sha-cookie-banner__icon" aria-hidden="true">
				<Icon name="cookie" size={20} />
			</div>
			<div class="sha-cookie-banner__text">
				<p class="sha-cookie-banner__p">
					<strong>Privacidad & Cookies:</strong> Usamos cookies técnicas esenciales para garantizar la navegación segura, cifrado y funciones periciales del portal.
				</p>
			</div>
		</div>

		<div class="sha-cookie-banner__actions">
			<button type="button" class="usa-button sha-cookie-btn sha-cookie-btn--accept" id="btnAcceptCookies">
				Aceptar
			</button>
			<button type="button" class="usa-button sha-cookie-btn sha-cookie-btn--essential" id="btnEssentialCookies">
				Solo Necesarias
			</button>
		</div>
	</div>
</div>

<style>
	.sha-cookie-banner {
		position: fixed;
		bottom: 1.25rem;
		left: 1.25rem;
		right: 1.25rem;
		max-width: 1080px;
		margin: 0 auto;
		background: rgba(15, 29, 53, 0.98);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-left: 5px solid #005ea2;
		border-radius: 8px;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
		z-index: 9999;
		padding: 0.85rem 1.25rem;
		box-sizing: border-box !important;
		animation: slideUp 0.3s ease-out forwards;
	}

	@keyframes slideUp {
		from {
			transform: translateY(100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@keyframes slideDown {
		from {
			transform: translateY(0);
			opacity: 1;
		}
		to {
			transform: translateY(100%);
			opacity: 0;
		}
	}

	.sha-cookie-banner__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		box-sizing: border-box;
		width: 100%;
	}

	.sha-cookie-banner__content {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex: 1 1 240px;
		min-width: 0;
		box-sizing: border-box;
	}

	.sha-cookie-banner__icon {
		color: #69b4e9;
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}

	.sha-cookie-banner__text {
		flex: 1;
		min-width: 0;
	}

	.sha-cookie-banner__p {
		font-size: 0.82rem;
		line-height: 1.4;
		color: #ffffff;
		margin: 0;
		word-break: break-word;
	}

	.sha-cookie-banner__actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
		box-sizing: border-box;
	}

	.sha-cookie-btn {
		font-size: 0.78rem !important;
		padding: 0.45rem 0.95rem !important;
		min-height: 38px !important;
		border-radius: 4px !important;
		margin: 0 !important;
		font-weight: 700 !important;
		cursor: pointer;
		white-space: nowrap;
		touch-action: manipulation;
		box-sizing: border-box !important;
		display: inline-flex !important;
		align-items: center !important;
		justify-content: center !important;
	}

	.sha-cookie-btn--accept {
		background-color: #005ea2 !important;
		color: #ffffff !important;
		border: 1px solid #005ea2 !important;
	}
	.sha-cookie-btn--accept:hover {
		background-color: #0050a4 !important;
	}

	.sha-cookie-btn--essential {
		background-color: transparent !important;
		color: #ffffff !important;
		border: 1px solid rgba(255, 255, 255, 0.45) !important;
	}
	.sha-cookie-btn--essential:hover {
		background-color: rgba(255, 255, 255, 0.12) !important;
		border-color: #ffffff !important;
	}

	/* Móvil: formato bottom sheet 100% fluido y acoplado al pie de la pantalla */
	@media (max-width: 640px) {
		.sha-cookie-banner {
			bottom: 0 !important;
			left: 0 !important;
			right: 0 !important;
			width: 100% !important;
			max-width: 100vw !important;
			margin: 0 !important;
			border-radius: 14px 14px 0 0 !important;
			border-left: none !important;
			border-top: 3px solid #005ea2 !important;
			border-right: none !important;
			border-bottom: none !important;
			padding: 0.85rem 1rem calc(env(safe-area-inset-bottom, 0px) + 0.85rem) 1rem !important;
			box-sizing: border-box !important;
		}

		.sha-cookie-banner__inner {
			flex-direction: column;
			align-items: stretch;
			gap: 0.65rem;
		}

		.sha-cookie-banner__content {
			flex: initial;
			width: 100%;
		}

		.sha-cookie-banner__p {
			font-size: 0.76rem;
			line-height: 1.35;
		}

		.sha-cookie-banner__actions {
			width: 100%;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
		}

		.sha-cookie-btn {
			width: 100% !important;
			text-align: center;
			min-height: 40px !important;
			font-size: 0.78rem !important;
			padding: 0.45rem 0.5rem !important;
			white-space: normal !important;
		}
	}
</style>

<script>
	(function () {
		const banner = document.getElementById('cookieBanner');
		const btnAccept = document.getElementById('btnAcceptCookies');
		const btnEssential = document.getElementById('btnEssentialCookies');
		const COOKIE_KEY = 'sha256_cookie_consent';

		if (!banner) return;

		// Comprobar si ya existe consentimiento
		const consent = localStorage.getItem(COOKIE_KEY);
		if (!consent) {
			banner.style.display = 'block';
			document.body.classList.add('has-cookie-banner');
		}

		function saveConsent(value: string) {
			localStorage.setItem(COOKIE_KEY, value);
			document.body.classList.remove('has-cookie-banner');
			banner.style.animation = 'slideDown 0.25s ease-in forwards';
			setTimeout(() => {
				banner.style.display = 'none';
			}, 250);
		}

		btnAccept?.addEventListener('click', () => saveConsent('all'));
		btnEssential?.addEventListener('click', () => saveConsent('essential'));
	})();
</script>
