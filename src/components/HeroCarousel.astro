---
// HeroCarousel.astro - Componente Hero Institucional bajo estándar estricto USWDS 3.14 (.usa-hero)
// Cero efectos genéricos de IA (sin glassmorphism ni blur), 100% legible e intuitivo desde teléfonos móviles
import Icon from './atoms/Icon.astro';
import { HERO_SLIDES as slides } from '../consts';
---

<section class="usa-hero sha-carousel" id="heroCarousel" role="region" aria-label="Presentación del laboratorio sha256.us" aria-roledescription="carrusel">
  {slides.map((slide, i) => (
    <div
      class={`sha-carousel__slide${i === 0 ? ' is-active' : ''}`}
      id={`slide-${slide.id}`}
      role="group"
      aria-roledescription="slide"
      aria-label={`Diapositiva ${slide.id} de ${slides.length}: ${slide.tag}`}
      style={`background-image: url('${slide.img}');`}
    >
      <div class="sha-carousel__overlay"></div>

      <div class="sha-carousel__content">
        <div class="grid-container sha-carousel__inner">
          <!-- USWDS Official Hero Callout Box (.usa-hero__callout) -->
          <div class="usa-hero__callout sha-carousel__callout">
            <span class="usa-tag sha-carousel__tag">{slide.tag}</span>
            {i === 0 ? (
              <h1 class="usa-hero__heading sha-carousel__heading">{slide.title}</h1>
            ) : (
              <h2 class="usa-hero__heading sha-carousel__heading">{slide.title}</h2>
            )}
            <p class="sha-carousel__desc">{slide.desc}</p>
            <div class="sha-carousel__actions">
              <a href={slide.cta1.href} class="usa-button sha-btn-primary">{slide.cta1.label}</a>
              <a href={slide.cta2.href} class="usa-button usa-button--outline usa-button--inverse sha-btn-outline">{slide.cta2.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Controles Inferiores USWDS: Flechas e Indicadores -->
  <div class="sha-carousel__bar">
    <div class="grid-container sha-carousel__bar-inner">
      <button type="button" class="sha-carousel__btn" aria-label="Diapositiva anterior" id="carouselPrev">
        <Icon name="navigate_before" size={22} />
      </button>

      <div class="sha-carousel__dots" role="tablist" aria-label="Seleccionar diapositiva">
        {slides.map((slide, i) => (
          <button
            type="button"
            class={`sha-carousel__dot${i === 0 ? ' is-active' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Ir a diapositiva ${slide.id}`}
            data-index={i}
          ></button>
        ))}
      </div>

      <button type="button" class="sha-carousel__btn" aria-label="Diapositiva siguiente" id="carouselNext">
        <Icon name="navigate_next" size={22} />
      </button>
    </div>
  </div>
</section>

<style>
  .sha-carousel {
    position: relative;
    width: 100%;
    min-height: 480px;
    background-color: #162e51;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (min-width: 1024px) {
    .sha-carousel {
      min-height: 520px;
    }
  }

  .sha-carousel__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .sha-carousel__slide.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    flex: 1;
    padding: 2rem 0 1.5rem 0;
  }

  @media (max-width: 639px) {
    .sha-carousel__slide.is-active {
      padding: 1.25rem 0 1rem 0;
    }
  }

  .sha-carousel__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(17, 34, 57, 0.82);
  }

  .sha-carousel__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .sha-carousel__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* USWDS Official Solid Callout (#162e51) — Sin Blur ni Glassmorphism */
  .sha-carousel__callout {
    background-color: #162e51 !important;
    border: 1px solid #005ea2;
    border-left: 6px solid #005ea2;
    border-radius: 0.25rem;
    padding: 2rem;
    max-width: 600px;
    color: #ffffff;
  }

  @media (max-width: 639px) {
    .sha-carousel__callout {
      padding: 1.25rem 1.15rem;
      max-width: 100%;
    }
  }

  .sha-carousel__tag {
    background-color: #d83933 !important;
    color: #ffffff !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    margin-bottom: 0.75rem;
    display: inline-block;
    border-radius: 0.15rem;
  }

  .sha-carousel__heading {
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: #ffffff !important;
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
  }

  .sha-carousel__desc {
    font-size: 0.96rem;
    color: #f0f0f0;
    line-height: 1.55;
    margin: 0 0 1.35rem 0;
  }

  @media (max-width: 639px) {
    .sha-carousel__desc {
      font-size: 0.9rem;
      margin-bottom: 1.1rem;
    }
  }

  .sha-carousel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  @media (max-width: 480px) {
    .sha-carousel__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }
    .sha-carousel__actions .usa-button {
      width: 100% !important;
    }
  }

  .sha-btn-primary {
    background-color: #005ea2 !important;
    color: #ffffff !important;
    border: 2px solid #005ea2 !important;
  }
  .sha-btn-primary:hover {
    background-color: #1a4480 !important;
    border-color: #1a4480 !important;
  }

  .sha-btn-outline {
    background-color: transparent !important;
    color: #ffffff !important;
    border: 2px solid #ffffff !important;
  }
  .sha-btn-outline:hover {
    background-color: rgba(255, 255, 255, 0.15) !important;
  }

  /* Barra inferior de controles USWDS */
  .sha-carousel__bar {
    position: relative;
    z-index: 5;
    background-color: #112239;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 0;
  }

  .sha-carousel__bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .sha-carousel__btn {
    background: #162e51;
    border: 1px solid #73b3e7;
    color: #ffffff;
    width: 38px;
    height: 38px;
    border-radius: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
  }
  .sha-carousel__btn:hover {
    background: #005ea2;
    border-color: #ffffff;
  }

  .sha-carousel__dots {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sha-carousel__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: 2px solid #ffffff;
    padding: 0;
    cursor: pointer;
    position: relative;
  }
  .sha-carousel__dot::before {
    content: '';
    position: absolute;
    inset: -8px;
  }
  .sha-carousel__dot.is-active {
    background: #005ea2;
    border-color: #73b3e7;
  }
</style>

<script>
  (function () {
    const carousel = document.getElementById('heroCarousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.sha-carousel__slide');
    const dots = carousel.querySelectorAll('.sha-carousel__dot');
    const prevBtn = carousel.querySelector('#carouselPrev');
    const nextBtn = carousel.querySelector('#carouselNext');

    let current = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');
      (dots[current] as HTMLElement).setAttribute('aria-selected', 'false');

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('is-active');
      dots[current].classList.add('is-active');
      (dots[current] as HTMLElement).setAttribute('aria-selected', 'true');
    }

    function startAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => goTo(current + 1), 7000);
    }

    prevBtn?.addEventListener('click', () => { goTo(current - 1); startAuto(); });
    nextBtn?.addEventListener('click', () => { goTo(current + 1); startAuto(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); startAuto(); });
    });

    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const diff = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(diff) > 40) {
        goTo(diff < 0 ? current + 1 : current - 1);
        startAuto();
      }
    }, { passive: true });

    carousel.addEventListener('mouseenter', () => clearInterval(autoTimer));
    carousel.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>
