---
// HeroCarousel.astro
// 5 slides: Digital Forensics | Digital Contracts | Compliance Officer | Legal Data Analysis | Cybersecurity Lab
const slides = [
  {
    id: 1,
    img: "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=1400&q=80",
    tag: "LABORATORIO PERICIAL FORENSE",
    title: "Laboratorio de Informática Forense en Venezuela & Peritaje Judicial",
    desc: "Recuperamos, extraemos y certificamos evidencias digitales con cadena de custodia inviolable para juicios y tribunales.",
    cta1: { label: "Nuestros Servicios", href: "/servicios" },
    cta2: { label: "Solicitar Peritaje", href: "/contacto" },
  },
  {
    id: 2,
    img: "https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1400&q=80",
    tag: "CONTRATOS DIGITALES",
    title: "Análisis y Peritaje de Documentos Electrónicos",
    desc: "Verificación forense de contratos digitales, firmas electrónicas y metadatos de documentos con validez procesal ante tribunales.",
    cta1: { label: "Conocer el Proceso", href: "/servicios" },
    cta2: { label: "Contáctanos", href: "/contacto" },
  },
  {
    id: 3,
    img: "https://images.unsplash.com/photo-1551434678-e076c223a692?w=1400&q=80",
    tag: "COMPLIANCE OFFICER",
    title: "Soporte Técnico para Cumplimiento Normativo",
    desc: "Asesoramos a oficiales de cumplimiento con evidencias digitales bajo ISO/IEC 27037, ISO/IEC 27042, NIST SP 800 y MUCC-2017.",
    cta1: { label: "Ver Estándares", href: "/about" },
    cta2: { label: "Solicitar Asesoría", href: "/contacto" },
  },
  {
    id: 4,
    img: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1400&q=80",
    tag: "ANÁLISIS DE DATOS JURÍDICOS",
    title: "Validación Pericial de Datos e Información Legal",
    desc: "Aplicamos metodologías avanzadas para el análisis técnico-jurídico de registros, metadatos y trazas digitales en controversias corporativas.",
    cta1: { label: "Cómo Trabajamos", href: "/servicios" },
    cta2: { label: "Blog Técnico", href: "/blog" },
  },
  {
    id: 5,
    img: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1400&q=80",
    tag: "LABORATORIO FORENSE DIGITAL",
    title: "Tecnología de Punta para la Verdad Digital",
    desc: "Equipamiento especializado y protocolos de nivel internacional para la adquisición, preservación y análisis de medios digitales.",
    cta1: { label: "Conocer sha256.us", href: "/about" },
    cta2: { label: "Solicitar Recepción", href: "/contacto" },
  },
];
---

<div class="sha-carousel" id="heroCarousel" role="region" aria-label="Presentación del laboratorio sha256.us" aria-roledescription="carrusel">

  <!-- Slides -->
  {slides.map((slide, i) => (
    <div
      class={`sha-carousel__slide${i === 0 ? ' is-active' : ''}`}
      id={`slide-${slide.id}`}
      role="group"
      aria-roledescription="slide"
      aria-label={`Diapositiva ${slide.id} de ${slides.length}: ${slide.tag}`}
      style={`background-image: url('${slide.img}');`}
    >
      <!-- Dark overlay for readability -->
      <div class="sha-carousel__overlay"></div>

      <!-- Content -->
      <div class="sha-carousel__content">
        <div class="sha-carousel__inner">
          <div class="sha-carousel__callout">
            <span class="usa-tag sha-carousel__tag">{slide.tag}</span>
            {i === 0 ? (
              <h1 class="sha-carousel__heading">{slide.title}</h1>
            ) : (
              <h2 class="sha-carousel__heading">{slide.title}</h2>
            )}
            <p class="sha-carousel__desc">{slide.desc}</p>
            <div class="sha-carousel__actions">
              <a href={slide.cta1.href} class="usa-button sha-btn-primary">{slide.cta1.label}</a>
              <a href={slide.cta2.href} class="usa-button sha-btn-outline">{slide.cta2.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Navigation Arrows -->
  <button class="sha-carousel__btn sha-carousel__btn--prev" aria-label="Diapositiva anterior" id="carouselPrev">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button class="sha-carousel__btn sha-carousel__btn--next" aria-label="Diapositiva siguiente" id="carouselNext">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <!-- Controls Container: Dot Indicators & Counter -->
  <div class="sha-carousel__controls">
    <div class="sha-carousel__dots" role="tablist" aria-label="Seleccionar diapositiva">
      {slides.map((slide, i) => (
        <button
          class={`sha-carousel__dot${i === 0 ? ' is-active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Ir a diapositiva ${slide.id}`}
          data-index={i}
        ></button>
      ))}
    </div>

    <!-- Slide Counter -->
    <div class="sha-carousel__counter" aria-live="polite" aria-atomic="true">
      <span id="currentSlide">1</span> / {slides.length}
    </div>
  </div>
</div>

<style>
  /* ==================== CAROUSEL CORE ==================== */
  .sha-carousel {
    position: relative;
    width: 100%;
    height: 540px;
    overflow: hidden;
    background: #1a2b4b;
    touch-action: pan-y pinch-zoom;
  }

  @media (max-width: 640px) {
    .sha-carousel {
      height: auto;
      min-height: 510px;
    }
  }
  @media (min-width: 1024px) {
    .sha-carousel { height: 600px; }
  }

  /* Slides */
  .sha-carousel__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.7s ease-in-out;
    pointer-events: none;
  }
  .sha-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Dark overlay with left-focused gradient for high contrast */
  .sha-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 20, 42, 0.95) 0%,
      rgba(8, 20, 42, 0.82) 45%,
      rgba(8, 20, 42, 0.45) 100%
    );
  }

  @media (max-width: 640px) {
    .sha-carousel__overlay {
      background: rgba(8, 20, 42, 0.92); /* Solid contrast on small screens */
    }
  }

  /* Content container */
  .sha-carousel__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    z-index: 5;
    pointer-events: none;
  }

  .sha-carousel__inner {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 5rem;
    padding-right: 5rem;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  @media (max-width: 768px) {
    .sha-carousel__inner {
      padding-left: 3.5rem;
      padding-right: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .sha-carousel__inner {
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 1rem;
      padding-bottom: 3.5rem;
    }
  }

  /* Callout CTA Card - Left aligned */
  .sha-carousel__callout {
    pointer-events: auto;
    text-align: left;
    max-width: 560px;
    background: rgba(15, 29, 53, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 2.25rem 2.5rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 5px solid #005ea2;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 640px) {
    .sha-carousel__callout {
      padding: 1.25rem 1.15rem;
      max-width: 100%;
      background: rgba(15, 29, 53, 0.95);
      border-radius: 6px;
    }
  }

  /* Tag */
  .sha-carousel__tag {
    background-color: #d83933 !important;
    color: #fff !important;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    margin-bottom: 0.85rem;
    display: inline-block;
    align-self: flex-start;
    border-radius: 2px;
  }

  /* Heading */
  .sha-carousel__heading {
    font-size: clamp(1.4rem, 3.2vw, 2.35rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0 0 0.85rem 0;
    text-align: left;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  /* Description */
  .sha-carousel__desc {
    font-size: clamp(0.88rem, 1.4vw, 1rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    text-align: left;
    max-width: 480px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }

  /* CTA Actions */
  .sha-carousel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
  }

  @media (max-width: 480px) {
    .sha-carousel__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
    }
  }

  /* Primary CTA Button */
  .sha-btn-primary {
    background-color: #005ea2 !important;
    color: #fff !important;
    border: 2px solid #005ea2 !important;
    font-weight: 700;
    padding: 0.75rem 1.35rem;
    transition: background-color 0.2s, transform 0.15s;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    box-sizing: border-box;
    text-align: center;
  }
  .sha-btn-primary:hover {
    background-color: #0050a4 !important;
    transform: translateY(-1px);
  }

  /* Outline CTA Button */
  .sha-btn-outline {
    background-color: transparent !important;
    color: #fff !important;
    border: 2px solid rgba(255,255,255,0.85) !important;
    font-weight: 700;
    padding: 0.75rem 1.35rem;
    transition: background-color 0.2s, border-color 0.2s, transform 0.15s;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    box-sizing: border-box;
    text-align: center;
  }
  .sha-btn-outline:hover {
    background-color: rgba(255,255,255,0.12) !important;
    border-color: #fff !important;
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .sha-btn-primary, .sha-btn-outline {
      width: 100% !important;
      padding: 0.85rem 1rem !important;
    }
  }

  /* ==================== NAVIGATION ARROWS ==================== */
  .sha-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0,36,80,0.65);
    border: 2px solid rgba(255,255,255,0.35);
    color: #fff;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    border-radius: 4px;
    touch-action: manipulation;
  }
  .sha-carousel__btn:hover {
    background: rgba(0,94,162,0.9);
    border-color: rgba(255,255,255,0.8);
  }
  .sha-carousel__btn--prev { left: 1rem; }
  .sha-carousel__btn--next { right: 1rem; }

  /* In mobile: Move navigation arrows to bottom bar so they NEVER overlap the callout text */
  @media (max-width: 640px) {
    .sha-carousel__btn {
      top: auto;
      bottom: 0.65rem;
      transform: none;
      width: 36px;
      height: 36px;
      background: rgba(0, 36, 80, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.35);
    }
    .sha-carousel__btn--prev { left: 0.75rem; }
    .sha-carousel__btn--next { right: 0.75rem; }
  }

  /* ==================== CONTROLS (DOTS + COUNTER) ==================== */
  .sha-carousel__controls {
    position: absolute;
    bottom: 1.25rem;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .sha-carousel__controls {
      bottom: 0.85rem;
    }
  }

  .sha-carousel__dots {
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
  }

  .sha-carousel__dot {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.45);
    border: 2px solid rgba(255,255,255,0.7);
    cursor: pointer;
    transition: background 0.25s, transform 0.2s;
    padding: 0;
    touch-action: manipulation;
  }
  /* Expand tap target for thumbs */
  .sha-carousel__dot::before {
    content: '';
    position: absolute;
    inset: -10px;
  }
  .sha-carousel__dot.is-active {
    background: #fff;
    transform: scale(1.25);
    border-color: #fff;
  }
  .sha-carousel__dot:hover { background: rgba(255,255,255,0.85); }

  /* ==================== SLIDE COUNTER ==================== */
  .sha-carousel__counter {
    position: absolute;
    right: 1.25rem;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.75);
    font-weight: 600;
    letter-spacing: 0.05em;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .sha-carousel__counter {
      display: none; /* In mobile, dots + arrows are sufficient */
    }
  }
</style>

<script>
  (function () {
    const carousel = document.getElementById('heroCarousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.sha-carousel__slide');
    const dots = carousel.querySelectorAll('.sha-carousel__dot');
    const counter = carousel.querySelector('#currentSlide');
    const prevBtn = carousel.querySelector('#carouselPrev');
    const nextBtn = carousel.querySelector('#carouselNext');

    let current = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');
      (dots[current] as HTMLElement).setAttribute('aria-selected', 'false');

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('is-active');
      dots[current].classList.add('is-active');
      (dots[current] as HTMLElement).setAttribute('aria-selected', 'true');
      if (counter) counter.textContent = String(current + 1);
    }

    function startAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => goTo(current + 1), 6000);
    }

    prevBtn?.addEventListener('click', () => { goTo(current - 1); startAuto(); });
    nextBtn?.addEventListener('click', () => { goTo(current + 1); startAuto(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); startAuto(); });
    });

    // Touch Swipe Gestures for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goTo(current + 1); // Swipe left -> next
        } else {
          goTo(current - 1); // Swipe right -> prev
        }
        startAuto();
      }
    }, { passive: true });

    // Keyboard Navigation
    carousel.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'ArrowLeft') { goTo(current - 1); startAuto(); }
      if (ke.key === 'ArrowRight') { goTo(current + 1); startAuto(); }
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', () => clearInterval(autoTimer));
    carousel.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>
