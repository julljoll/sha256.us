---
// USWDS: Page Template Skeleton | https://designsystem.digital.gov/page-templates/
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LanguageTranslator from '../components/LanguageTranslator.astro';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	section?: string;
	tags?: string[];
	mainClass?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	image,
	type = 'website',
	pubDate,
	updatedDate,
	author,
	section,
	tags,
	mainClass = '',
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			pubDate={pubDate}
			updatedDate={updatedDate}
			author={author}
			section={section}
			tags={tags}
			noindex={noindex}
		/>
	</head>
	<body>
		<!-- USWDS: Skipnav | https://designsystem.digital.gov/components/skipnav/ -->
		<a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>
		<div class="usa-overlay"></div>
		<Header />
		<main id="main-content" class={mainClass || undefined}>
			<slot />
		</main>
		<Footer />
		<LanguageTranslator />
		<script is:inline defer src="/assets/uswds/js/uswds.min.js"></script>
	</body>
</html>
