---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import { COMPANY } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author, category, tags } = Astro.props;
---

<!-- USWDS: Prose & Documentation template | https://designsystem.digital.gov/components/prose/ -->
<BaseLayout
	title={`${title} | ${COMPANY.name}`}
	description={description}
	image={heroImage}
	type="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	author={author || 'Equipo Pericial sha256.us'}
	section={category || 'Informática Forense'}
	tags={tags || []}
	mainClass="padding-y-4 tablet:padding-y-6"
>
	<article class="grid-container">
		<Breadcrumb
			items={[
				{ label: 'Blog & Casos', href: '/blog/' },
				{ label: category || 'Publicación' },
			]}
		/>

		<header class="margin-bottom-4 border-bottom-1px border-base-lighter padding-bottom-3">
			<div class="display-flex flex-wrap flex-align-center margin-bottom-1">
				{category ? (
					<span class="usa-tag bg-primary-dark text-white text-uppercase font-sans-3xs margin-right-05 margin-bottom-05">{category}</span>
				) : (
					<span class="usa-tag bg-primary-dark text-white font-sans-3xs margin-right-05 margin-bottom-05">Informática Forense</span>
				)}
				{tags && tags.slice(0, 3).map((tag: string) => (
					<span class="usa-tag bg-secondary-dark text-white font-mono-3xs margin-right-05 margin-bottom-05">#{tag}</span>
				))}
			</div>

			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker line-height-sans-2 margin-top-1 margin-bottom-2">
				{title}
			</h1>

			<p class="font-sans-md text-base-dark line-height-sans-3 measure-6 margin-top-0 margin-bottom-2">
				{description}
			</p>

			<div class="font-sans-xs text-base-dark display-flex flex-wrap flex-align-center">
				<span class="margin-right-2">Publicado: <FormattedDate date={pubDate} /></span>
				{updatedDate && (
					<span class="text-italic text-base-dark margin-right-2">
						(Actualizado: <FormattedDate date={updatedDate} />)
					</span>
				)}
				<span class="text-base-dark">&bull; Por {author || 'Equipo Pericial sha256.us'}</span>
			</div>
		</header>

		{heroImage && (
			<div class="margin-bottom-4 tablet:margin-bottom-5 radius-lg overflow-hidden shadow-2">
				<Image width={1200} height={560} src={heroImage} alt={title} class="width-full height-auto display-block" />
			</div>
		)}

		<div class="usa-prose font-sans-md line-height-sans-4 text-base-darkest bg-white padding-3 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter">
			<slot />
		</div>

		<ShareButtons title={title} description={description} />

		<div class="bg-white padding-4 radius-lg shadow-1 border-left-1 border-primary margin-top-4">
			<div class="grid-row grid-gap flex-align-center">
				<div class="tablet:grid-col-8">
					<span class="font-sans-3xs text-bold text-primary text-uppercase">AUTORIDAD Y PERITAJE FORENSE</span>
					<h3 class="font-sans-md text-bold text-primary-darker margin-top-0 margin-bottom-1">
						{COMPANY.name} &bull; Gabinete Forense Multidisciplinario
					</h3>
					<p class="font-sans-xs text-base-dark line-height-sans-3 margin-0">
						Especialistas en análisis forense de teléfonos móviles, conversaciones de WhatsApp, computadoras, recuperación de datos e informes periciales para juicios.
					</p>
				</div>
				<div class="tablet:grid-col-4 display-flex flex-column margin-top-3 tablet:margin-top-0">
					<a href="/#contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink font-sans-xs width-full text-center margin-bottom-1">
						<span class="text-ink text-bold">Solicitar Dictamen Pericial</span>
					</a>
					<a href="/#nosotros" class="usa-button usa-button--outline font-sans-xs width-full text-center">
						Conocer al Equipo Pericial &rarr;
					</a>
				</div>
			</div>
		</div>
	</article>
</BaseLayout>
