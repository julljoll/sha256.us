---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import TrustBar from '../components/organisms/TrustBar.astro';
import HomeServices from '../components/organisms/HomeServices.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
import TeamBacking from '../components/organisms/TeamBacking.astro';
import StandardsSection from '../components/organisms/StandardsSection.astro';
import LatestPosts from '../components/organisms/LatestPosts.astro';
import CtaBanner from '../components/organisms/CtaBanner.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- ======= HERO CAROUSEL ======= -->
	<HeroCarousel />

	<!-- ======= TRUST BAR ======= -->
	<TrustBar />

	<!-- ======= SERVICES ======= -->
	<HomeServices />

	<!-- ======= PROCESS STEPS ======= -->
	<ProcessSteps />

	<!-- ======= EQUIPO PERICIAL & RESPALDO INSTITUCIONAL ======= -->
	<TeamBacking />

	<!-- ======= STANDARDS ======= -->
	<StandardsSection />

	<!-- ======= LATEST POSTS ======= -->
	<LatestPosts posts={latestPosts} />

	<!-- ======= CTA CONTACT BANNER ======= -->
	<CtaBanner />
</BaseLayout>
