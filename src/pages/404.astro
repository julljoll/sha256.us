---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, SITE_TITLE } from '../consts';
---

<!-- USWDS: Section & Button group | https://designsystem.digital.gov/components/button-group/ -->
<BaseLayout
	title={`Página no encontrada (404) | ${SITE_TITLE}`}
	description="La página solicitada no existe o ha sido reubicada dentro del portal de sha256.us."
	mainClass="padding-y-8"
>
	<div class="grid-container text-center">
		<div class="bg-white padding-5 tablet:padding-7 radius-lg shadow-2 border-top-1 border-primary maxw-tablet margin-x-auto">
			<span class="font-mono-2xl text-bold text-primary display-block margin-bottom-1">
				404
			</span>
			<h1 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-2">
				Registro o recurso no localizado
			</h1>
			<p class="font-sans-sm text-base-dark line-height-sans-4 margin-bottom-4">
				La ruta digital a la que intentas acceder no coincide con ningún registro pericial o publicación activa en el portal de <strong>{COMPANY.name}</strong>.
			</p>

			<ul class="usa-button-group flex-wrap flex-justify-center">
				<li class="usa-button-group__item">
					<a href="/" class="usa-button">Volver al Inicio</a>
				</li>
				<li class="usa-button-group__item">
					<a href="/#servicios" class="usa-button usa-button--outline">Servicios Forenses</a>
				</li>
				<li class="usa-button-group__item">
					<a href="/blog" class="usa-button usa-button--outline">Blog &amp; Casos</a>
				</li>
				<li class="usa-button-group__item">
					<a href="/#contacto" class="usa-button bg-gold hover:bg-warning-dark text-ink">
						<span class="text-ink text-bold">Contactar Perito</span>
					</a>
				</li>
			</ul>
		</div>
	</div>
</BaseLayout>
