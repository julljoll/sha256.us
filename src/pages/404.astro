---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Página no encontrada (404) | ${SITE_TITLE}`}
	description="La página solicitada no existe o ha sido reubicada dentro del portal de sha256.us."
	mainClass="padding-y-8"
>
	<div class="grid-container maxw-tablet margin-x-auto padding-x-2 text-center">
		<div class="bg-white padding-5 tablet:padding-7 radius-lg shadow-2 border-top-1 border-primary">
			<span class="font-mono text-bold text-primary font-sans-3xl display-block margin-bottom-1">
				404
			</span>
			<h1 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-2">
				Registro o recurso no localizado
			</h1>
			<p class="font-sans-sm text-base-dark line-height-sans-4 margin-bottom-4">
				La ruta digital a la que intentas acceder no coincide con ningún registro pericial o publicación activa en el portal de <strong>{COMPANY.name}</strong>.
			</p>

			<div class="display-flex flex-wrap flex-justify-center gap-2">
				<a href="/" class="usa-button usa-button--primary">Volver al Inicio</a>
				<a href="/servicios" class="usa-button usa-button--outline">Servicios Forenses</a>
				<a href="/blog" class="usa-button usa-button--outline">Blog & Casos</a>
				<a href="/contacto" class="usa-button usa-button--secondary">Contactar Perito</a>
			</div>
		</div>
	</div>
</BaseLayout>

