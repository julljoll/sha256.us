---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, CONTACT, FOUNDER, SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Contacto y Ubicación | ${SITE_TITLE}`}
	description={`Canales de atención pericial de ${COMPANY.name}. Dirección pericial a cargo de ${FOUNDER.name} (${FOUNDER.handle}). Sede principal en Quíbor, Lara, Venezuela.`}
	mainClass="padding-y-6"
>
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
		<!-- Header de página -->
		<div class="margin-bottom-6 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1">CANALES DE ATENCIÓN</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Contáctanos — Laboratorio {COMPANY.name}
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet">
				Estamos a tu disposición para atender consultas técnicas, recibir dispositivos por consignación pericial y coordinar informes para tribunales.
			</p>
		</div>

		<div class="grid-row grid-gap margin-bottom-8">
			<!-- Formulario de Contacto Funcional -->
			<div class="tablet:grid-col-7 margin-bottom-4 tablet:margin-bottom-0">
				<div class="bg-white padding-4 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter">
					<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-2">
						Envíanos un mensaje sobre tu caso
					</h2>
					<p class="font-sans-xs text-base-dark margin-bottom-4">
						Completa los datos del requerimiento para canalizarlo de inmediato con el equipo pericial a través de WhatsApp o Correo Institucional.
					</p>

					<form class="usa-form maxw-full" id="contactForm">
						<label class="usa-label font-sans-xs text-bold" for="nombre">Nombre Completo o Razón Social</label>
						<input class="usa-input width-full" id="nombre" name="nombre" type="text" required />

						<label class="usa-label font-sans-xs text-bold margin-top-2" for="email">Correo Electrónico</label>
						<input class="usa-input width-full" id="email" name="email" type="email" required />

						<label class="usa-label font-sans-xs text-bold margin-top-2" for="telefono">Teléfono / WhatsApp</label>
						<input class="usa-input width-full" id="telefono" name="telefono" type="tel" placeholder="+57 316 3931945" />

						<label class="usa-label font-sans-xs text-bold margin-top-2" for="servicio">Tipo de Evidencia o Servicio</label>
						<select class="usa-select width-full" id="servicio" name="servicio">
							<option value="Peritaje Judicial de Informática Forense">Peritaje Judicial de Informática Forense</option>
							<option value="Peritaje de Dispositivo Móvil (WhatsApp, Audios, etc.)">Peritaje de Dispositivo Móvil (WhatsApp, Audios, etc.)</option>
							<option value="Reparación / Extracción de Disco o Servidor">Reparación / Extracción de Disco o Servidor</option>
							<option value="Auditoría de Contratos Digitales o Correos">Auditoría de Contratos Digitales o Correos</option>
							<option value="Otra consulta pericial">Otra consulta pericial</option>
						</select>

						<label class="usa-label font-sans-xs text-bold margin-top-2" for="mensaje">Detalles del caso o evidencia</label>
						<textarea class="usa-textarea width-full" id="mensaje" name="mensaje" rows="4" required placeholder="Describe brevemente la situación, urgencia o estado del medio digital..."></textarea>

						<div class="display-flex flex-wrap gap-2 margin-top-3">
							<button class="usa-button usa-button--primary" type="button" id="btnWhatsapp">
								Enviar por WhatsApp &rarr;
							</button>
							<button class="usa-button usa-button--outline" type="button" id="btnEmail">
								Enviar por Email &rarr;
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Datos de Contacto y Ubicación -->
			<div class="tablet:grid-col-5">
				<div class="bg-white padding-4 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter height-full display-flex flex-column">
					<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-3">
						Información Oficial
					</h2>

					<!-- Respaldo del Especialista Líder -->
					<div class="bg-primary-lighter padding-3 radius-md border-left-05 border-primary margin-bottom-3">
						<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Dirección Técnica</span>
						<p class="font-sans-xs text-primary-darker text-bold margin-0">
							{FOUNDER.name} — <a href={FOUNDER.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{FOUNDER.handle}</a>
						</p>
						<p class="font-sans-3xs text-base-dark margin-top-05 margin-bottom-0">
							{FOUNDER.role}
						</p>
					</div>

					<div class="margin-bottom-3">
						<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Sede Principal</span>
						<p class="font-sans-xs text-base-dark line-height-sans-3 margin-0">
							{CONTACT.address}
						</p>
					</div>

					<div class="margin-bottom-3">
						<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">WhatsApp / Teléfono</span>
						<p class="font-sans-md text-base-dark margin-y-05">
							<a
								href={CONTACT.whatsapp}
								target="_blank"
								rel="noopener noreferrer"
								class="display-inline-flex flex-align-center text-bold text-no-underline hover:underline text-primary-darker"
								title="Contactar vía WhatsApp"
							>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true" style="vertical-align:middle;margin-right:6px">
									<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
								</svg>
								<span>{CONTACT.phone.display}</span>
							</a>
						</p>
					</div>

					<div class="margin-bottom-3">
						<span class="font-sans-3xs text-uppercase text-bold text-primary display-block margin-bottom-05">Correo Electrónico</span>
						<p class="font-sans-sm text-base-dark margin-0">
							<a href={`mailto:${CONTACT.email}`} class="usa-link text-bold">{CONTACT.email}</a>
						</p>
					</div>

					<div class="margin-top-auto border-top-1px border-base-lighter padding-top-3">
						<span class="font-sans-3xs text-uppercase text-bold text-base display-block margin-bottom-1">Canales Profesionales</span>
						<div class="display-flex flex-wrap gap-1">
							<a
								href={FOUNDER.url}
								target="_blank"
								rel="noopener noreferrer"
								class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
							>
								{FOUNDER.handle}
							</a>
							<a
								href={CONTACT.social.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
							>
								LinkedIn
							</a>
							<a
								href={CONTACT.social.twitter}
								target="_blank"
								rel="noopener noreferrer"
								class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 margin-0"
							>
								X / Twitter
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	(function () {
		const form = document.getElementById('contactForm') as HTMLFormElement;
		const btnWhatsapp = document.getElementById('btnWhatsapp');
		const btnEmail = document.getElementById('btnEmail');

		function getFormData() {
			const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value.trim();
			const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
			const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value.trim();
			const servicio = (document.getElementById('servicio') as HTMLSelectElement)?.value;
			const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value.trim();

			if (!nombre || !email || !mensaje) {
				alert('Por favor completa al menos Nombre, Correo Electrónico y el Mensaje.');
				return null;
			}

			return { nombre, email, telefono, servicio, mensaje };
		}

		btnWhatsapp?.addEventListener('click', () => {
			const data = getFormData();
			if (!data) return;

			const text =
				`*Solicitud de Peritaje en sha256.us*\n\n` +
				`*Nombre:* ${data.nombre}\n` +
				`*Correo:* ${data.email}\n` +
				`*Teléfono:* ${data.telefono || 'No indicado'}\n` +
				`*Servicio Requerido:* ${data.servicio}\n\n` +
				`*Detalles del caso:*\n${data.mensaje}`;

			const waUrl = `https://wa.me/573163931945?text=${encodeURIComponent(text)}`;
			window.open(waUrl, '_blank');
		});

		btnEmail?.addEventListener('click', () => {
			const data = getFormData();
			if (!data) return;

			const subject = encodeURIComponent(`[Peritaje sha256.us] ${data.servicio} - ${data.nombre}`);
			const body = encodeURIComponent(
				`Nombre: ${data.nombre}\n` +
				`Correo: ${data.email}\n` +
				`Teléfono: ${data.telefono || 'No indicado'}\n` +
				`Servicio: ${data.servicio}\n\n` +
				`Detalles del caso:\n${data.mensaje}`
			);

			window.location.href = `mailto:soporte@sha256.us?subject=${subject}&body=${body}`;
		});
	})();
</script>
