---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, SITE_TITLE } from '../consts';
import ContactDirectWa from '../components/organisms/ContactDirectWa.astro';
import ContactForm from '../components/organisms/ContactForm.astro';
import ContactInfoSidebar from '../components/organisms/ContactInfoSidebar.astro';
---

<BaseLayout
	title={`Contacto y Ubicación | ${SITE_TITLE}`}
	description={`Canales de atención pericial de ${COMPANY.name}. Equipo forense multidisciplinario en Quíbor, Lara, Venezuela. Peritajes judiciales, extracciones móviles y cadena de custodia oficial.`}
	mainClass="padding-y-5 tablet:padding-y-6"
>
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
		<!-- Header de página -->
		<div class="margin-bottom-4 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">CANALES DE ATENCIÓN</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Contáctanos — Laboratorio {COMPANY.name}
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet margin-bottom-0">
				Estamos a tu disposición para atender consultas técnicas preliminares, recibir dispositivos por consignación pericial y coordinar informes para tribunales.
			</p>
		</div>

		<!-- Opción Rápida en 1 Toque (Pensada para usuarios no técnicos y móviles) -->
		<ContactDirectWa />

		<div class="grid-row grid-gap margin-bottom-8">
			<!-- Formulario de Contacto Funcional -->
			<div class="tablet:grid-col-7 margin-bottom-4 tablet:margin-bottom-0">
				<ContactForm />
			</div>

			<!-- Datos de Contacto y Ubicación -->
			<div class="tablet:grid-col-5">
				<ContactInfoSidebar />
			</div>
		</div>
	</div>
</BaseLayout>
