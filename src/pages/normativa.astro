---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, FORENSE_PORTAL_URL, LEGAL_INSTRUMENTS, FOLIO_FORMS_CATALOG, ISO_FORENSIC_PHASES } from '../consts';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import PillNav, { type PillItem } from '../components/molecules/PillNav.astro';
import LegalPyramidSection from '../components/organisms/LegalPyramidSection.astro';
import LegalCompendiumSection from '../components/organisms/LegalCompendiumSection.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
import FolioFormsSection from '../components/organisms/FolioFormsSection.astro';
import CtaBanner from '../components/organisms/CtaBanner.astro';

const normativaPills: PillItem[] = [
	{ href: '#piramide-legal', label: 'Pirámide COPP Art. 225', iconName: 'account_balance' },
	{ href: '#compendio', label: `Leyes e ISO (${LEGAL_INSTRUMENTS.length})`, iconName: 'gavel' },
	{ href: '#ciclo-f0-f5', label: `Ciclo ISO (${ISO_FORENSIC_PHASES.length} Fases)`, iconName: 'verified_user' },
	{ href: '#planillas-folio', label: `Planillas Folio (${FOLIO_FORMS_CATALOG.length})`, iconName: 'description' },
];
---

<!-- USWDS: Layout grid & Documentation template | https://designsystem.digital.gov/templates/documentation-page/ -->
<BaseLayout
	title={`Marco Legal, Leyes Informáticas y Ciclo Pericial ISO F0–F5 | ${COMPANY.name}`}
	description={`Sustento jurídico y técnico del laboratorio sha256.us y forense.sha256.us: Pirámide de Aplicación (COPP Art. 225), LMDFE, LEDI, MUCC-2017, ISO/IEC 27037, ISO/IEC 27042, NIST SP 800 y 13 Planillas Oficiales en Folio.`}
	mainClass="padding-top-4 tablet:padding-top-6"
>
	<div class="grid-container">
		<Breadcrumb items={[{ label: 'Marco Legal & Proceso Forense (F0–F5)' }]} />

		<div class="margin-bottom-4 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">
				FORENSIC CHIEF COMPLIANCE OFFICER · SUSTENTO NORMATIVO /Informatica/
			</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Marco Legal de Leyes Informáticas, Ciclo Pericial ISO (F0–F5) y Planillas en Folio
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 measure-6 margin-bottom-3">
				Toda actuación técnica del laboratorio <strong>{COMPANY.name}</strong> y de nuestra plataforma operativa <a href={FORENSE_PORTAL_URL} target="_blank" rel="noopener noreferrer" class="usa-link text-bold">forense.sha256.us</a> se encuentra respaldada por el compendio de leyes informáticas venezolanas y estándares internacionales resguardados con verificación criptográfica <strong>SHA-256</strong> en nuestro repositorio normativo.
			</p>

			<div class="bg-primary-darker text-white padding-3 radius-md border-left-05 border-primary margin-bottom-3">
				<div class="grid-row grid-gap">
					<div class="grid-col-6 tablet:grid-col-3 margin-bottom-2 tablet:margin-bottom-0">
						<span class="display-block font-mono-lg text-bold text-accent-cool">6 Fases</span>
						<span class="display-block font-sans-2xs text-base-lightest">Ciclo ISO (F0 a F5)</span>
					</div>
					<div class="grid-col-6 tablet:grid-col-3 margin-bottom-2 tablet:margin-bottom-0">
						<span class="display-block font-mono-lg text-bold text-accent-cool">13 Actas</span>
						<span class="display-block font-sans-2xs text-base-lightest">Formato Folio (216×330 mm)</span>
					</div>
					<div class="grid-col-6 tablet:grid-col-3">
						<span class="display-block font-mono-lg text-bold text-accent-cool">28 Normas</span>
						<span class="display-block font-sans-2xs text-base-lightest">Carpeta /Informatica/ SHA-256</span>
					</div>
					<div class="grid-col-6 tablet:grid-col-3">
						<span class="display-block font-mono-lg text-bold text-accent-cool">Art. 187</span>
						<span class="display-block font-sans-2xs text-base-lightest">COPP &amp; MUCC-2017 (PRCC)</span>
					</div>
				</div>
			</div>

			<PillNav items={normativaPills} />
		</div>
	</div>

	<LegalPyramidSection />
	<LegalCompendiumSection />
	<ProcessSteps detailed={true} id="ciclo-f0-f5" />
	<FolioFormsSection id="planillas-folio" />

	<CtaBanner
		title="¿Necesitas sustentar una prueba digital con validez procesal plena?"
		sub="Nuestro gabinete pericial aplica el Ciclo ISO F0–F5 y emite las Planillas Oficiales en Folio listas para su consignación ante tribunales."
		buttonText="Solicitar Peritaje Forense"
		buttonHref="/contacto"
	/>
</BaseLayout>
