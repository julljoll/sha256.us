---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../consts';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
import StandardsSection from '../components/organisms/StandardsSection.astro';
import CtaBanner from '../components/organisms/CtaBanner.astro';
---

<!-- USWDS: Documentation page template | https://designsystem.digital.gov/templates/documentation-page/ -->
<BaseLayout
	title={`Cómo Trabajamos y Validez del Informe Pericial | ${COMPANY.name}`}
	description={`Descubre cómo solicitar tu peritaje de teléfonos móviles o computadoras en 3 pasos y por qué un informe forense tiene plena validez en juicio.`}
	mainClass="padding-top-4"
>
	<div class="grid-container padding-bottom-4">
		<Breadcrumb items={[{ label: 'Cómo Trabajamos' }]} />

		<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">PERITAJE DE MÓVILES Y COMPUTADORAS</span>
		<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
			Cómo realizamos tu análisis forense
		</h1>
		<p class="font-sans-md text-base-dark line-height-sans-4 measure-6 margin-bottom-0">
			Te acompañamos desde la consulta inicial hasta la entrega del informe pericial listo para presentar en juicio.
		</p>
	</div>

	<ProcessSteps />
	<StandardsSection />

	<CtaBanner
		title="¿Necesitas validar una prueba en tu teléfono o computadora?"
		sub="Escríbenos y evaluamos tu caso de forma confidencial."
		buttonText="Solicitar Peritaje"
		buttonHref="/contacto"
	/>
</BaseLayout>
