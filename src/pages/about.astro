---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, CONTACT, SITE_TITLE, STANDARDS, TEAM_MEMBERS } from '../consts';
---

<BaseLayout
	title={`Sobre Nosotros | ${SITE_TITLE}`}
	description={`Conoce a ${COMPANY.name} y a su equipo pericial multidisciplinario. Especialistas en entrevistas forenses, cadena de custodia, análisis de datos y dictámenes periciales judiciales bajo normas ISO/IEC y NIST.`}
	mainClass="padding-y-5 tablet:padding-y-6"
>
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
		<!-- Header de página -->
		<div class="margin-bottom-4 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">CONÓCENOS</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Sobre {COMPANY.name} — Gabinete de Informática Forense Digital
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet margin-bottom-3">
				Firma pericial y laboratorio corporativo comprometido con la rigurosidad científica, la metodología estandarizada y la inviolabilidad de la evidencia digital.
			</p>

			<!-- 3 Pilares Fundamentales Escaneables -->
			<div class="grid-row grid-gap margin-top-2">
				<div class="tablet:grid-col-4 margin-bottom-2 tablet:margin-bottom-0">
					<div class="bg-white padding-3 radius-md border-top-05 border-primary shadow-1 height-full">
						<strong class="font-sans-xs text-primary-darker display-block margin-bottom-05">1. Evidencia Inalterable</strong>
						<span class="font-sans-3xs text-base-dark line-height-sans-3">
							Cálculo matemático con el algoritmo SHA-256 para certificar que ningún archivo o bit fue manipulado.
						</span>
					</div>
				</div>
				<div class="tablet:grid-col-4 margin-bottom-2 tablet:margin-bottom-0">
					<div class="bg-white padding-3 radius-md border-top-05 border-primary shadow-1 height-full">
						<strong class="font-sans-xs text-primary-darker display-block margin-bottom-05">2. Validez ante Tribunales</strong>
						<span class="font-sans-3xs text-base-dark line-height-sans-3">
							Planillas oficiales de cadena de custodia (PRCC / MUCC-2017) y actas de entrevista para que el juez admita la prueba.
						</span>
					</div>
				</div>
				<div class="tablet:grid-col-4">
					<div class="bg-white padding-3 radius-md border-top-05 border-primary shadow-1 height-full">
						<strong class="font-sans-xs text-primary-darker display-block margin-bottom-05">3. Conclusiones Claras</strong>
						<span class="font-sans-3xs text-base-dark line-height-sans-3">
							Traducimos la complejidad informática y telemática a conclusiones certeras y comprensibles para jueces y litigantes.
						</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Sección Institucional & Misión -->
		<div class="grid-row grid-gap margin-bottom-6">
			<div class="tablet:grid-col-8">
				<div class="bg-white padding-3 tablet:padding-6 radius-lg shadow-1 border-1px border-base-lighter height-full">
					<h2 class="font-sans-xl text-bold text-primary-darker margin-top-0 margin-bottom-2">Nuestra Misión Institucional</h2>
					<p class="font-sans-sm text-base-dark line-height-sans-4 margin-bottom-3">
						En <strong>{COMPANY.name}</strong> procesamos y analizamos evidencias digitales empleando tecnología forense de vanguardia y procedimientos científicos estandarizados para garantizar que cualquier elemento de convicción mantenga su integridad, autenticidad e inalterabilidad frente a tribunales y órganos jurisdiccionales.
					</p>
					<p class="font-sans-sm text-base-dark line-height-sans-4 margin-bottom-3">
						Nuestro nombre, inspirado en la función criptográfica <strong>SHA-256</strong>, refleja la médula técnica de nuestro trabajo: la certificación matemática irreversible de que los datos adquiridos no han sufrido modificación alguna en ninguna de las 6 fases del ciclo forense.
					</p>

					<div class="usa-alert usa-alert--info radius-md margin-top-4">
						<div class="usa-alert__body">
							<h3 class="usa-alert__heading font-sans-sm text-bold">Instalaciones de Laboratorio y Cadena de Custodia</h3>
							<p class="usa-alert__text font-sans-xs line-height-sans-3">
								Nuestra sede técnica en Quíbor, Estado Lara, cuenta con instalaciones controladas para la recepción formal, resguardo en almacenamiento seguro y procesamiento bit a bit bajo el Manual Único de Cadena de Custodia (MUCC-2017).
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Sidebar con normas técnicas -->
			<div class="tablet:grid-col-4 margin-top-4 tablet:margin-top-0">
				<div class="bg-white padding-4 radius-lg shadow-1 border-1px border-base-lighter height-full display-flex flex-column">
					<h3 class="font-sans-md text-bold text-primary-darker margin-top-0 margin-bottom-2">Acreditaciones Técnicas</h3>
					<ul class="list-style-none padding-0 margin-0 flex-1">
						{STANDARDS.map((s) => (
							<li class="border-bottom-1px border-base-lighter padding-y-2">
								<span class="usa-tag bg-primary-lighter text-primary-darker font-sans-3xs text-bold margin-bottom-05">{s.tag}</span>
								<strong class="font-sans-xs text-primary-darker display-block">{s.code}</strong>
								<span class="font-sans-3xs text-base-dark">{s.title}</span>
							</li>
						))}
					</ul>
					<div class="margin-top-3">
						<a href="/servicios" class="usa-button usa-button--outline width-full text-center font-sans-xs">Ver Servicios Técnicos</a>
					</div>
				</div>
			</div>
		</div>

		<!-- ======= SECCIÓN DE EQUIPO PERICIAL ======= -->
		<section id="equipo" class="margin-top-6 border-top-2px border-base-lighter padding-top-5">
			<div class="margin-bottom-4 text-center maxw-tablet margin-x-auto">
				<span class="usa-tag bg-primary text-white font-sans-3xs margin-bottom-1">RESPALDO PROFESIONAL</span>
				<h2 class="font-sans-2xl text-bold text-primary-darker margin-top-1 margin-bottom-1">
					Equipo Forense y Pericial Multidisciplinario
				</h2>
				<p class="font-sans-sm text-base-dark line-height-sans-4">
					Nuestra práctica pericial articula de forma especializada las fases de recepción, entrevistas y adquisición técnica con el análisis forense avanzado de datos y la defensa de dictámenes ante estrados judiciales.
				</p>
			</div>

			<!-- Grid con los perfiles del equipo -->
			<div class="grid-row grid-gap">
				{TEAM_MEMBERS.map((member) => (
					<div class="tablet:grid-col-6 margin-bottom-4">
						<div class="bg-white padding-4 tablet:padding-5 radius-lg shadow-2 border-1px border-base-lighter height-full display-flex flex-column border-top-1 border-primary">
							<!-- Header del miembro -->
							<div class="margin-bottom-3">
								<div class="display-flex flex-wrap flex-align-center flex-justify-between gap-1 margin-bottom-1">
									<span class="usa-tag bg-primary-lighter text-primary-darker font-sans-3xs text-bold">
										{member.titleTag}
									</span>
									<span class="font-sans-3xs text-base text-bold text-uppercase">
										{member.phases}
									</span>
								</div>
								<h3 class="font-sans-xl text-bold text-primary-darker margin-top-1 margin-bottom-05">
									{member.name}
								</h3>
								<p class="font-sans-xs text-secondary-dark text-bold margin-0">
									{member.role}
								</p>
							</div>

							<!-- Resumen del rol -->
							<p class="font-sans-xs text-base-dark line-height-sans-3 margin-bottom-3">
								{member.summary}
							</p>

							<!-- Responsabilidades Específicas -->
							<div class="bg-base-lightest padding-3 radius-md margin-bottom-3 flex-1">
								<h4 class="font-sans-3xs text-uppercase text-bold text-primary margin-top-0 margin-bottom-1 letter-spacing-1">
									Áreas de Especialidad y Protocolos:
								</h4>
								<ul class="list-style-none padding-0 margin-0 font-sans-3xs text-base-dark line-height-sans-3">
									{member.responsibilities.map((resp) => (
										<li class="display-flex flex-align-start margin-y-1">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="#005ea2" aria-hidden="true" class="margin-right-1 flex-shrink-0" style="margin-top:2px">
												<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
											</svg>
											<span>{resp}</span>
										</li>
									))}
								</ul>
							</div>

							<!-- Badges de Estándares -->
							<div class="margin-bottom-3 display-flex flex-wrap gap-1">
								{member.standards.map((std) => (
									<span class="usa-tag bg-base-lighter text-base-darkest font-sans-3xs">
										{std}
									</span>
								))}
							</div>

							<!-- Botones y Enlaces Sociales -->
							<div class="border-top-1px border-base-lighter padding-top-3 margin-top-auto display-flex flex-wrap flex-align-center gap-1">
								{member.social.linkedin && (
									<a
										href={member.social.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 display-inline-flex flex-align-center"
										title={`LinkedIn de ${member.name}`}
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:5px">
											<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.69 1.69 0 1 0 0-3.38 1.69 1.69 0 0 0 0 3.38m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
										</svg>
										LinkedIn
									</a>
								)}
								{member.social.web && (
									<a
										href={member.social.web}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 display-inline-flex flex-align-center"
										title={`Perfil Web de ${member.name}`}
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:5px">
											<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
										</svg>
										Perfil Web
									</a>
								)}
								{member.social.github && (
									<a
										href={member.social.github}
										target="_blank"
										rel="noopener noreferrer"
										class="usa-button usa-button--outline font-sans-3xs padding-y-1 padding-x-2 display-inline-flex flex-align-center"
										title={`GitHub de ${member.name}`}
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:5px">
											<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
										</svg>
										GitHub
									</a>
								)}
								<a
									href="/contacto"
									class="usa-button usa-button--primary font-sans-3xs padding-y-1 padding-x-2 margin-left-auto"
								>
									Consignar Caso &rarr;
								</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Bloque de Contacto Directo Inferior -->
		<div class="bg-primary-darker text-white padding-4 tablet:padding-6 radius-lg shadow-2 margin-top-6">
			<div class="grid-row grid-gap flex-align-center">
				<div class="tablet:grid-col-8">
					<span class="usa-tag bg-secondary text-primary-darkest font-sans-3xs text-bold margin-bottom-1">ATENCIÓN PERICIAL</span>
					<h3 class="font-sans-xl text-bold text-white margin-top-1 margin-bottom-1">
						¿Requieres asistencia pericial o evaluación preliminar de evidencia?
					</h3>
					<p class="font-sans-xs text-base-lightest line-height-sans-3 margin-0">
						Coordinamos la recepción técnica en laboratorio, cadena de custodia oficial o peritaje judicial para procesos contenciosos.
					</p>
				</div>
				<div class="tablet:grid-col-4 display-flex flex-column gap-1 margin-top-3 tablet:margin-top-0">
					<a href="/contacto" class="usa-button usa-button--secondary font-sans-xs width-full text-center">
						Contactar al Gabinete Forense &rarr;
					</a>
					<a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="usa-button usa-button--outline text-white border-white font-sans-xs width-full text-center">
						Escribir a WhatsApp ({CONTACT.phone.display})
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
