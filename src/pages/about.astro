---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, SITE_TITLE } from '../consts';
import AboutPillars from '../components/organisms/AboutPillars.astro';
import AboutMission from '../components/organisms/AboutMission.astro';
import StandardsSidebar from '../components/organisms/StandardsSidebar.astro';
import TeamSection from '../components/organisms/TeamSection.astro';
import AboutContactCta from '../components/organisms/AboutContactCta.astro';
---

<BaseLayout
	title={`Laboratorio Forense y Peritos Digitales en Venezuela | ${COMPANY.name}`}
	description={`Conoce a ${COMPANY.name}, laboratorio de informática forense y gabinete pericial en Quíbor, Lara, Venezuela. Peritajes judiciales, cadena de custodia y análisis de evidencia digital.`}
	mainClass="padding-y-5 tablet:padding-y-6"
>
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
		<!-- Header de página -->
		<div class="margin-bottom-4 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">CONÓCENOS</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Laboratorio de Informática Forense y Gabinete Pericial en Venezuela
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet margin-bottom-3">
				Firma pericial y laboratorio corporativo comprometido con la rigurosidad científica, la metodología estandarizada y la inviolabilidad de la evidencia digital.
			</p>

			<!-- 3 Pilares Fundamentales Escaneables -->
			<AboutPillars />
		</div>

		<!-- Sección Institucional & Misión -->
		<div class="grid-row grid-gap margin-bottom-6">
			<div class="tablet:grid-col-8">
				<AboutMission />
			</div>

			<!-- Sidebar con normas técnicas -->
			<div class="tablet:grid-col-4 margin-top-4 tablet:margin-top-0">
				<StandardsSidebar />
			</div>
		</div>

		<!-- ======= SECCIÓN DE EQUIPO PERICIAL ======= -->
		<TeamSection />

		<!-- Bloque de Contacto Directo Inferior -->
		<AboutContactCta />
	</div>
</BaseLayout>
