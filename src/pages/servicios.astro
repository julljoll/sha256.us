---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, SITE_TITLE } from '../consts';
import PillNav from '../components/molecules/PillNav.astro';
import ServiceForense from '../components/organisms/services/ServiceForense.astro';
import ServiceMoviles from '../components/organisms/services/ServiceMoviles.astro';
import ServiceAlmacenamiento from '../components/organisms/services/ServiceAlmacenamiento.astro';
import ServiceDocumentos from '../components/organisms/services/ServiceDocumentos.astro';

const servicePills = [
	{ href: '#forense', label: 'Pruebas para Juicios', icon: '⚖️' },
	{ href: '#moviles', label: 'WhatsApp y Móviles', icon: '📱' },
	{ href: '#almacenamiento', label: 'Discos y Memorias', icon: '💾' },
	{ href: '#documentos', label: 'Contratos y Correos PDF', icon: '📄' },
];
---

<BaseLayout
	title={`Servicios Forenses Digitales | ${SITE_TITLE}`}
	description="Informática forense, peritaje judicial, reparación y extracción de discos, análisis forense de smartphones y auditoría de documentos electrónicos bajo estándares ISO y NIST."
	mainClass="padding-y-5 tablet:padding-y-6"
>
	<div class="grid-container maxw-desktop margin-x-auto padding-x-2">
		<!-- Header de página -->
		<div class="margin-bottom-4 border-bottom-2px border-base-lighter padding-bottom-3">
			<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">SERVICIOS ESPECIALIZADOS</span>
			<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
				Auditoría, Extracción y Peritajes de Informática Forense Digital
			</h1>
			<p class="font-sans-md text-base-dark line-height-sans-4 maxw-tablet margin-bottom-3">
				Metodologías científicas de laboratorio aplicadas por el equipo forense multidisciplinario de {COMPANY.name} bajo estrictos protocolos técnicos internacionales (ISO/IEC 27037, ISO/IEC 27042 y MUCC-2017) para extraer, analizar y certificar la información probatoria requerida en juicios, controversias corporativas y resolución de incidentes.
			</p>

			<!-- Barra de Salto Rápido para Teléfonos y Escritorio -->
			<PillNav items={servicePills} />
		</div>

		<!-- Servicio 1: Informática Forense y Peritaje Judicial -->
		<ServiceForense />

		<!-- Servicio 2: Dispositivos Móviles -->
		<ServiceMoviles />

		<!-- Servicio 3: Almacenamiento -->
		<ServiceAlmacenamiento />

		<!-- Servicio 4: Contratos y Documentos Digitales -->
		<ServiceDocumentos />
	</div>
</BaseLayout>
