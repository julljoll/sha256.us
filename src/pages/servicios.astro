---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../consts';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import PillNav, { type PillItem } from '../components/molecules/PillNav.astro';
import ServiceMoviles from '../components/organisms/services/ServiceMoviles.astro';
import ServiceAlmacenamiento from '../components/organisms/services/ServiceAlmacenamiento.astro';
import ServiceDocumentos from '../components/organisms/services/ServiceDocumentos.astro';
import ServiceForense from '../components/organisms/services/ServiceForense.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
import CtaBanner from '../components/organisms/CtaBanner.astro';

const servicePills: PillItem[] = [
	{ href: '#moviles', label: '1. Móviles, WhatsApp y Redes', iconName: 'phone' },
	{ href: '#almacenamiento', label: '2. Computadoras y Datos', iconName: 'folder_open' },
	{ href: '#documentos', label: '3. Imágenes, Web y Correos', iconName: 'file_present' },
	{ href: '#forense', label: '4. Laboral y Judicial', iconName: 'account_balance' },
];
---

<!-- USWDS: Documentation page template | https://designsystem.digital.gov/templates/documentation-page/ -->
<BaseLayout
	title={`Servicios de Peritaje Informático de Móviles y Computadoras | ${COMPANY.name}`}
	description={`Contratar peritaje informático: WhatsApp, teléfonos móviles, computadoras, redes sociales, manipulación de imágenes, certificación web, recuperación de datos y peritaje laboral y judicial.`}
	mainClass="padding-top-4"
>
	<div class="grid-container padding-bottom-4">
		<Breadcrumb items={[{ label: 'Servicios Forenses' }]} />

		<span class="usa-tag bg-primary text-white margin-bottom-1 font-sans-3xs">ANÁLISIS FORENSE DE MÓVILES Y COMPUTADORAS</span>
		<h1 class="font-sans-2xl tablet:font-sans-3xl text-bold text-primary-darker margin-top-1 margin-bottom-2">
			Servicios de Peritaje Informático
		</h1>
		<p class="font-sans-md text-base-dark line-height-sans-4 measure-6 margin-bottom-3">
			Elige el dispositivo o prueba digital que necesitas analizar o certificar para tu caso.
		</p>

		<PillNav items={servicePills} title="Ir directamente a:" />
	</div>

	<ServiceMoviles />
	<ServiceAlmacenamiento />
	<ServiceDocumentos />
	<ServiceForense />
	<ProcessSteps />
	<CtaBanner />
</BaseLayout>
